diff --git a/plat/syna/berlin/soc/platypus/suspend.c b/plat/syna/berlin/soc/platypus/suspend.c
new file mode 100644
index 0000000..0f0c000
--- /dev/null
+++ b/plat/syna/berlin/soc/platypus/suspend.c
@@ -0,0 +1,142 @@
+/*
