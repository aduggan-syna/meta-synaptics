+void avpll_init(void)
+{
+	unsigned int i;
+
+	/*AVPLL power related*/
+	AVPLL_control[0].reg_offset = RA_avPll_ctrlPLL;
+	AVPLL_control[1].reg_offset = RA_avPll_C1 + RA_avpllCh_ctrl1;
+	AVPLL_control[2].reg_offset = RA_avPll_C2 + RA_avpllCh_ctrl1;
