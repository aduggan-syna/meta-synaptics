+#else
+	/*
+	 * Set the CPUPWRCTLR.CORE_PWRDN_EN bit to 0
+	 * so that CPU will not be powered down after excute WFI instruction
+	 */
+	arm_set_PWRCTLR(0);
+#endif
+	return PSCI_E_SUCCESS;
+
+}
