+
+    #define   GET32CPU_PCH_PCH_ACCEPT(r32)                     _BFGET_(r32,20,20)
+    #define   SET32CPU_PCH_PCH_ACCEPT(r32,v)                   _BFSET_(r32,20,20,v)
+    #define   GET16CPU_PCH_PCH_ACCEPT(r16)                     _BFGET_(r16, 4, 4)
