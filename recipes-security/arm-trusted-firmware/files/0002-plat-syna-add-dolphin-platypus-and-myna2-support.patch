+
+	{0x00000000, 0x00000000}, //FWR_INTR_ENABLE_1 = 11
+	{0x00000000, 0x00000000}, //FWR_INTR_ENABLE_2 = 12
+	{0x00000000, 0x00000000}, //FWR_INTR_ENABLE_3 = 13
+	{0x00000000, 0x00000000}, //FWR_SEM_POP       = 14
+	{0x00000000, 0x00000000}, //FWR_SEM_FULL      = 15
+
+	{0x00000000, 0x00000000}, //ISP_INT_STATUS    = 16
+	{0x00000000, 0x00000000}, //ISP_CORE_TOP_CTRL = 17
+	{0x00000000, 0x00000000}, //ISP_ISP_INTR_STS  = 18
+	{0x00000000, 0x00000000}, //ISP_ISP_INTR_CLR  = 19
+	{0x00000000, 0x00000000}, //ISP_MI_INTR_STS   = 20
+	{0x00000000, 0x00000000}, //ISP_MI_INTR_CLR   = 21
+
+	{0xF7CDFC08, 0x8000007F}, //NSK_CORE_INTSTATUS = 22
+	{0xF7CE0020, 0x000003FF}, //NSK_SOC_INTSTATUS = 23
+	{0xF7CE0024, 0x000003FF}, //NSK_SOC_INTCLEAR  = 24
+
+	{0xF904000C, 0xFFFFFFFF}, //DSP0_INTR_STATUS = 25
+	{0xF905000C, 0xFFFFFFFF}, //DSP1_INTR_STATUS = 26
+
+	{0xF7CE1024, 0xFFFFFFFF}, //IFCP_I2H_CTRL_STATUS = 27
+};
+
+#endif /* SECURE_REGISTER_SETTING_H */
