diff --git a/plat/syna/berlin/suspend/berlin_suspend.mk b/plat/syna/berlin/suspend/berlin_suspend.mk
new file mode 100644
index 0000000..61a73d1
--- /dev/null
+++ b/plat/syna/berlin/suspend/berlin_suspend.mk
@@ -0,0 +1,149 @@
+#
+# Copyright (c) 2013-2022, Arm Limited and Contributors. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+include lib/libc/libc.mk
+SUSPEND_COMMON_SOURCES	=				\
+				common/tf_log.c				\
+				common/${ARCH}/debug.S			\
+				lib/${ARCH}/cache_helpers.S		\
+				lib/${ARCH}/misc_helpers.S		\
+				drivers/console/multi_console.c		\
+				plat/common/plat_log_common.c		\
+                ${LIBC_SRCS}
+#				${COMPILER_RT_SRCS}
+
+ifeq (${BERLIN_LP_MMU_ENABLE}, 1)
+include lib/xlat_tables_v2/xlat_tables.mk
+SUSPEND_COMMON_SOURCES	+=				\
+				${XLAT_TABLES_LIB_SRCS}
+CFLAGS		+=	-DCONFIG_BERLIN_LP_MMU_ENABLE
+endif
+
+ifeq (${DEBUG}, 1)
+SUSPEND_COMMON_SOURCES +=				\
+				common/backtrace/backtrace.c
+endif
+
+ifneq (${ENABLE_STACK_PROTECTOR},0)
+#include lib/stack_protector/stack_protector.mk
+SUSPEND_COMMON_SOURCES +=	plat/syna/berlin/common/berlin_stack_protector.c
+
+  STACK_PROTECTOR_ENABLED := 1
+  SUSPEND_COMMON_SOURCES +=	lib/stack_protector/stack_protector.c	\
+				lib/stack_protector/${ARCH}/asm_stack_protector.S
+
+  ifeq (${ENABLE_STACK_PROTECTOR},default)
+    CFLAGS		+=	-fstack-protector
+  else
+    CFLAGS		+=	-fstack-protector-${ENABLE_STACK_PROTECTOR}
+  endif
+endif
+
+MODULE_SOURCES      := $(SUSPEND_COMMON_SOURCES)                         \
+                       drivers/ti/uart/aarch64/16550_console.S            \
+                       plat/common/aarch64/platform_up_stack.S            \
+                       ${COMMON_DIR}/aarch64/berlin_helpers.S             \
+                       ${COMMON_DIR}/drivers/sm/sm.c                      \
+                       ${COMMON_DIR}/drivers/tos/tz_boot_param.c          \
+                       ${COMMON_DIR}/drivers/tos/tz.c                     \
+                       ${COMMON_DIR}/drivers/bcm/bcm_hal.c                           \
+                       ${COMMON_DIR}/drivers/bcm/bcm.c                           \
+                       ${SUSPEND_DIR}/avpll.c                             \
+                       ${SUSPEND_DIR}/mem4.c                              \
+                       ${SUSPEND_DIR}/sha256_ce.S                         \
+                       ${SUSPEND_DIR}/sha256.c                            \
+                       ${SUSPEND_DIR}/suspend_entrypoint.S                \
+                       ${SOC_DIR}/suspend.c                               \
+                       ${SOC_DIR}/clock.c                                 \
+                       ${SOC_DIR}/mc.c
+MODULE_LINKERSCRIPT := ${SUSPEND_DIR}/suspend.ld.S
+
+MODULE_NAME         := suspend
+MODULE_OUTPUT_DIR   := ${BUILD_PLAT}/$(MODULE_NAME)
+MODULE_C_SOURCES    := $(filter %.c,$(MODULE_SOURCES))
+MODULE_S_SOURCES    := $(filter %.S,$(MODULE_SOURCES))
+
+COMPILEROBJECTS     := $(addprefix $(MODULE_OUTPUT_DIR)/,\
+                           $(notdir $(patsubst %.c,%.o,$(MODULE_C_SOURCES))\
+                                    $(patsubst %.S,%.o,$(MODULE_S_SOURCES))))
+LINKERSCRIPT        := ${MODULE_OUTPUT_DIR}/$(MODULE_NAME).ld
+LINKERMAP           := ${MODULE_OUTPUT_DIR}/$(MODULE_NAME).map
+LINKERELF           := ${MODULE_OUTPUT_DIR}/$(MODULE_NAME).elf
+BINUTILSDUMP        := ${MODULE_OUTPUT_DIR}/$(MODULE_NAME).dump
+BINUTILSCOPY        := ${BUILD_PLAT}/$(MODULE_NAME).bin
+
+CFLAGS += -I${SUSPEND_DIR}
+
+define CRULES
+$(1): $(3)
+	@echo "  CC      $$<"
+	$$(Q)$$(CC) $$(TF_CFLAGS) $$(CFLAGS) -c $$< -o $$@
+
+$(2): $(3) | $(MODULE_OUTPUT_DIR)
+	@echo "  DEPS    $$@"
+	$$(Q)$$(CC) $$(TF_CFLAGS) $$(CFLAGS) -M -MT $(1) -MF $$@ $$<
+
+-include $(2)
+endef
+
+define SRULES
+$(1): $(3)
+	@echo "  AS      $$<"
+	$$(Q)$$(AS) $$(ASFLAGS) -c $$< -o $$@
+
+$(2): $(3) | $(MODULE_OUTPUT_DIR)
+	@echo "  DEPS    $$@"
+	$$(Q)$$(AS) $$(ASFLAGS) -M -MT $(1) -MF $$@ $$<
+
+-include $(2)
+endef
+
+define LDRULES
+$(1): $(3)
+	@echo "  PP      $$<"
+	$$(Q)$$(AS) $$(ASFLAGS) -P -E -D__LINKER__ -o $$@ $$<
+
+$(2): $(3) | $(MODULE_OUTPUT_DIR)
+	@echo "  DEPS    $$@"
+	$$(Q)$$(AS) $$(ASFLAGS) -M -MT $(1) -MF $$@ $$<
+
+-include $(2)
+endef
+
+$(MODULE_OUTPUT_DIR):
+	$(Q)mkdir -p "$(MODULE_OUTPUT_DIR)"
+
+$(foreach obj,$(MODULE_C_SOURCES),$(eval $(call CRULES,\
+$(addprefix $(MODULE_OUTPUT_DIR)/,$(notdir $(patsubst %.c,%.o,$(obj)))),\
+$(addprefix $(MODULE_OUTPUT_DIR)/,$(notdir $(patsubst %.c,%.d,$(obj)))),\
+$(obj))))
+
+$(foreach obj,$(MODULE_S_SOURCES),$(eval $(call SRULES,\
+$(addprefix $(MODULE_OUTPUT_DIR)/,$(notdir $(patsubst %.S,%.o,$(obj)))),\
+$(addprefix $(MODULE_OUTPUT_DIR)/,$(notdir $(patsubst %.S,%.d,$(obj)))),\
+$(obj))))
+
+$(eval $(call LDRULES,$(LINKERSCRIPT),$(LINKERSCRIPT).d,$(MODULE_LINKERSCRIPT)))
+
+$(LINKERELF): $(COMPILEROBJECTS) $(LINKERSCRIPT) | $(MODULE_OUTPUT_DIR)
+	@echo "  LD      $@"
+	$(Q)$(LD) -o $@ $(LDFLAGS) -Map=$(LINKERMAP) --script $(LINKERSCRIPT) $(COMPILEROBJECTS)
+
+$(BINUTILSDUMP): $(LINKERELF)
+	@echo "  OD      $@"
+	${Q}${OD} -dx $< > $@
+
+$(BINUTILSCOPY): $(LINKERELF)
+	@echo "  BIN     $@"
+	$(Q)$(OC) -O binary $< $@
+	@echo
+	@echo "Built $@ successfully"
+	@echo
+
+.PHONY: $(MODULE_NAME)
+$(MODULE_NAME): $(BINUTILSCOPY) $(BINUTILSDUMP)
+
+all: $(MODULE_NAME)
diff --git a/plat/syna/berlin/suspend/clock.c b/plat/syna/berlin/suspend/clock.c
new file mode 100644
index 0000000..e71c0a4
--- /dev/null
+++ b/plat/syna/berlin/suspend/clock.c
@@ -0,0 +1,124 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "clock_regs.h"
+#include "clock.h"
+#include "avpll.h"
+
+#define BFM_HOST_Bus_Write32(offset, val)		\
+			mmio_write_32((unsigned long)offset, val)
+
+#define BFM_HOST_Bus_Read32(offset, val)		\
+			val = mmio_read_32((unsigned long)offset)
+
+
+static inline void pll_set_bypass(void *pll_base, int enable)
+{
+	unsigned int reg_val;
+
+	BFM_HOST_Bus_Read32(pll_base + RA_pll_ctrl1, reg_val);
+
+	if(enable)
+		reg_val |= MSK32pll_ctrl_BYPASS_EN;
+	else
+		reg_val &= ~MSK32pll_ctrl_BYPASS_EN;
+
+	BFM_HOST_Bus_Write32(pll_base + RA_pll_ctrl1, reg_val);
+}
+
+
+static void pll_bypass_en(clock_config_t *config)
+{
+	/* CPU PLL bypass enable */
+	pll_set_bypass(config->cpu_pll_base, 1);
+
+	/* SYS PLL bypass enable */
+	pll_set_bypass(config->sys_pll_base, 1);
+
+	/* MEM PLL bypass enable */
+	pll_set_bypass(config->mem_pll_base, 1);
+}
+
+static void pll_bypass_dis(clock_config_t *config)
+{
+	/* MEM PLL bypass disable */
+	pll_set_bypass(config->mem_pll_base, 0);
+
+	/* SYS PLL bypass disable */
+	pll_set_bypass(config->sys_pll_base, 0);
+
+	/* CPU PLL bypass disable */
+	pll_set_bypass(config->cpu_pll_base, 0);
+}
+
+static inline void pll_set_power(void *pll_base, int on)
+{
+	unsigned int reg_val;
+
+	BFM_HOST_Bus_Read32(pll_base, reg_val);
+
+	if(on)
+		reg_val |= 0x1;
+	else
+		reg_val &= ~0x1;
+
+	BFM_HOST_Bus_Write32(pll_base, reg_val);
+}
+
+static void pll_power_on(clock_config_t *config)
+{
+	/* Power on the CPU pll */
+	pll_set_power(config->cpu_pll_base, 1);
+
+	/* Power on the SYS pll */
+	pll_set_power(config->sys_pll_base, 1);
+
+	/* Power on the MEM pll */
+	pll_set_power(config->mem_pll_base, 1);
+}
+
+static void pll_power_off(clock_config_t *config)
+{
+	/* Power off the CPU pll */
+	pll_set_power(config->cpu_pll_base, 0);
+
+	/* Power off the SYS pll */
+	pll_set_power(config->sys_pll_base, 0);
+
+	/* Power off the MEM pll */
+	pll_set_power(config->mem_pll_base, 0);
+}
+
+static clock_config_t clock_config;
+
+void clock_set_config(clock_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&clock_config, config, sizeof(clock_config_t));
+
+	assert(clock_config.cpu_pll_base != NULL);
+	assert(clock_config.sys_pll_base != NULL);
+	assert(clock_config.mem_pll_base != NULL);
+	assert(clock_config.avpll_power_base != NULL);
+}
+
+void clock_suspend(void)
+{
+	avpll_suspend(clock_config.avpll_power_base);
+	pll_bypass_en(&clock_config);
+	pll_power_off(&clock_config);
+}
+
+void clock_resume(void)
+{
+	pll_power_on(&clock_config);
+	pll_bypass_dis(&clock_config);
+	avpll_resume(clock_config.avpll_power_base);
+}
