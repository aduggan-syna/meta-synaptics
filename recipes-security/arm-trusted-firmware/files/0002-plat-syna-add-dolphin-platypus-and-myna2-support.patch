diff --git a/plat/syna/berlin/soc/dolphin/clock.c b/plat/syna/berlin/soc/dolphin/clock.c
new file mode 100644
index 0000000..d8e4c1c
--- /dev/null
+++ b/plat/syna/berlin/soc/dolphin/clock.c
@@ -0,0 +1,207 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "clock_regs.h"
+#include "clock.h"
+#include "avpll.h"
+
+#define BFM_HOST_Bus_Write32(offset, val)		\
+			mmio_write_32((unsigned long)offset, val)
+
+#define BFM_HOST_Bus_Read32(offset, val)		\
+			val = mmio_read_32((unsigned long)offset)
+
+static void mempll_bypass_en(void)
+{
+	register unsigned int data;
+
+	//enable mem fastrefclk
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_memfastRefClk);
+	data |= 1;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_memfastRefClk, data);
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data |= MSK32Gbl_ClkSwitch_memPLLSWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+static void mempll_bypass_dis(void)
+{
+	register unsigned int data;
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data &= ~MSK32Gbl_ClkSwitch_memPLLSWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void syspll_bypass_en(void)
+{
+	register unsigned int data;
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data |= MSK32Gbl_ClkSwitch_sysPLL_0SWBypass;
+	data |= MSK32Gbl_ClkSwitch_sysPLL_1SWBypass;
+	data |= MSK32Gbl_ClkSwitch_sysPLL_2SWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void syspll_bypass_dis(void)
+{
+	register unsigned int data;
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data &= ~MSK32Gbl_ClkSwitch_sysPLL_0SWBypass;
+	data &= ~MSK32Gbl_ClkSwitch_sysPLL_1SWBypass;
+	data &= ~MSK32Gbl_ClkSwitch_sysPLL_2SWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void cpupll_bypass_en(void)
+{
+	register unsigned int data;
+
+	//enable mem fastrefclk
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_cpufastRefClk);
+	data |= 1;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_cpufastRefClk, data);
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data |= MSK32Gbl_ClkSwitch_cpuPLLSWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void cpupll_bypass_dis(void)
+{
+	register unsigned int data;
+
+	// global Pll bypass disable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data &= ~MSK32Gbl_ClkSwitch_cpuPLLSWBypass;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void pll_bypass_en(clock_config_t *config)
+{
+	/* MEM PLL bypass enable */
+	mempll_bypass_en();
+
+	/* CPU PLL bypass enable */
+	cpupll_bypass_en();
+
+	/* SYS PLL bypass enable */
+	syspll_bypass_en();
+}
+
+static void pll_bypass_dis(clock_config_t *config)
+{
+	/* SYS PLL bypass disable */
+	syspll_bypass_dis();
+
+	/* CPU PLL bypass disable */
+	cpupll_bypass_dis();
+
+	/* MEM PLL bypass disable */
+	mempll_bypass_dis();
+}
+
+static void pll_power_up(void *pll_base)
+{
+    unsigned int data;
+
+	//reset
+	data = mmio_read_32((unsigned long)pll_base + RA_abipll_ctrlA);
+	data &= ~MSK32abipll_ctrlA_RESET;
+	mmio_write_32((unsigned long)pll_base + RA_abipll_ctrlA, data);
+
+	//delay 50us
+	//udelay(50);
+
+	//check for PLL lock
+	do
+	{
+		data = mmio_read_32((unsigned long)pll_base + RA_abipll_status);
+		data &= MSK32abipll_status_LOCK;
+	}while(data==0);
+
+}
+
+static void pll_power_down(void *pll_base)
+{
+	unsigned int data;
+
+	//reset PLL
+	data = mmio_read_32((unsigned long)pll_base + RA_abipll_ctrlA);
+	data |= (1 << LSb32abipll_ctrlA_RESET);
+	mmio_write_32((unsigned long)pll_base + RA_abipll_ctrlA, data);
+}
+
+static void pll_power_on(clock_config_t *config)
+{
+	/* Power on the CPU pll */
+	pll_power_up(config->cpu_pll_base);
+
+	/* Power on the SYS pll0 */
+	pll_power_up(config->sys_pll0_base);
+
+	/* Power on the SYS pll1 */
+	pll_power_up(config->sys_pll1_base);
+
+	/* Power on the SYS pll2 */
+	pll_power_up(config->sys_pll2_base);
+
+}
+
+static void pll_power_off(clock_config_t *config)
+{
+
+	/* Power off the SYS pll0 */
+	pll_power_down(config->sys_pll0_base);
+
+	/* Power off the SYS pll1 */
+	pll_power_down(config->sys_pll1_base);
+
+	/* Power off the SYS pll2 */
+	pll_power_down(config->sys_pll2_base);
+
+	/* Power off the CPU pll */
+	pll_power_down(config->cpu_pll_base);
+}
+
+static clock_config_t clock_config;
+
+void clock_set_config(clock_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&clock_config, config, sizeof(clock_config_t));
+
+	assert(clock_config.cpu_pll_base != NULL);
+	assert(clock_config.sys_pll0_base != NULL);
+	assert(clock_config.sys_pll1_base != NULL);
+	assert(clock_config.sys_pll2_base != NULL);
+	assert(clock_config.mem_pll_base != NULL);
+}
+
+void clock_suspend(void)
+{
+	pll_bypass_en(&clock_config);
+
+	pll_power_off(&clock_config);
+}
+
+void clock_resume(void)
+{
+	pll_power_on(&clock_config);
+
+	pll_bypass_dis(&clock_config);
+}
diff --git a/plat/syna/berlin/soc/dolphin/mc.c b/plat/syna/berlin/soc/dolphin/mc.c
new file mode 100644
index 0000000..5da4f90
--- /dev/null
+++ b/plat/syna/berlin/soc/dolphin/mc.c
@@ -0,0 +1,169 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "mc.h"
+#include "clock_regs.h"
+
+#define RD_MC_REG(offset , data)	\
+		data = mmio_read_32((unsigned long)((char*)base + offset))
+
+#define WR_MC_REG(offset , value)	\
+		mmio_write_32((unsigned long)((char*)base + offset), value)
+
+#define MC_REG(offset)	(*(volatile unsigned int *)(unsigned long)((char*)base + (offset)))
+
+#define MEMPLL_BYPASS_ENABLE	1
+
+static void soft_udelay(int us)
+{
+    int i;
+    for (i = 0; i < (us * 100); i++);
+}
+
+
+/*
+ * DDR enter self-refresh
+ * Diag: G-Diag/BerlinBG7/code/modules/mempll/self_refresh.c
+ * function:enterselfrefresh
+ */
+static void ddr_enter_self_refresh(void *base)
+{
+	// 1.Program PCTRL_n.port_en = 0 – to block traffic on AXI port
+	MC_REG(0x490) = 0x0;
+	MC_REG(0x540) = 0x0;
+	MC_REG(0x5f0) = 0x0;
+	MC_REG(0x6a0) = 0x0;
+	MC_REG(0x750) = 0x0;
+	// 2.Poll PSTAT.rd_port_busy_n = 0 and PSTAT.wr_port_busy_n = 0 – wait for AXI ports are idle
+	while (MC_REG(0x3fc) & ((0x1f<<0) | (0x1f<<16)));
+	// 3.Program DBG1.dis_hif = 1 – no new command will be accepted by DDRC
+	MC_REG(0x0304) |= 0x2;
+	MC_REG(0x1e04) |= 0x2;
+	// 4.Poll DBGCAM.dbg_wr/rd_q_empty =1– to ensure that write and read data buffers are empty
+	while (((MC_REG(0x0308) >> 25) & 0x3) != 0x3);
+	while (((MC_REG(0x1e08) >> 25) & 0x3) != 0x3);
+
+#if (MEMPLL_BYPASS_ENABLE == 1)
+	MC_REG(0x0198) &= ~(1<<8);
+	while (MC_REG(0x01bc) & (1<<1)) {
+		soft_udelay(10);
+	};
+	while (MC_REG(0x1cbc) & (1<<1)) {
+		soft_udelay(10);
+	};
+#endif
+	// 5.Program PWRCTL.selfref_sw = 1 – core to enter self-refresh mode
+	MC_REG(0x0030) |= 0x20;
+	MC_REG(0x1b30) |= 0x20;
+	// 6.Wait until STAT.operation_mode[1:0] = ‘b11 – to indicate that controller is in self-refresh mode, STAT.selfref_type = ‘b10 – to make sure transition to self-refresh was due to software
+	while ((MC_REG(0x0004) & ((0x3<<0) | (0x3<<4) | (0x3<<8))) != ((0x3 << 0) | (0x2 << 4) | (0x2 << 8))) {
+		soft_udelay(10);
+	};
+	while ((MC_REG(0x1b04) & ((0x3<<0) | (0x3<<4) | (0x3<<8))) != ((0x3 << 0) | (0x2 << 4) | (0x2 << 8))) {
+		soft_udelay(10);
+	};
+
+#if (MEMPLL_BYPASS_ENABLE == 1)
+		MC_REG(0x0320) &= ~(1<<0);	// Enable Quasi-Dynamic Register Programming
+		MC_REG(0x01b0) &= ~(1<<0);	// Program DFIMISC.dfi_init_complete_en = 0
+		MC_REG(0x01b0) |= (1<<5);	// Program DFIMISC.dfi_init_start = 1
+		while (MC_REG(0x01bc) & (1<<0)); // Poll DFISTAT.dfi_init_complete = 0
+		while (MC_REG(0x1cbc) & (1<<0)); // Poll DCH1.DFISTAT.dfi_init_complete = 0
+		MC_REG(0x0320) |= (1<<0);  // Disable Quasi-Dynamic Register Programming
+
+		*(volatile unsigned int*)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_ctrlA) |= (1<<LSb32abipll_ctrlA_BYPASS);
+#endif // (MEMPLL_BYPASS_ENABLE == 1)
+
+}
+
+
+/*
+ * DDR exit self-refresh
+ */
+static void ddr_exit_self_refresh(void *base)
+{
+#if (MEMPLL_BYPASS_ENABLE == 1)
+	// disable mempll bypass
+	*(volatile unsigned int*)(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch) |= (1<<LSb32Gbl_ClkSwitch_memPLLSWBypass); // sw-bypass to memfastClk
+	*(volatile unsigned int*)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_ctrlA) &= ~(1<<LSb32abipll_ctrlA_BYPASS);
+	//udelay(50);
+	while (!(*(volatile unsigned int*)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_status) & (1<<0)));
+	//udelay(50);
+	*(volatile unsigned int*)(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch) &= ~(1<<LSb32Gbl_ClkSwitch_memPLLSWBypass); // disable sw-bypass
+
+	MC_REG(0x0320) &= ~(1<<0);	// Enable Quasi-Dynamic Register Programming
+	MC_REG(0x01b0) &= ~(1<<0);	// Program DFIMISC.dfi_init_complete_en = 0
+	MC_REG(0x01b0) &= ~(1<<5);	 // Program DFIMISC.dfi_init_start = 0
+	while (!(MC_REG(0x01bc) & (1<<0))); // Poll DFISTAT.dfi_init_complete = 1
+	while (!(MC_REG(0x1cbc) & (1<<0))); // Poll DCH1.DFISTAT.dfi_init_complete = 1
+	MC_REG(0x01b0) |= (1<<0);  // Program DFIMISC.dfi_init_complete_en = 1
+	MC_REG(0x0320) |= (1<<0);  // Disable Quasi-Dynamic Register Programming
+
+	// for lower-down/bypass/disable mempll when SR - LP2 mode, "Reset DFILPCFG0.dfi_lp_en_sr = 1 if DFILPCFG0.dfi_lp_en_sr has been set to 0 in step 10."
+	MC_REG(0x0198) |= (1<<8);
+#endif // (MEMPLL_BYPASS_ENABLE == 1)
+
+	// 1.Wait at least tCKESR, perform exit self-refresh by de-asserting PWRCTL.selfref_sw = 0
+	MC_REG(0x0030) &= ~0x20;
+	MC_REG(0x1b30) &= ~0x20;
+	// 2.Poll for STAT.oprtating_mode !=11 indicate MC core is not in self-refresh mode
+	while ((MC_REG(0x0004) & 0x3) == 0x3);
+	while ((MC_REG(0x1b04) & 0x3) == 0x3);
+	// 3.Enable HIF interface by setting dis_hif = 0
+	MC_REG(0x0304) &= ~0x2;
+	MC_REG(0x1e04) &= ~0x2;
+	// 4.Program PCTRL_n.port_en = 1 – to unblock traffic on AXI port
+	MC_REG(0x490) = 0x1;
+	MC_REG(0x540) = 0x1;
+	MC_REG(0x5f0) = 0x1;
+	MC_REG(0x6a0) = 0x1;
+	MC_REG(0x750) = 0x1;
+}
+
+
+/*
+ * Power down the PHY of MC6
+ */
+static void mc_phy_power_down(void *base)
+{
+	//fix me: DDR PHY power down is done in SM
+}
+
+/*
+ * Power up the PHY of MC6
+ */
+static void mc_phy_power_up(void* base)
+{
+	//fix me: DDR PHY power up is done in SM
+
+}
+
+static mem_config_t mem_config;
+
+void mem_set_config(mem_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&mem_config, config, sizeof(mem_config_t));
+
+	assert(mem_config.mc6_base != NULL);
+}
+
+void mem_suspend(void)
+{
+	ddr_enter_self_refresh(mem_config.mc6_base);
+
+	mc_phy_power_down(mem_config.mc6_base);
+}
+
+void mem_resume(void)
+{
+	mc_phy_power_up(mem_config.mc6_base);
+	ddr_exit_self_refresh(mem_config.mc6_base);
+}
diff --git a/plat/syna/berlin/soc/dolphin/plat_pm.c b/plat/syna/berlin/soc/dolphin/plat_pm.c
new file mode 100644
index 0000000..b580003
--- /dev/null
+++ b/plat/syna/berlin/soc/dolphin/plat_pm.c
@@ -0,0 +1,237 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <arch.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <plat/common/platform.h>
+#include <platform_def.h>
+#include <lib/bakery_lock.h>
+#include <lib/mmio.h>
+#include <drivers/arm/gicv2.h>
+#include <string.h>
+#include <assert.h>
+#include <berlin_private.h>
+#include <drivers/delay_timer.h>
+#include "cpu_wrp.h"
+#include "sm.h"
+#include "Galois_memmap.h"
+#include "cpu_wrp.h"
+
+#define RESET_nCPUPORESET_0	0
+#define PWRSW_CNTRL1_I         0
+#define PWRSW_CNTRL2_I         1
+#define PWRSW_ACK1_O           2
+#define PWRSW_ACK2_O           3
+#define nCPU_ISO_MODE_EN       4
+
+#define REBOOT_PARAM_ADDR               0xF7F9EC00//(SOC_SM_MEMMAP_ITCM_BASE + SOC_SM_MEMMAP_ITCM_SIZE - 0x1400)
+
+int berlin_soc_pwr_domain_on(unsigned int target_cpu)
+{
+	unsigned int val;
+
+	/* disable CPMU */
+	mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 0);
+
+	/* assert reset */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu);
+	val &= ~(1 << RESET_nCPUPORESET_0);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu, val);
+
+	/* PWRSW_CNTRL1_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << PWRSW_CNTRL1_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	udelay(100);
+
+	/* PWRSW_CNTRL2_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << PWRSW_CNTRL2_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+	/* turn off isolation cells */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << nCPU_ISO_MODE_EN);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+	udelay(100);
+
+	/* release reset */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu);
+	val |= (1 << RESET_nCPUPORESET_0);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu, val);
+
+	return PSCI_E_SUCCESS;
+}
+
+
+int berlin_soc_pwr_domain_off(unsigned int target_cpu)
+{
+	unsigned int val;
+
+	/* turn on isolation cells */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val &= ~(1 << nCPU_ISO_MODE_EN);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	/* PWRSW_CNTRL1_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val &= ~(1 << PWRSW_CNTRL1_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	/* PWRSW_CNTRL2_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val &= ~(1<< PWRSW_CNTRL2_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	return PSCI_E_SUCCESS;
+}
+
+int berlin_soc_pwr_enable_pmu(unsigned int target_cpu)
+{
+	/* enable PMU */
+	mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 1);
+
+	return PSCI_E_SUCCESS;
+}
+
+
+int berlin_soc_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
+{
+	unsigned long target_cpu;
+	unsigned int val;
+
+	/* Get the linear id for this cpu */
+	target_cpu = plat_my_core_pos();
+
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	/* PWRSW_CNTRL1_I */
+	val |= (1 << PWRSW_CNTRL1_I);
+
+	/* PWRSW_CNTRL2_I */
+	val |= (1 << PWRSW_CNTRL2_I);
+	/* turn off isolation cells */
+	val |= (1 << nCPU_ISO_MODE_EN);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	/* disable PMU */
+	mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 0);
+
+	return PSCI_E_SUCCESS;
+
+}
+
+void berlin_soc_pm_init(void)
+{
+	sm_config_t sm_config;
+	int i;
+
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CFG, 0xf);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CpuPmuPwrSwDly, 250);
+	for (i = 1; i < PLATFORM_CORE_COUNT; i++) {
+		unsigned int val;
+		uintptr_t addr;
+		/* assert reset */
+		addr = MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0  + i * 4;
+		val = mmio_read_32(addr);
+		val &= ~(1 << RESET_nCPUPORESET_0);
+		mmio_write_32(addr, val);
+	}
+
+	sm_config.queue_base = (void *)SM_SEND_MSGQ;
+	sm_config.sm_ctrl_base = (void *)SMREG_BASE;
+	sm_set_config(&sm_config);
+}
+
+void __dead2 berlin_system_off(void)
+{
+	INFO("Berlin System Off .......\n");
+	sm_do_system_off();
+	while (1);
+	ERROR("Berlin System Off: should not be here.\n");
+	panic();
+}
+
+void __dead2 berlin_system_reset(void)
+{
+	INFO("Berlin System Reset ......\n");
+	sm_do_system_reset();
+	while (1);
+	ERROR("Berlin System reset: should not be here.\n");
+	panic();
+}
+
+
+int berlin_system_reset2(int is_vendor,
+			int reset_type, u_register_t cookie)
+{
+	INFO("Berlin System Reset2: reset_type = 0x%x ......\n", reset_type);
+
+	//fix me
+	mmio_write_32(REBOOT_PARAM_ADDR, reset_type);
+
+	sm_do_system_reset();
+	while (1);
+	/*
+	 * berlin_system_reset cannot return (it is a __dead function),
+	 * but berlin_system_reset2 has to return some value, even in
+	 * this case.
+	 */
+	ERROR("Berlin System reset2: should not be here.\n");
+
+	return 0;
+}
+
+extern unsigned char *nagra_boot_p;
+extern unsigned int suspend_entry[];
+extern unsigned int suspend_size;
+static unsigned char sram_backup[SRAM_BACKUP_SIZE];
+
+typedef void (*suspend_handler_t)(unsigned long, unsigned int, void *);
+
+void berlin_suspend_to_sram(unsigned long sec_entrypoint,
+				unsigned int power_state)
+{
+	suspend_handler_t suspend_func;
+
+	/* Save the MPT sram to ddr */
+	memcpy(sram_backup, (void *)SUSPEND_SRAM_BASE, suspend_size);
+
+	/*
+	 * Copy code to SRAM, and jump to it later
+	 */
+	memcpy((void *)SUSPEND_SRAM_BASE,
+		(const void *)suspend_entry, suspend_size);
+
+	flush_dcache_range(SUSPEND_SRAM_BASE, suspend_size);
+
+	/*
+	 * disable the mmu before jump to sram entry, or, it will lead
+	 * to a permission fault when execute in SRAM, because of WXN and XN
+	 * bit effect.
+	 */
+	disable_mmu_el3();
+
+	/* Jump to SRAM base */
+	suspend_func = (suspend_handler_t)SUSPEND_SRAM_BASE;
+	suspend_func(sec_entrypoint, power_state, nagra_boot_p);
+}
+
+void berlin_resume_from_sram(void)
+{
+	/* Restore the sram from ddr */
+	memcpy((void *)SUSPEND_SRAM_BASE, sram_backup, suspend_size);
+}
+
+void berlin_get_sys_suspend_power_state(psci_power_state_t *req_state)
+{
+	assert(req_state);
+
+	/* lower affinities use PLAT_MAX_OFF_STATE */
+	req_state->pwr_domain_state[MPIDR_AFFLVL0] = PLAT_MAX_OFF_STATE;
+	req_state->pwr_domain_state[MPIDR_AFFLVL1] = BERLIN_SUSPEND;
+	req_state->pwr_domain_state[MPIDR_AFFLVL2] = BERLIN_SUSPEND;
+}
