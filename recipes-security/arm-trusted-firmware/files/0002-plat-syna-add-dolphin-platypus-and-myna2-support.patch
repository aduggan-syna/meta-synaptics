+    #define   GET32CPU_PCH_PCH_STATE(r32)                      _BFGET_(r32,26,21)
+    #define   SET32CPU_PCH_PCH_STATE(r32,v)                    _BFSET_(r32,26,21,v)
+    #define   GET16CPU_PCH_PCH_STATE(r16)                      _BFGET_(r16,10, 5)
+    #define   SET16CPU_PCH_PCH_STATE(r16,v)                    _BFSET_(r16,10, 5,v)
