+
+#define readl(a)		mmio_read_32((uintptr_t)(a))
+#define writel(v, a)	mmio_write_32((uintptr_t)(a), v)
+
+uint32_t secure_register_op(uint32_t op, uint32_t index, uint32_t *value)
+{
+	uint32_t reg_addr = 0;
+	uint32_t mask = 0;
+	uint32_t reg_value = 0;
+
+	if (index >= TZ_SECUREREG_MAX)
+		return SYNA_SECURE_REGISTER_REJECTED;
+
+	reg_addr = sec_regs[index].reg;
+	mask = sec_regs[index].mask;
+	if (!reg_addr) {
+		ERROR("bad address @0x%x reg.\n", index);
+		return SYNA_SECURE_REGISTER_REJECTED;
+	}
+
+	if (!mask) {
+		ERROR("bad mask @0x%x.\n", mask);
+		return SYNA_SECURE_REGISTER_REJECTED;
+	}
+
+	if (op == SYNA_SREGISTER_READ)
+		*value = (readl(reg_addr) & mask);
+	else if (op == SYNA_SREGISTER_WRITE) {
+		reg_value = readl(reg_addr);
+		reg_value &= ~mask;
+		reg_value |= (*value & mask);
+		writel(reg_value, reg_addr);
+	} else
+		return SYNA_SECURE_REGISTER_REJECTED;
+
+	return SYNA_SECURE_REGISTER_OK;
+}
diff --git a/plat/syna/berlin/common/drivers/sm/sm.c b/plat/syna/berlin/common/drivers/sm/sm.c
new file mode 100644
index 0000000..67ed52f
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/sm/sm.c
@@ -0,0 +1,166 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <arch_helpers.h>
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "sm.h"
+
+#ifndef RA_smSysCtl_SM_BOOT_STATUS
+#define RA_smSysCtl_SM_BOOT_STATUS	0x34
+#endif
+
+#define SM_MSG_SIZE                     32
+#define SM_MSGQ_TOTAL_SIZE              512
+#define SM_MSGQ_HEADER_SIZE             SM_MSG_SIZE
+#define SM_MSGQ_SIZE                    (SM_MSGQ_TOTAL_SIZE - SM_MSGQ_HEADER_SIZE )
+#define MV_SM_ID_POWER                  5
+#define MV_SM_POWER_SUSPEND_REQUEST     2
+#define MV_SM_ACTIVE_2_SUSPEND_RESP     0xA0
+#define MV_SM_SUSPEND_2_ACTIVE_RESP     6
+#define MV_SM_POWER_STANDBY_REQUEST     1
+#define MV_SM_ACTIVE_2_NORMALSTANDBY_RESP	4
+#define MV_SM_POWER_SYS_RESET           0xFF
+#define SM_MSG_BODY_SIZE        	(SM_MSG_SIZE - sizeof(short) * 2)
+
+#define MV_SOC_STATE_ACTIVE_2_SUSPEND	0xA0
+#define MV_SOC_STATE_SUSPEND_REQUEST	0xA1
+
+
+#define MV_SM_POWER_SUSPEND_TYPE_WFI	0x0F1
+#define MV_SM_POWER_SUSPEND_TYPE_PWROFF	0x0FF
+
+#define SM_Q_PUSH( pSM_Q ) {                                    	\
+	                pSM_Q->m_iWrite += SM_MSG_SIZE;                 \
+	                if( pSM_Q->m_iWrite >= SM_MSGQ_SIZE )           \
+	                        pSM_Q->m_iWrite -= SM_MSGQ_SIZE;        \
+	                pSM_Q->m_iWriteTotal += SM_MSG_SIZE; }
+
+#define SM_Q_POP( pSM_Q ) {                                     	\
+	                pSM_Q->m_iRead += SM_MSG_SIZE;                  \
+	                if( pSM_Q->m_iRead >= SM_MSGQ_SIZE )            \
+	                        pSM_Q->m_iRead -= SM_MSGQ_SIZE;         \
+	                pSM_Q->m_iReadTotal += SM_MSG_SIZE; }
+
+typedef struct {
+
+	short   m_iModuleID;
+	short   m_iMsgLen;
+	char    m_pucMsgBody[SM_MSG_BODY_SIZE];
+} MV_SM_Message;
+
+typedef struct {
+	int     m_iWrite;
+	int     m_iRead;
+	int     m_iWriteTotal;
+	int     m_iReadTotal;
+	char    m_Padding[SM_MSGQ_HEADER_SIZE - sizeof(int) * 4];
+	char    m_Queue[SM_MSGQ_SIZE];
+} MV_SM_MsgQ;
+
+static sm_config_t sm_config = {
+	.queue_base = (void*)(0x04004000-512*3 - 0x04000000 + 0xF7FA0000),
+	.sm_ctrl_base = (void*)0xF7FE2000,
+};
+
+void sm_set_config(sm_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&sm_config, config, sizeof(sm_config_t));
+
+	assert(sm_config.queue_base != NULL);
+}
+
+static int sm_send_msg(MV_SM_Message *m)
+{
+	int ret = 0;
+	MV_SM_Message *p;
+	MV_SM_MsgQ *sm_queue;
+
+	sm_queue = (MV_SM_MsgQ*)sm_config.queue_base;
+	p = (MV_SM_Message*)(&(sm_queue->m_Queue[sm_queue->m_iWrite]));
+	memcpy(p, m, sizeof(*p));
+	SM_Q_PUSH(sm_queue);
+	dsb();
+
+	return ret;
+}
+
+static inline int sm_get_boot_status(void)
+{
+	return mmio_read_32((unsigned long)sm_config.sm_ctrl_base +
+						RA_smSysCtl_SM_BOOT_STATUS);
+}
+
+static inline void sm_wait_for_complete(unsigned int status)
+{
+	while (sm_get_boot_status() != status);
+}
+
+void sm_do_system_warmdown(unsigned int power_state)
+{
+	MV_SM_Message m;
+	unsigned int *msg = (unsigned int*)m.m_pucMsgBody;
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 12;
+	*msg = MV_SM_POWER_SUSPEND_REQUEST;
+
+	if (power_state) {
+		msg[2] = MV_SM_POWER_SUSPEND_TYPE_WFI;
+	} else {
+		msg[2] = MV_SM_POWER_SUSPEND_TYPE_PWROFF;
+	}
+	sm_send_msg(&m);
+	sm_wait_for_complete(MV_SOC_STATE_SUSPEND_REQUEST);
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 4;
+	*msg = MV_SM_ACTIVE_2_SUSPEND_RESP;
+	sm_send_msg(&m);
+
+	sm_wait_for_complete(MV_SOC_STATE_ACTIVE_2_SUSPEND);
+}
+
+void sm_do_system_warmup(unsigned int power_state)
+{
+	MV_SM_Message m;
+	void *msg = m.m_pucMsgBody;
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 4;
+	*(unsigned int*)msg = MV_SM_SUSPEND_2_ACTIVE_RESP;
+	sm_send_msg(&m);
+}
+
+void sm_do_system_reset(void)
+{
+	MV_SM_Message m;
+	void *msg = m.m_pucMsgBody;
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 4;
+	*(unsigned int*)msg = MV_SM_POWER_SYS_RESET;
+	sm_send_msg(&m);
+}
+
+void sm_do_system_off(void)
+{
+	MV_SM_Message m;
+	void *msg = m.m_pucMsgBody;
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 4;
+	*(unsigned int *)msg = MV_SM_POWER_STANDBY_REQUEST;
+	sm_send_msg(&m);
+
+	m.m_iModuleID = MV_SM_ID_POWER;
+	m.m_iMsgLen = 4;
+	*(unsigned int *)msg = MV_SM_ACTIVE_2_NORMALSTANDBY_RESP;
+	sm_send_msg(&m);
+}
diff --git a/plat/syna/berlin/common/drivers/tos/tz.c b/plat/syna/berlin/common/drivers/tos/tz.c
new file mode 100644
index 0000000..2851367
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/tos/tz.c
@@ -0,0 +1,183 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <common/debug.h>
+#include <assert.h>
+#include "tz_boot_param.h"
+#include "bcm.h"
+#include "rf.h"
+#include "crypto.h"
+
+void tos_reset_secure_rf_param(uint32_t rf_id,
+				uint32_t rf_attr)
+{
+	struct tz_boot_param *rf_param;
+	struct rf_window *rf;
+
+	rf_param = tz_boot_param_get(TZ_BOOT_PARAM_REGFIREWALL);
+	if (rf_param) {
+		assert((rf_id + 1) * sizeof(*rf) <=
+				rf_param->size - sizeof(*rf_param));
+		rf = (struct rf_window *)rf_param->data;
+		rf[rf_id].attr = rf_attr;
+	}
+}
+
+void tos_save_secure_boot_param(void *nw_param_base,
+				void *nw_region_base,
+				void *sw_param_base,
+				unsigned int sw_param_size)
+{
+	int ret, offset = 0;
+	struct tz_boot_param *boot_param;
+	struct tz_boot_param_header header;
+	struct tz_verify_region *verify_region;
+	int verify_region_size = 0;
+	unsigned char *tee_config = (unsigned char*)sw_param_base;
+
+	if (nw_param_base == NULL ||
+			sw_param_base == NULL ||
+			sw_param_size <= 0)
+		return;
+
+	ret = tz_boot_param_init(nw_param_base);
+	if(ret)
+		panic();
+	memset(tee_config, 0, sw_param_size);
+
+	/* reserve the header space */
+	offset += sizeof(header);
+	assert(offset <= sw_param_size);
+
+	/* fill the memory zone */
+	boot_param = tz_boot_param_get(TZ_BOOT_PARAM_MEMZONE);
+	if (boot_param) {
+		assert(offset + boot_param->size <= sw_param_size);
+		memcpy(tee_config + offset, boot_param, boot_param->size);
+		offset += boot_param->size;
+	}
+
+	/* fill the register firewall */
+	boot_param = tz_boot_param_get(TZ_BOOT_PARAM_REGFIREWALL);
+	if (boot_param) {
+		assert(offset + boot_param->size <= sw_param_size);
+		memcpy(tee_config + offset, boot_param, boot_param->size);
+		offset += boot_param->size;
+	}
+
+	/* fill the secure master */
+	boot_param = tz_boot_param_get(TZ_BOOT_PARAM_MASTER);
+	if (boot_param) {
+		assert(offset + boot_param->size <= sw_param_size);
+		memcpy(tee_config + offset, boot_param, boot_param->size);
+		offset += boot_param->size;
+	}
+
+	/* fill mem region for SHA256, just for nagra*/
+	verify_region = (struct tz_verify_region *)nw_region_base;
+	if (verify_region) {
+		verify_region_size = verify_region->nums * sizeof(struct region);
+		assert(offset + sizeof(struct tz_boot_param) + verify_region_size <= sw_param_size);
+		boot_param = (struct tz_boot_param*)(tee_config + offset);
+		boot_param->id = TZ_BOOT_VERIFY_REGION;
+		boot_param->size = sizeof(struct tz_boot_param) + verify_region_size;
+		memcpy(tee_config + offset + sizeof(struct tz_boot_param),
+				verify_region->regs, verify_region_size);
+		offset += boot_param->size;
+	}
+
+	/* fill the header */
+	header.size = offset;
+	header.magic_num = TZ_BOOT_PARAM_MAGIC_NUM;
+	header.version = TZ_BOOT_PARAM_VERSION ;
+	memcpy(tee_config, &header, sizeof(header));
+	assert(offset <= sw_param_size);
+}
+
+void tos_resume(void* param)
+{
+}
+
+static int tos_compute_ddr_sha(void *param)
+{
+	int i, num;
+	struct tz_boot_param *boot_param;
+	struct region *value;
+
+	if (!param)
+		return -1;
+
+	if (tz_boot_param_init(param))
+		return -1;
+
+	boot_param = tz_boot_param_get(TZ_BOOT_VERIFY_REGION);
+	if (boot_param) {
+		/* the region need sha256 verify on nagra */
+		value = (struct region*)boot_param->data;
+		num = (boot_param->size - sizeof(struct tz_boot_param))
+			/ sizeof(struct region);
+
+		assert(num <= MAX_DDR_REG_NUM);
+
+#if defined(BCM_CALCULATE_HASH)
+		struct ddr_reg_info ddr_info[MAX_DDR_REG_NUM];
+
+		// BCM to calculate the DDR hash value
+
+		for (i = 0; i < num; i++) {
+			INFO("region %d, base 0x%p, len %x\n", i, value[i].base,
+					value[i].size);
+			ddr_info[i].ddr_info_type = 2;
+			ddr_info[i].ddr_info_data.ddr_reg.base = (uintptr_t)value[i].base;
+			ddr_info[i].ddr_info_data.ddr_reg.size = value[i].size;
+		}
+
+		bcm_calculate_and_store_hash(ddr_info, num);
+
+		INFO("#######done#######\n");
+#else
+		struct ddr_reg_info ddr_info __aligned(64);
+
+		// ACPU to calculate the DDR hash value
+		ddr_info.ddr_info_type = 1;
+
+		for (i = 0; i < num; i++) {
+			hash_state md;
+			INFO("region %d, base %p, len %x\n", i, value[i].base,
+					value[i].size);
+			sha256_init(&md);
+			sha256_process(&md, (void *)(uintptr_t)(value[i].base), value[i].size);
+			sha256_done(&md, (unsigned char*)ddr_info.ddr_info_data.hash_value + i * HASH_LEN);
+			INFO("#######done#######\n");
+		}
+
+#ifdef CONFIG_BERLIN_LP_MMU_ENABLE
+		flush_dcache_range((uintptr_t)&ddr_info, sizeof(ddr_info));
+#endif
+
+#if defined(CONFIG_GENX)
+		bcm_kernel_genx_store_hash((void *)ddr_info.ddr_info_data.hash_value, i * HASH_LEN);
+#else
+		struct tz_boot_param_header *header = (struct tz_boot_param_header*)param;
+
+		bcm_kernel_store_hash(&ddr_info, 0, param, header->size);
+#endif
+#endif
+	}
+	return 0;
+}
+
+void tos_suspend(void *param, uint32_t power_state)
+{
+	int ret;
+	if (param && !power_state) {
+		ret = tos_compute_ddr_sha(param);
+		if (ret)
+			panic();
+
+	}
+}
diff --git a/plat/syna/berlin/common/drivers/tos/tz_boot_param.c b/plat/syna/berlin/common/drivers/tos/tz_boot_param.c
new file mode 100644
index 0000000..1b6a12e
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/tos/tz_boot_param.c
@@ -0,0 +1,45 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "tz_boot_param.h"
+#include "assert.h"
+
+#ifndef CONFIG_BOOT_PARAM_MAX_SIZE
+#define CONFIG_BOOT_PARAM_MAX_SIZE	(100 << 10)
+#endif /* CONFIG_BOOT_PARAM_MAX_SIZE */
+
+static struct tz_boot_param_header *root = 0;
+
+int tz_boot_param_init(void *addr)
+{
+	if (!addr)
+		return -1;
+
+	root = addr;
+
+	if (root->magic_num != TZ_BOOT_PARAM_MAGIC_NUM ||
+			root->version != TZ_BOOT_PARAM_VERSION)
+
+		return -1;
+	return 0;
+}
+
+struct tz_boot_param *tz_boot_param_get(uint32_t id)
+{
+	if (!root)
+		return 0;
+
+	uint32_t size = sizeof(struct tz_boot_param_header);
+
+	while (size < root->size) {
+		struct tz_boot_param *curr = (void*)((unsigned long)root + size);
+		if (curr->id == id)
+			return curr;
+		size += curr->size;
+	}
+
+	return 0;
+}
diff --git a/plat/syna/berlin/common/drivers/watchdog/wdt.c b/plat/syna/berlin/common/drivers/watchdog/wdt.c
new file mode 100644
index 0000000..69ae863
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/watchdog/wdt.c
@@ -0,0 +1,98 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <platform_def.h>
+
+#define readl(a)		mmio_read_32((uintptr_t)(a))
+#define writel(v, a)	mmio_write_32((uintptr_t)(a), v)
+
+#ifndef CONFIG_DW_WDT_BASE
+#define CONFIG_DW_WDT_BASE				0xF7E81400
+#define RA_Gbl_WDTSysRstMask			0x0484
+#endif
+#define SOC_CHIP_CTRL_REG_BASE			MEMMAP_CHIP_CTRL_REG_BASE
+
+#define CONFIG_DW_WDT_CLOCK_KHZ			25000
+#define SYSTEM_RESET_MODE	0
+
+#define DW_WDT_CR	0x00
+#define DW_WDT_TORR	0x04
+#define DW_WDT_CRR	0x0C
+
+#define DW_WDT_CR_EN_OFFSET		0x00
+#define DW_WDT_CR_RMOD_OFFSET	0x01
+#define DW_WDT_CRR_RESTART_VAL	0x76
+#define DW_WDT_CR_RPL_OFFSET	0x02
+#define DW_WDT_CR_RPL_MASK		0x07
+#define DW_WDT_CR_RPL_PCLK_8	0x02
+
+static void berlin_dw_wdt_set_rspmode(int mode)
+{
+	unsigned int reg = readl(CONFIG_DW_WDT_BASE + DW_WDT_CR);
+	if (mode)
+		reg |= (1 << DW_WDT_CR_RMOD_OFFSET);
+	else
+		reg &= ~(1 << DW_WDT_CR_RMOD_OFFSET);
+	writel(reg, CONFIG_DW_WDT_BASE + DW_WDT_CR);
+}
+
+static void berlin_dw_wdt_set_rpl(unsigned int rpl)
+{
+	unsigned int reg = readl(CONFIG_DW_WDT_BASE + DW_WDT_CR);
+	reg &= ~(DW_WDT_CR_RPL_MASK << DW_WDT_CR_RPL_OFFSET);
+	reg |= (rpl << DW_WDT_CR_RPL_OFFSET);
+	writel(reg, CONFIG_DW_WDT_BASE + DW_WDT_CR);
+}
+
+static void berlin_dw_wdt_init(void)
+{
+	unsigned int wdt_mask;
+
+	//Gbl + 0x0484 WDTSysRstMask
+	wdt_mask = readl(SOC_CHIP_CTRL_REG_BASE + RA_Gbl_WDTSysRstMask);
+	//Clear bit0 for wdt0 mask, bit1 for wdt1, bit2 for wdt2
+	wdt_mask &= ~(1<<0);
+	writel(wdt_mask, SOC_CHIP_CTRL_REG_BASE + RA_Gbl_WDTSysRstMask);
+
+	//interrupt mode, and reset signal pulse repeat 8 pclk cycles
+	berlin_dw_wdt_set_rspmode(SYSTEM_RESET_MODE);
+	berlin_dw_wdt_set_rpl(DW_WDT_CR_RPL_PCLK_8);
+	writel(0, (CONFIG_DW_WDT_BASE + DW_WDT_TORR));
+}
+
+static void berlin_dw_wdt_enable(void)
+{
+	unsigned int reg = readl(CONFIG_DW_WDT_BASE + DW_WDT_CR);
+	reg |= 0x1 << DW_WDT_CR_EN_OFFSET;
+	writel(reg, CONFIG_DW_WDT_BASE + DW_WDT_CR);
+}
+
+static unsigned int berlin_dw_wdt_is_enabled(void)
+{
+	unsigned long val;
+	val = readl((CONFIG_DW_WDT_BASE + DW_WDT_CR));
+	return val & 0x1;
+}
+
+static void berlin_dw_wdt_restart(void)
+{
+	if (berlin_dw_wdt_is_enabled())
+		/* restart the watchdog counter */
+		writel(DW_WDT_CRR_RESTART_VAL,
+		       (CONFIG_DW_WDT_BASE + DW_WDT_CRR));
+}
+
+void reset_soc(void)
+{
+	berlin_dw_wdt_init();
+	berlin_dw_wdt_enable();
+	berlin_dw_wdt_restart();
+	while (1)
+		/*nothing*/;
+
+}
diff --git a/plat/syna/berlin/common/gicv2_ext.c b/plat/syna/berlin/common/gicv2_ext.c
new file mode 100644
index 0000000..11077e8
--- /dev/null
+++ b/plat/syna/berlin/common/gicv2_ext.c
@@ -0,0 +1,120 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <arch.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <plat/common/platform.h>
+#include <drivers/arm/gicv2.h>
+#include <bl31/interrupt_mgmt.h>
+#include <platform_def.h>
+#include <drivers/arm/gic_common.h>
+#include <drivers/arm/gicv2.h>
+#include <lib/mmio.h>
+#include <gicv2_ext.h>
+
+extern unsigned int gicd_read_ipriorityr(uintptr_t base, unsigned int id);
+
+static unsigned int plat_ic_get_interrupt_priority(unsigned int id)
+{
+	unsigned int ipriorityr = 0;
+	unsigned int priority = 0;
+
+	ipriorityr = gicd_read_ipriorityr(PLAT_ARM_GICD_BASE, id);
+
+	priority = ipriorityr >> (id % 4 * 8) & GIC_PRI_MASK;
+
+	return priority;
+}
+
+static inline uint8_t gicd_get_itargetsr(uintptr_t base, unsigned int id)
+{
+	return mmio_read_8(base + GICD_ITARGETSR + id);
+}
+
+static inline void gicd_set_itargetsr(uintptr_t base, unsigned int id,
+		unsigned int target)
+{
+	uint8_t val = target & GIC_TARGET_CPU_MASK;
+
+	mmio_write_8(base + GICD_ITARGETSR + id, val);
+}
+
+static uint8_t plat_ic_get_interrupt_target(unsigned int id)
+{
+	return gicd_get_itargetsr(PLAT_ARM_GICD_BASE, id);
+}
+
+static void plat_ic_set_spi_target(unsigned int id, unsigned int routing_mode,
+							unsigned int target)
+{
+	switch (routing_mode) {
+	case INTR_ROUTING_MODE_PE:
+		gicd_set_itargetsr(PLAT_ARM_GICD_BASE, id, target);
+		break;
+	case INTR_ROUTING_MODE_ANY:
+		gicd_set_itargetsr(PLAT_ARM_GICD_BASE, id, GIC_TARGET_CPU_MASK);
+		break;
+	default:
+		break;
+	}
+}
+void plat_ic_set_cfg(unsigned int id, unsigned int cfg)
+{
+	gicv2_interrupt_set_cfg(id, cfg);
+}
+
+static unsigned int plat_ic_get_cfg(unsigned int id)
+{
+	/* Interrupt configuration is a 2-bit field */
+	unsigned int bit_num = id & ((1U << ICFGR_SHIFT) - 1U);
+	unsigned int bit_shift = bit_num << 1;
+	unsigned int n = id >> ICFGR_SHIFT;
+	uint32_t reg_val = mmio_read_32(PLAT_ARM_GICD_BASE + GICD_ICFGR + (n << 2));
+
+	return (reg_val & (GIC_CFG_MASK << bit_shift)) >> bit_shift;
+}
+
+void plat_ic_save_interrupt_status(unsigned int id, irq_status_t *is)
+{
+	uint8_t itargetsr = 0;
+
+	is->int_type = plat_ic_get_interrupt_type(id);
+	is->priority = plat_ic_get_interrupt_priority(id);
+	is->icfg = plat_ic_get_cfg(id);
+	itargetsr = plat_ic_get_interrupt_target(id);
+	if (itargetsr == GIC_TARGET_CPU_MASK)
+		is->mode = INTR_ROUTING_MODE_ANY;
+	else {
+		is->mode = INTR_ROUTING_MODE_PE;
+		is->target = itargetsr;
+	}
+}
+
+void plat_ic_setup_wakeup_interrupt(unsigned int id, unsigned int level)
+{
+#if GICV2_G0_FOR_EL3
+	plat_ic_set_interrupt_type(id, INTR_TYPE_EL3);
+#else
+	plat_ic_set_interrupt_type(id, INTR_TYPE_S_EL1);
+#endif
+	plat_ic_set_interrupt_priority(id, PLAT_RAS_PRI);
+	plat_ic_clear_interrupt_pending(id);
+	plat_ic_set_spi_routing(id, INTR_ROUTING_MODE_PE, read_mpidr());
+	if (!level)
+		plat_ic_set_cfg(id, GIC_INTR_CFG_EDGE);
+	plat_ic_enable_interrupt(id);
+}
+
+void plat_ic_resume_wakeup_interrupt(unsigned int id, irq_status_t *is)
+{
+	plat_ic_disable_interrupt(id);
+	plat_ic_clear_interrupt_pending(id);
+	plat_ic_set_interrupt_type(id, is->int_type);
+	plat_ic_set_interrupt_priority(id, is->priority);
+	plat_ic_set_spi_target(id, is->mode, is->target);
+	plat_ic_set_cfg(id, is->icfg);
+}
