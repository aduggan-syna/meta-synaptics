diff --git a/security/genx/enc.sh b/security/genx/enc.sh
new file mode 100755
index 0000000..03ba691
--- /dev/null
+++ b/security/genx/enc.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+# Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+function gen_ATF()
+{
+  in_img_type="ATF"
+  in_signing_key=$data_dir/K1_REE_A.rsa.priv.pem
+  # TODO: Take below 4 params as parameter
+  in_seg_id=0x00000000
+  in_seg_id_mask=0xFFFFFFFF
+  in_version=0x00000000
+  in_version_mask=0xFFFFFFFF
+  in_extras=$tmp_dir/in_atf_extras.bin
+  in_payload_length=0x0
+  in_payload=$clearimg
+  out_ATF=$encimg
+
+  echo "Generating $in_img_type"
+  echo "Generating ATF x parameters"
+  prod_image_flag=0x00000000
+  destination_addr=0x00120000
+  $fun_dir/in_extras.py $in_img_type $in_extras $prod_image_flag $destination_addr
+
+  $fun_dir/gen_img1.sh $in_img_type $in_signing_key $in_seg_id $in_seg_id_mask $in_version $in_version_mask $in_extras $in_payload_length $in_payload $out_ATF
+  echo $fun_dir/gen_img1.sh $in_img_type $in_signing_key $in_seg_id $in_seg_id_mask $in_version $in_version_mask $in_extras $in_payload_length $in_payload $out_ATF
+}
+
+# ----------------------------------------------------------------------------------------
+
+function gen_tz_kernel()
+{
+  in_img_type="TZ_KERNEL"
+  in_signing_key=$data_dir/K1_REE_A.rsa.priv.pem
+  # TODO: Take below 4 params as parameter
+  in_seg_id=0x00000000
+  in_seg_id_mask=0xFFFFFFFF
+  in_version=0x00000000
+  in_version_mask=0xFFFFFFFF
+  in_extras=$tmp_dir/in_tz_kernel_extras.bin
+  in_payload_length=0x0
+  in_payload=$clearimg
+  out_TZ_KERNEL=$encimg
+
+  echo "Generating $in_img_type"
+  echo "Generating tz kernel x parameters"
+  prod_image_flag=0x00000000
+  destination_addr=0x00160000
+  $fun_dir/in_extras.py $in_img_type $in_extras $prod_image_flag $destination_addr
+
+  $fun_dir/gen_img1.sh $in_img_type $in_signing_key $in_seg_id $in_seg_id_mask $in_version $in_version_mask $in_extras $in_payload_length $in_payload $out_TZ_KERNEL
+  echo $fun_dir/gen_img1.sh $in_img_type $in_signing_key $in_seg_id $in_seg_id_mask $in_version $in_version_mask $in_extras $in_payload_length $in_payload $out_TZ_KERNEL
+}
+
+# ----------------------------------------------------------------------------------------
+
+if [ $# != 5 ]; then
+  echo "Usage:"
+  echo "$0 [chip name] [chip revision] [ATF|TZK] [input] [output]"
+  echo "example: $0 platypus A0 TZK tz.bin tz2_en.bin"
+  exit 1
+fi
+
+chip_name=$1
+chip_rev=$2
+img_type=$3
+clearimg=$4
+encimg=$5
+
+data_dir=${security_dir}/keys/chips/${chip_name}/${chip_rev}/generic/ree/
+fun_dir=${security_dir}/fun/
+tmp_dir=${security_dir}/tmp
+
+if [ -d ${tmp_dir} ]; then
+  rm -rf ${tmp_dir}
+fi
+mkdir ${tmp_dir}
+
+case $img_type in
+  ATF)
+    gen_ATF
+    ;;
+  TZK)
+    gen_tz_kernel
+    ;;
+  *)
+    echo "Image type should be ATF or TZK!"
+    ;;
+esac
+
+if [ -d ${tmp_dir} ]; then
+  rm -rf ${tmp_dir}
+fi
+
+
