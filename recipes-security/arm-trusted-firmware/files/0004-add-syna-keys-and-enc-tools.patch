+#!/bin/sh
+# Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+function shellCall()
+{
+  shellCmd=$@
+  #echo "[`date +%F_%T`][CMD] $shellCmd"
+  echo "[`date +%F_%T`][CMD] $shellCmd" >> ${LogFile}
+  $shellCmd >> ${LogFile} 2>&1
+}
+
+function error_handling2()
+{
+  error_code=$1
+  if [ $error_code -ne 0 ]; then
+    echo "[ERROR] ret=$error_code, Failed Step: $shellCmd"
+    exit $error_code
+  fi
+}
+
+function shellCheckCall()
+{
+  shellCall $@
+  error_handling2 $? "$@"
+}
