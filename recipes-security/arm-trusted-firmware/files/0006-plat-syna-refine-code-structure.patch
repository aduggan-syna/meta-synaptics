+int mailbox_h2s_get_spk_version(unsigned int *version, int mailbox_id)
+{
+	struct mailbox_command cmd = {0};
+	int ret = 0;
+	unsigned int data[MAX_MAILBOX_DATA_LEN] = {-1};
+
+	cmd.command = MAILBOX_COMMAND(HOST2SYNA_SENDER_M52, mailbox_id, HOST2SYNA_CMD_SOC, SPI_PI_QUERY_SPK_VERSION);
+	cmd.param_num = 0;
+
+	ret = mailbox_h2s_send_command(cmd);
+	if (ret) {
+		INFO("fail to send command.\n");
+		return ret;
+	}
+
+	ret = mailbox_h2s_get_response(mailbox_id, data, TIMEOUT_US);
+	if (ret < 0 || (ret != 2)) {
+		INFO("Fail to get SPK version from synaprot.\n");
+	} else {
+		*version = data[1];
+		INFO("%s version = 0x%x.\n", mailbox_id ? "REE" : "TEE", *version);
+	}
+
+	return ret;
+}
+
+psa_status_t mailbox_init(void)
+{
+	unsigned int version = 0;
