diff --git a/plat/syna/berlin/common/drivers/appcrypto/appcrypto_lock.c b/plat/syna/berlin/common/drivers/appcrypto/appcrypto_lock.c
new file mode 100644
index 0000000..fd939f0
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/appcrypto/appcrypto_lock.c
@@ -0,0 +1,79 @@
+/*
+ * Copyright (c) 2025, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "nexus_fw_include/mcu_cpu_ss.h"
+#include "nexus_fw_include/nexus_klamath_memmap.h"
+#include <lib/mmio.h>
+#include <platform_def.h>
+
+#define MCU_SYSCTRL_S_BASE MCU_PERIF_REGION(START_MCU_SYSCTRL_S)
+
+#define APP_CRYPTO_INTF_LOCK_CTRL (MCU_SYSCTRL_S_BASE + RA_MCS_REG_SPROT_MBOX + RA_MCS_INTF_LOCK_INTF_LOCK_CTRL)
+#define APP_CRYPTO_INTF_LOCK_STAT (MCU_SYSCTRL_S_BASE + RA_MCS_REG_SPROT_MBOX + RA_MCS_INTF_LOCK_INTF_LOCK_STAT)
+
+#define MID_M52 0x0
+
+int32_t appcrypto_lock(void)
+{
+	/*
+	 * 1. Read MCS_REG_APP_CRYPTO_INTF_LOCK_STAT.locked, if 1, keep trying
+	 * 2. Write MCS_REG_APP_CRYPTO_INTF_LOCK_CTRL.lock to 1 to claim lock.
+	 * 3. Read MCS_REG_APP_CRYPTO_INTF_LOCK_STAT.locked and .mid. Make sure
+	 *    the MID matches itself, indicating it successfully claimed the lock.
+	*/
+	T32MCS_INTF_LOCK_INTF_LOCK_STAT stat;
+	T32MCS_INTF_LOCK_INTF_LOCK_CTRL ctrl;
+
+	do {
+		stat.u32 = mmio_read_32(APP_CRYPTO_INTF_LOCK_STAT);
+	} while(stat.uINTF_LOCK_STAT_locked);
+
+	ctrl.uINTF_LOCK_CTRL_lock = 1;
+	mmio_write_32(APP_CRYPTO_INTF_LOCK_CTRL, ctrl.u32);
+
+	stat.u32 = mmio_read_32(APP_CRYPTO_INTF_LOCK_STAT);
+	if (stat.uINTF_LOCK_STAT_locked && (stat.uINTF_LOCK_STAT_mid == MID_M52))
+		return 0;
+
+	/* FIXME: go back to loop and wait or return? */
+	return -1;
+}
+
+int32_t appcrypto_try_lock(void)
+{
+	/* Read MCS_REG_APP_CRYPTO_INTF_LOCK_STAT.locked, if 1, return */
+	T32MCS_INTF_LOCK_INTF_LOCK_STAT stat;
+	T32MCS_INTF_LOCK_INTF_LOCK_CTRL ctrl;
+
+	stat.u32 = mmio_read_32(APP_CRYPTO_INTF_LOCK_STAT);
+	if (stat.uINTF_LOCK_STAT_locked)
+		return -1;
+
+	ctrl.uINTF_LOCK_CTRL_lock = 1;
+	mmio_write_32(APP_CRYPTO_INTF_LOCK_CTRL, ctrl.u32);
+
+	stat.u32 = mmio_read_32(APP_CRYPTO_INTF_LOCK_STAT);
+	if (stat.uINTF_LOCK_STAT_locked && (stat.uINTF_LOCK_STAT_mid == MID_M52))
+		return 0;
+
+	return -1;
+}
+
+int32_t appcrypto_unlock(void)
+{
+	/* Write MCS_REG_APP_CRYPTO_INTF_LOCK_CTRL.lock to 0 to release lock */
+	T32MCS_INTF_LOCK_INTF_LOCK_STAT stat;
+	T32MCS_INTF_LOCK_INTF_LOCK_CTRL ctrl;
+
+	stat.u32 = mmio_read_32(APP_CRYPTO_INTF_LOCK_STAT);
+	if (!stat.uINTF_LOCK_STAT_locked || (stat.uINTF_LOCK_STAT_mid != MID_M52))
+		return -1;
+
+	ctrl.u32 = 0;
+	mmio_write_32(APP_CRYPTO_INTF_LOCK_CTRL, ctrl.u32);
+
+	return 0;
+}
diff --git a/plat/syna/berlin/common/drivers/appcrypto/appcrypto_rng.c b/plat/syna/berlin/common/drivers/appcrypto/appcrypto_rng.c
new file mode 100644
index 0000000..86c2399
--- /dev/null
+++ b/plat/syna/berlin/common/drivers/appcrypto/appcrypto_rng.c
@@ -0,0 +1,81 @@
+/*
+ * Copyright (c) 2025, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "nexus_fw_include/nexus_trng_regs.h"
+#include "nexus_fw_include/nexus_klamath_memmap.h"
+#include <lib/mmio.h>
+#include <platform_def.h>
+
+#define BASE_ADDR_TRNG     MCU_DMA_CRYPT_REGION(START_MCU_TRNG_S)
+
+#define  ELP_SP80090C_DRBG_SEED_WIDTH                       384
+#define  pDATA_WIDTH                                        32
+#define  pSEED_DATA_WIDTH                                   (ELP_SP80090C_DRBG_SEED_WIDTH)
+#define  pNUM_SEEDx_REGISTERS                               (pSEED_DATA_WIDTH/pDATA_WIDTH)
+
+#define RNG_DEFAULT_COOKIE          (0xABADF0CC)
+#define RNG_TIMEOUT_COUNT           (1000)
+
+void appcrypto_get_random(uint8_t *data, uint32_t size)
+{
+    volatile int32_t count = 0;
+    volatile uint32_t  stat, busy, ctrl, seed, smode;
+    int i = 0;
+
+    if (data == NULL)
+        return;
+
+    /* get maximum 48B each time */
+    if (size > 48)
+		return;// STATUS_UNSUPPORTED_PARAMETER;
+
+    count = 0; stat = 0; busy = 0;
+    do {
+        stat = mmio_read_32(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_STAT);
+        busy = stat & (1U << REG_FIELD_POS__TRNG_REGS_STAT_BUSY);
+    } while ( busy && ++count < RNG_TIMEOUT_COUNT );
+
+    smode = *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_SMODE));
+    smode &= ~(1U << REG_FIELD_POS__TRNG_REGS_SMODE_MISSION_MODE);
+    *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_SMODE)) = smode;
+
+    count = 0; stat = 0; busy = 0;
+    do {
+        stat = *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_STAT));
+        busy = stat & (1U << REG_FIELD_POS__TRNG_REGS_STAT_BUSY);
+    } while ( busy && ++count < RNG_TIMEOUT_COUNT  );
+
+    ctrl = ENUM__TRNG_REGS_CTRL_CMD__GEN_NOISE << REG_FIELD_POS__TRNG_REGS_CTRL_CMD;
+    *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_CTRL)) = ctrl;
+
+    count = 0; stat = 0;
+    do {
+        stat = *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_ISTAT));
+        if (stat & (1 << REG_FIELD_POS__TRNG_REGS_ISTAT_DONE)) {
+            *((volatile uint32_t *)(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_ISTAT)) = 1 << REG_FIELD_POS__TRNG_REGS_ISTAT_DONE;
+            break;
+        }
+    } while (++count < RNG_TIMEOUT_COUNT);
+
+    count = 0;
+    for (i = 0; i < size; i++) {
+        if (!(i % 4)) {
+            count = i / 4;
+            seed = mmio_read_32(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_SEED0 + (count*4));
+            if (seed == 0)
+                return ;
+        }
+        data[i] = *((uint8_t *)(&seed) + (i % 4));
+    }
+
+    count++;
+    for (; count < 12; count++) {
+        seed = mmio_read_32(BASE_ADDR_TRNG + REG_ADDR__TRNG_REGS_SEED0 + (count*4));
+    }
+
+
+    return;
+}
