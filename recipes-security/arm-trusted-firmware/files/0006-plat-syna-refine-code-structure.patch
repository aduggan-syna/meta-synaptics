diff --git a/plat/syna/berlin/suspend/clock.c b/plat/syna/berlin/suspend/clock.c
deleted file mode 100644
index e71c0a4..0000000
--- a/plat/syna/berlin/suspend/clock.c
+++ /dev/null
@@ -1,124 +0,0 @@
-/*
- * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
- *
- * SPDX-License-Identifier: BSD-3-Clause
- */
-
-#include <string.h>
-#include <assert.h>
-#include <lib/mmio.h>
-#include "clock_regs.h"
-#include "clock.h"
-#include "avpll.h"
-
-#define BFM_HOST_Bus_Write32(offset, val)		\
-			mmio_write_32((unsigned long)offset, val)
-
-#define BFM_HOST_Bus_Read32(offset, val)		\
-			val = mmio_read_32((unsigned long)offset)
-
-
-static inline void pll_set_bypass(void *pll_base, int enable)
-{
-	unsigned int reg_val;
-
-	BFM_HOST_Bus_Read32(pll_base + RA_pll_ctrl1, reg_val);
-
-	if(enable)
-		reg_val |= MSK32pll_ctrl_BYPASS_EN;
-	else
-		reg_val &= ~MSK32pll_ctrl_BYPASS_EN;
-
-	BFM_HOST_Bus_Write32(pll_base + RA_pll_ctrl1, reg_val);
-}
-
-
-static void pll_bypass_en(clock_config_t *config)
-{
-	/* CPU PLL bypass enable */
-	pll_set_bypass(config->cpu_pll_base, 1);
-
-	/* SYS PLL bypass enable */
-	pll_set_bypass(config->sys_pll_base, 1);
-
-	/* MEM PLL bypass enable */
-	pll_set_bypass(config->mem_pll_base, 1);
-}
-
-static void pll_bypass_dis(clock_config_t *config)
-{
-	/* MEM PLL bypass disable */
-	pll_set_bypass(config->mem_pll_base, 0);
-
-	/* SYS PLL bypass disable */
-	pll_set_bypass(config->sys_pll_base, 0);
-
-	/* CPU PLL bypass disable */
-	pll_set_bypass(config->cpu_pll_base, 0);
-}
-
-static inline void pll_set_power(void *pll_base, int on)
-{
-	unsigned int reg_val;
-
-	BFM_HOST_Bus_Read32(pll_base, reg_val);
-
-	if(on)
-		reg_val |= 0x1;
-	else
-		reg_val &= ~0x1;
-
-	BFM_HOST_Bus_Write32(pll_base, reg_val);
-}
-
-static void pll_power_on(clock_config_t *config)
-{
-	/* Power on the CPU pll */
-	pll_set_power(config->cpu_pll_base, 1);
-
-	/* Power on the SYS pll */
-	pll_set_power(config->sys_pll_base, 1);
-
-	/* Power on the MEM pll */
-	pll_set_power(config->mem_pll_base, 1);
-}
-
-static void pll_power_off(clock_config_t *config)
-{
-	/* Power off the CPU pll */
-	pll_set_power(config->cpu_pll_base, 0);
-
-	/* Power off the SYS pll */
-	pll_set_power(config->sys_pll_base, 0);
-
-	/* Power off the MEM pll */
-	pll_set_power(config->mem_pll_base, 0);
-}
-
-static clock_config_t clock_config;
-
-void clock_set_config(clock_config_t *config)
-{
-	assert(config != NULL);
-
-	memcpy(&clock_config, config, sizeof(clock_config_t));
-
-	assert(clock_config.cpu_pll_base != NULL);
-	assert(clock_config.sys_pll_base != NULL);
-	assert(clock_config.mem_pll_base != NULL);
-	assert(clock_config.avpll_power_base != NULL);
-}
-
-void clock_suspend(void)
-{
-	avpll_suspend(clock_config.avpll_power_base);
-	pll_bypass_en(&clock_config);
-	pll_power_off(&clock_config);
-}
-
-void clock_resume(void)
-{
-	pll_power_on(&clock_config);
-	pll_bypass_dis(&clock_config);
-	avpll_resume(clock_config.avpll_power_base);
-}
