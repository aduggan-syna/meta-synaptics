+	//mailbox_host_tx_init(MAILBOX_REE);
+	mailbox_host_tx_init(MAILBOX_TEE);
+	mailbox_host_set_tx_mode(0);
+
+	//mailbox_h2s_get_spk_version(&version, MAILBOX_REE);
