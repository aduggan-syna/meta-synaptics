diff --git a/plat/syna/berlin/soc/klamath/clock.c b/plat/syna/berlin/soc/klamath/clock.c
new file mode 100644
index 0000000..a7c3f50
--- /dev/null
+++ b/plat/syna/berlin/soc/klamath/clock.c
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "clock.h"
+#include "klamath_memmap.h"
+
+
+#define RA_Gbl_sysPll_0 			0x0200
+#define RA_Gbl_ClkSwitch			0x0710
+
+//#define MEMMAP_CA7_REG_BASE			0xF7920000
+#define RA_CPU_WRP_PLL_REG			0x2000
+
+#define MEMMAP_AVIO_REG_BASE		0xF7400000
+#define AVIO_MEMMAP_AVIO_GBL_BASE	0x60000
+#define RA_avioGbl_SWPDWN_CTRL		0x20E8
+
+static void pll_bypass_en(clock_config_t *config)
+{
+	register unsigned int data;
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data |= 0xff;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void pll_bypass_dis(clock_config_t *config)
+{
+	register unsigned int data;
+
+	// global Pll bypass enable
+	data = mmio_read_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch);
+	data = 0;
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch, data);
+}
+
+static void pll_power_on(clock_config_t *config)
+{
+	/* Power on the SYS pll0 */
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_sysPll_0, 0x10);
+
+	/* Power on the CPU pll */
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_WRP_PLL_REG, 0x10);
+
+	/* Power on the APLL0, APLL1, VPLL0, VPLL1 */
+	mmio_write_32(MEMMAP_AVIO_REG_BASE +  AVIO_MEMMAP_AVIO_GBL_BASE+ RA_avioGbl_SWPDWN_CTRL, 0x0);
+
+}
+
+static void pll_power_off(clock_config_t *config)
+{
+	/* Power off the APLL0, APLL1, VPLL0, VPLL1 */
+	mmio_write_32(MEMMAP_AVIO_REG_BASE+  AVIO_MEMMAP_AVIO_GBL_BASE+ RA_avioGbl_SWPDWN_CTRL, 0xf);
+	/* Power off the SYS pll0 */
+	mmio_write_32(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_sysPll_0, 0x12);
+
+	/* Power off the CPU pll */
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_WRP_PLL_REG, 0x12);
+
+}
+
+static clock_config_t clock_config;
+
+void clock_set_config(clock_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&clock_config, config, sizeof(clock_config_t));
+
+	assert(clock_config.cpu_pll_base != NULL);
+	assert(clock_config.mem_pll_base != NULL);
+	assert(clock_config.sys_pll0_base != NULL);
+}
+
+void clock_suspend(void)
+{
+	pll_bypass_en(&clock_config);
+
+	pll_power_off(&clock_config);
+}
+
+void clock_resume(void)
+{
+	pll_power_on(&clock_config);
+
+	pll_bypass_dis(&clock_config);
+}
diff --git a/plat/syna/berlin/soc/klamath/mc.c b/plat/syna/berlin/soc/klamath/mc.c
new file mode 100644
index 0000000..6f3cb94
--- /dev/null
+++ b/plat/syna/berlin/soc/klamath/mc.c
@@ -0,0 +1,202 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <lib/mmio.h>
+#include "berlin_def.h"
+#include "klamath_memmap.h"
+#include "mc.h"
+#include "mc_wrap.h"
+#include "global.h"
+
+#define MEMMAP_MCTRLSS_REG_BASE		START_MCTRLSS_REG
+
+#define MEMMAP_DDR_REG_BASE 0xF7CB0000
+#define MC_REG(offset)    (*(volatile unsigned int *)(unsigned long)(MEMMAP_DDR_REG_BASE + (offset)))
+#define MAX_LOOP_COUNT 10000
+#define MEMPLL_BYPASS_ENABLE    1
+
+static inline void reset_soc(void)
+{
+	*(volatile uint32_t*)SOC_RESET_CTRL_BASE = 1;
+}
+
+static void soft_udelay(int us)
+{
+	int i;
+	for (i = 0; i < (us * 100); i++);
+}
+
+/*
+ * DDR enter self-refresh
+ * Code refers: G-Diag\DVF120\code\modules\standby\acpu_standby\source\acpu_standby_self_refresh.c
+ */
+static void ddr_enter_self_refresh(void)
+{
+	int i = 0;;
+	// 1.Program PCTRL_n.port_en = 0 – to block traffic on AXI port
+	MC_REG(0x490) = 0x0;
+	MC_REG(0x540) = 0x0;
+
+	// 2.Poll PSTAT.rd_port_busy_n = 0 and PSTAT.wr_port_busy_n = 0 – wait for AXI ports are idle
+	while (MC_REG(0x3fc) & ((0x3<<0) | (0x3<<16))) {
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	// 3.Program DBG1.dis_hif = 1 – no new command will be accepted by DDRC
+	MC_REG(0x0304) |= 0x2;
+
+	// 4.Poll DBGCAM.dbg_wr/rd_q_empty =1– to ensure that write and read data buffers are empty
+	i = 0;
+	while (((MC_REG(0x0308) >> 25) & 0x3) != 0x3){
+		soft_udelay(10);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+#if (MEMPLL_BYPASS_ENABLE == 1)
+	// for lower-down/bypass/disable mempll when SR - LP2 mode, "Set DFILPCFG0.dfi_lp_en_sr = 0, if DFILPCFG0.dfi_lp_en_sr = 1, and wait until DFISTAT.dfi_lp_ack = 0."
+	MC_REG(0x0198) &= ~(1<<8);
+	i = 0;
+	while (MC_REG(0x01bc) & (1<<1)){
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+#endif // (MEMPLL_BYPASS_ENABLE == 1)
+
+	// 5.Program PWRCTL.selfref_sw = 1 – core to enter self-refresh mode
+	MC_REG(0x0030) |= 0x20;
+
+	// 6.Wait until STAT.operation_mode[1:0] = ‘b11 – to indicate that controller is in self-refresh mode, STAT.selfref_type = ‘b10 – to make sure transition to self-refresh was due to software
+	i = 0;
+    while ((MC_REG(0x4) & ((0x3<<0) | (0x3<<4))) != ((0x3 << 0) | (0x2 << 4))) {
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	*(volatile unsigned int *)(unsigned long)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_bufferen_core) = 0x0;
+#if (MEMPLL_BYPASS_ENABLE == 1)
+	MC_REG(0x0320) &= ~(1<<0);	// Enable Quasi-Dynamic Register Programming
+	MC_REG(0x01b0) &= ~(1<<0);	// Program DFIMISC.dfi_init_complete_en = 0
+	MC_REG(0x01b0) |= (1<<5);	// Program DFIMISC.dfi_init_start = 1
+
+	// Poll DFISTAT.dfi_init_complete = 0
+	i = 0;
+	while (MC_REG(0x01bc) & (1<<0)){
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	MC_REG(0x0320) |= (1<<0);  // Disable Quasi-Dynamic Register Programming
+
+    *(volatile unsigned int*)(unsigned long)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_ctrlA) |= (1<<LSb32abipll_ctrlA_BYPASS);
+#endif // (MEMPLL_BYPASS_ENABLE == 1)
+
+
+}
+
+
+/*
+ * DDR exit self-refresh
+ */
+static void ddr_exit_self_refresh()
+{
+	int i = 0;
+
+#if (MEMPLL_BYPASS_ENABLE == 1)
+	// disable mempll bypass
+	*(volatile unsigned int*)(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch) |= (1<<LSb32Gbl_ClkSwitch_memPLLSWBypass); // sw-bypass to memfastClk
+	*(volatile unsigned int*)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_ctrlA) &= ~(1<<LSb32abipll_ctrlA_BYPASS);
+	soft_udelay(50);
+
+	while (!(*(volatile unsigned int*)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_memPll + RA_abipll_status) & (1<<0))){
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	soft_udelay(50);
+	*(volatile unsigned int*)(MEMMAP_CHIP_CTRL_REG_BASE + RA_Gbl_ClkSwitch) &= ~(1<<LSb32Gbl_ClkSwitch_memPLLSWBypass); // disable sw-bypass
+
+	MC_REG(0x0320) &= ~(1<<0);	// Enable Quasi-Dynamic Register Programming
+	MC_REG(0x01b0) &= ~(1<<0);	// Program DFIMISC.dfi_init_complete_en = 0
+	MC_REG(0x01b0) &= ~(1<<5);	 // Program DFIMISC.dfi_init_start = 0
+
+	// Poll DFISTAT.dfi_init_complete = 1
+	i = 0;
+	while (!(MC_REG(0x01bc) & (1<<0))){
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	MC_REG(0x01b0) |= (1<<0);  // Program DFIMISC.dfi_init_complete_en = 1
+	MC_REG(0x0320) |= (1<<0);  // Disable Quasi-Dynamic Register Programming
+
+	// for lower-down/bypass/disable mempll when SR - LP2 mode, "Reset DFILPCFG0.dfi_lp_en_sr = 1 if DFILPCFG0.dfi_lp_en_sr has been set to 0 in step 10."
+	MC_REG(0x0198) |= (1<<8);
+#endif // (MEMPLL_BYPASS_ENABLE == 1)
+
+    *(volatile unsigned int *)(unsigned long)(MEMMAP_MCTRLSS_REG_BASE + RA_mc_wrap_bufferen_core) = 0x1;
+	// 1.Wait at least tCKESR, perform exit self-refresh by de-asserting PWRCTL.selfref_sw = 0
+	MC_REG(0x0030) &= ~0x20;
+	// 2.Poll for STAT.oprtating_mode !=11 indicate MC core is not in self-refresh mode
+	i = 0;
+	while ((MC_REG(0x0004) & 0x3) == 0x3){
+		soft_udelay(50);
+		if (++i == MAX_LOOP_COUNT) {
+			ERROR("time out, reset soc!\n");
+			reset_soc();
+		}
+	}
+
+	// 3.Enable HIF interface by setting dis_hif = 0
+	MC_REG(0x304) &= ~0x2;
+	// 4.Program PCTRL_n.port_en = 1 – to unblock traffic on AXI port
+	MC_REG(0x490) = 0x1;
+	MC_REG(0x540) = 0x1;
+}
+
+static mem_config_t mem_config;
+
+void mem_set_config(mem_config_t *config)
+{
+	assert(config != NULL);
+
+	memcpy(&mem_config, config, sizeof(mem_config_t));
+
+	assert(mem_config.mc6_base != NULL);
+}
+
+void mem_suspend(void)
+{
+	ddr_enter_self_refresh();
+}
+
+void mem_resume(void)
+{
+	ddr_exit_self_refresh();
+}
diff --git a/plat/syna/berlin/soc/klamath/plat_pm.c b/plat/syna/berlin/soc/klamath/plat_pm.c
new file mode 100644
index 0000000..a942bfd
--- /dev/null
+++ b/plat/syna/berlin/soc/klamath/plat_pm.c
@@ -0,0 +1,299 @@
+/*
+ * Copyright (c) 2024, Synaptics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <arch.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <plat/common/platform.h>
+#include <platform_def.h>
+#include <lib/bakery_lock.h>
+#include <lib/mmio.h>
+#include <drivers/arm/gicv2.h>
+#include <string.h>
+#include <assert.h>
+#include <berlin_private.h>
+#include <drivers/delay_timer.h>
+#include "cpu_wrp.h"
+#include "klamath_memmap.h"
+#include "cpu_wrp.h"
+#include "sm.h"
+#include "soc.h"
+#include "global.h"
+#include "nexus_fw_include/mcu_cpu_ss.h"
+#include "nexus_fw_include/nexus_klamath_memmap.h"
+#include "nexus_fw_include/mcu_gbl_cfg.h"
+#include "sm_ipc.h"
+
+int berlin_set_wakeup_sources(u_register_t x1, u_register_t x2, u_register_t x3, u_register_t x4);
+#define RESET_nCPUPORESET_0    0
+
+#define PWRSW_CNTRL1_I         0
+#define PWRSW_ACK1_O           1
+#define PWRSW_CNTRL2_I         2
+#define PWRSW_ACK2_O           3
+#define PWRSW_CNTRL_MEM_I      4
+#define PWRSW_CNTRL_MEM_O      5
+#define nCPU_ISO_MODE_EN       6
+
+#define MEMMAP_CA7_REG_BASE START_ACPU_REG
+
+#define CPU_PCH(n)      (*(volatile unsigned int*)((uintptr_t)(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CPU0 + (n)*(RA_CPU_REG_CPU1-RA_CPU_REG_CPU0))))
+/*
+ void arm_set_PWRCTLR(unsigned int value);
+ */
+static void arm_set_PWRCTLR(unsigned int value)
+{
+	asm volatile("msr	S3_0_C15_C2_7, %[value]\n"
+			: : [value] "r" (value) : "memory", "cc");
+}
+
+int berlin_soc_pwr_domain_on(unsigned int target_cpu)
+{
+	unsigned int val;
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CFG);
+	val |= 1 << target_cpu;
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CFG, val);
+
+	// back to power-off manual mode before disable PMU if it is power-off by PMU
+	/* assert reset */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu);
+	val &= ~(1 << RESET_nCPUPORESET_0);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu, val);
+
+	/* turn on isolation cells, PWRSW_CNTRL1_I, PWRSW_CNTRL2_I,  PWRSW_CNTRL_MEM_I*/
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val &= ~((1 << nCPU_ISO_MODE_EN) | (1 << PWRSW_CNTRL1_I) | (1<< PWRSW_CNTRL2_I) | (1<< PWRSW_CNTRL_MEM_I));
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	// manual mode
+	// Set the PSTATE to ON but no set request and not wait ack
+	CPU_PCH(target_cpu) =  0; // write 0 to clear
+	//arm_DMB();
+	CPU_PCH(target_cpu) = (0x8 << LSb32CPU_PCH_PCH_STATE);
+
+	/* disable CPMU */
+	mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 0);
+
+	/* PWRSW_CNTRL1_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << PWRSW_CNTRL1_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	do {
+		val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+		val &= (1 << PWRSW_ACK1_O);
+	} while (!val);
+
+	udelay(10);
+
+	/* PWRSW_CNTRL2_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << PWRSW_CNTRL2_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	do {
+		val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+		val &= (1 << PWRSW_ACK2_O);
+	} while (!val);
+
+	/* PWRSW_CNTRL_MEM_I */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << PWRSW_CNTRL_MEM_I);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+
+	do {
+		val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+		val &= (1 << PWRSW_CNTRL_MEM_O);
+	} while (!val);
+
+	/* turn off isolation cells */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu);
+	val |= (1 << nCPU_ISO_MODE_EN);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_PWRSW_0 +  4*target_cpu, val);
+	udelay(100);
+
+	/* release reset */
+	val = mmio_read_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu);
+	val |= (1 << RESET_nCPUPORESET_0);
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_RESET_0 + 4*target_cpu, val);
+
+	return PSCI_E_SUCCESS;
+}
+
+/* 1.	CA-55 power down sequence (below steps are copied from A55 TRM)
+ * A4.8 Power down sequence
+ * The Cortex-A55 core uses the following power down sequence.
+ * To power down a core, perform the following programming sequence:
+ * 1.	Save all architectural state.
+ * 2.	Configure the GIC distributor to disable or reroute interrupts away from this core.
+ * 3.	Set the CPUPWRCTLR.CORE_PWRDN_EN bit to 1 to indicate to the power controller that a powerdown is requested.
+ * 4.	Execute an Instruction Synchronization Barrier (ISB) instruction.
+ * 5.	Execute a WFI instruction.
+ * After executing WFI and then receiving a powerdown request from the power controller, the hardware performs the following:
+ * • Disabling and flushing of caches (L1 and L2).
+ * • Removal of the core from coherency.
+ */
+
+int berlin_soc_pwr_domain_off(unsigned int target_cpu)
+{
+
+	unsigned int current_cpu;
+	current_cpu = plat_my_core_pos();
+
+	if (current_cpu != target_cpu) {
+		//INFO("CPU 0x%x try to Power down CPU 0x%x\n", current_cpu, target_cpu);
+
+		/* Power down by other CPU
+		 * enable CPMU, then sencondary CPUs can be powered down by CPMU
+		 * The CPU should Set the CPUPWRCTLR.CORE_PWRDN_EN bit to 1 then in WFI mode
+		 */
+		mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 1);
+
+	} else {
+	/* Power down by itself with CPMU
+	 * 1. enable PMU
+	 * 2. Set the CPUPWRCTLR.CORE_PWRDN_EN bit to 1 to indicate
+	 *    to the power controller that a powerdown is requested
+	 * 3. execute ISB instruction
+	 * 4. execute WFI instruction
+	 */
+		//mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 1);
+		arm_set_PWRCTLR(1);
+		isb();
+		//wfi();
+	}
+	return PSCI_E_SUCCESS;
+}
+
+int berlin_soc_pwr_enable_pmu(unsigned int target_cpu)
+{
+	/* enable PMU */
+	mmio_write_32(MEMMAP_CA7_REG_BASE +  RA_CPU_REG_Cpu0ExtPmu + 4*target_cpu, 1);
+
+	return PSCI_E_SUCCESS;
+}
+
+
+int berlin_soc_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
+{
+	/*
+	 * Set the CPUPWRCTLR.CORE_PWRDN_EN bit to 0
+	 * so that CPU will not be powered down after excute WFI instruction
+	 */
+	arm_set_PWRCTLR(0);
+
+	return PSCI_E_SUCCESS;
+
+}
+
+void berlin_soc_init(void)
+{
+	mmio_write_32(MEMMAP_CA7_REG_BASE + RA_CPU_REG_CFG, 0x3);
+	// GPIO, SPI, SPI, UART non-Secure access allowed
+	mmio_write_32(START_SOC_REG + RA_SOC_PERIF_PPC0_CTRL2, 0xffff);
+
+	mmio_write_32(0xf7e10420, 0xffffffff);
+	udelay(10);
+	mmio_write_32(START_PDMA_REG, 0xffffffff);
+	mmio_write_32(START_CHIP_CTRL_REG + RA_Gbl_pdma_dst_req_mask, 0xffffffff);
+	mmio_write_32(START_CHIP_CTRL_REG + RA_Gbl_pdma_src_req_mask, 0xffffffff);
+}
+
+extern unsigned char *nagra_boot_p;
+extern unsigned int suspend_entry[];
+extern unsigned int suspend_size;
+static unsigned char sram_backup[SRAM_BACKUP_SIZE];
+
+typedef void (*suspend_handler_t)(unsigned long, unsigned int, void *);
+
+
+void berlin_suspend_to_sram(unsigned long sec_entrypoint,
+				unsigned int power_state)
+{
+	suspend_handler_t suspend_func;
+
+	assert(suspend_size <= SRAM_BACKUP_SIZE);
+	/* Save the MPT sram to ddr */
+	memcpy(sram_backup, (void *)SUSPEND_SRAM_BASE, SRAM_BACKUP_SIZE);
+
+	/*
+	 * Copy code to SRAM, and jump to it later
+	 */
+	memcpy((void *)SUSPEND_SRAM_BASE,
+		(const void *)suspend_entry, suspend_size);
+
+	flush_dcache_range(SUSPEND_SRAM_BASE, suspend_size);
+
+	/*
+	 * disable the mmu before jump to sram entry, or, it will lead
+	 * to a permission fault when execute in SRAM, because of WXN and XN
+	 * bit effect.
+	 */
+	disable_mmu_el3();
+	arm_set_PWRCTLR(0);
+
+	/* Flush all caches. */
+	dcsw_op_all(DCCISW);
+
+	/* Jump to SRAM base */
+	suspend_func = (suspend_handler_t)SUSPEND_SRAM_BASE;
+	suspend_func(sec_entrypoint, power_state, nagra_boot_p);
+}
+
+void berlin_resume_from_sram(void)
+{
+	/* Restore the sram from ddr */
+
+	memcpy((void *)SUSPEND_SRAM_BASE, sram_backup, SRAM_BACKUP_SIZE);
+
+}
+
+void berlin_get_sys_suspend_power_state(psci_power_state_t *req_state)
+{
+	assert(req_state);
+
+	/* lower affinities use PLAT_MAX_OFF_STATE */
+	req_state->pwr_domain_state[MPIDR_AFFLVL0] = PLAT_MAX_OFF_STATE;
+	req_state->pwr_domain_state[MPIDR_AFFLVL1] = BERLIN_SUSPEND;
+	req_state->pwr_domain_state[MPIDR_AFFLVL2] = BERLIN_SUSPEND;
+}
+
+void __dead2 berlin_system_off(void)
+{
+	INFO("Berlin System Off .......\n");
+	sm_system_off();
+	while (1);
+	ERROR("Berlin System Off: should not be here.\n");
+	panic();
+}
+
+#if 0
+void __dead2 berlin_system_reset(void)
+{
+	INFO("Berlin System Reset ......\n");
+	sm_system_reset();
+	while (1);
+	ERROR("Berlin System reset: should not be here.\n");
+	panic();
+}
+#else
+static inline void reset_soc(void)
+{
+	unsigned int mcu_gbl_base = MCU_PERIF_REGION(START_MCU_GBL_SEC_S);
+
+	mmio_write_32(mcu_gbl_base + RA_mcu_gbl_cfg_sec_reset_trigger, 1);
+}
+
+void __dead2 berlin_system_reset(void)
+{
+	INFO("Berlin System Reset ......\n");
+	reset_soc();
+	while (1);
+	ERROR("Berlin System reset: should not be here.\n");
+	panic();
+}
+
+#endif
