+            struct w32MailboxReg_Disable;
+                 } T32MailboxReg_Disable;
+    ///////////////////////////////////////////////////////////
+
+    typedef union  TMailboxReg_S2H_ControlStatusRegister
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_S2H_ControlStatusRegister;
+                   };
+                 } TMailboxReg_S2H_ControlStatusRegister;
+    typedef union  TMailboxReg_S2H_ControlStatusRegister_Host
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_S2H_ControlStatusRegister_Host;
+                   };
+                 } TMailboxReg_S2H_ControlStatusRegister_Host;
+    typedef union  TMailboxReg_S2H_Data
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_S2H_Data;
+                   };
+                 } TMailboxReg_S2H_Data;
+    typedef union  TMailboxReg_H2S_ControlStatusRegister
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_H2S_ControlStatusRegister;
+                   };
+                 } TMailboxReg_H2S_ControlStatusRegister;
+    typedef union  TMailboxReg_H2S_ControlStatusRegister_SYNA
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_H2S_ControlStatusRegister_SYNA;
+                   };
+                 } TMailboxReg_H2S_ControlStatusRegister_SYNA;
+    typedef union  TMailboxReg_H2S_Data
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_H2S_Data;
+                   };
+                 } TMailboxReg_H2S_Data;
+    typedef union  TMailboxReg_Disable
+          { UNSG32 u32[1];
+            struct {
+            struct w32MailboxReg_Disable;
+                   };
+                 } TMailboxReg_Disable;
+
+    ///////////////////////////////////////////////////////////
+     SIGN32 MailboxReg_drvrd(SIE_MailboxReg *p, UNSG32 base, SIGN32 mem, SIGN32 tst);
+     SIGN32 MailboxReg_drvwr(SIE_MailboxReg *p, UNSG32 base, SIGN32 mem, SIGN32 tst, UNSG32 *pcmd);
+       void MailboxReg_reset(SIE_MailboxReg *p);
+     SIGN32 MailboxReg_cmp  (SIE_MailboxReg *p, SIE_MailboxReg *pie, char *pfx, void *hLOG, SIGN32 mem, SIGN32 tst);
+    #define MailboxReg_check(p,pie,pfx,hLOG) MailboxReg_cmp(p,pie,pfx,(void*)(hLOG),0,0)
+    #define MailboxReg_print(p,    pfx,hLOG) MailboxReg_cmp(p,0,  pfx,(void*)(hLOG),0,0)
+
+#endif
+//////
+/// ENDOFINTERFACE: MailboxReg
+////////////////////////////////////////////////////////////
+
+//////
+/// 
+/// $INTERFACE MB                      biu              (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 REE_Mailbox          (P)
+///     # 0x00000 REE_Mailbox          
+///               $MailboxReg          REE_Mailbox       REG          
+///     @ 0x0001C                      (W-)
+///     #         # Stuffing bytes...
+///               %% 32
+///     @ 0x00020 TEE_Mailbox          (P)
+///     # 0x00020 TEE_Mailbox          
+///               $MailboxReg          TEE_Mailbox       REG          
+///     # # ----------------------------------------------------------
+/// $ENDOFINTERFACE  # size:      60B, bits:     260b, padding:     0B
+////////////////////////////////////////////////////////////
+#ifndef h_MB
+#define h_MB (){}
+
+    #define     RA_MB_REE_Mailbox                              0x0000
+    ///////////////////////////////////////////////////////////
+    #define     RA_MB_TEE_Mailbox                              0x0020
+    ///////////////////////////////////////////////////////////
+
+    typedef struct SIE_MB {
+    ///////////////////////////////////////////////////////////
+              SIE_MailboxReg                                   ie_REE_Mailbox;
+    ///////////////////////////////////////////////////////////
+             UNSG8 RSVDx1C                                     [4];
+    ///////////////////////////////////////////////////////////
+              SIE_MailboxReg                                   ie_TEE_Mailbox;
+    ///////////////////////////////////////////////////////////
+    } SIE_MB;
+
+    ///////////////////////////////////////////////////////////
+     SIGN32 MB_drvrd(SIE_MB *p, UNSG32 base, SIGN32 mem, SIGN32 tst);
+     SIGN32 MB_drvwr(SIE_MB *p, UNSG32 base, SIGN32 mem, SIGN32 tst, UNSG32 *pcmd);
+       void MB_reset(SIE_MB *p);
+     SIGN32 MB_cmp  (SIE_MB *p, SIE_MB *pie, char *pfx, void *hLOG, SIGN32 mem, SIGN32 tst);
+    #define MB_check(p,pie,pfx,hLOG) MB_cmp(p,pie,pfx,(void*)(hLOG),0,0)
+    #define MB_print(p,    pfx,hLOG) MB_cmp(p,0,  pfx,(void*)(hLOG),0,0)
+
+#endif
+//////
+/// ENDOFINTERFACE: MB
+////////////////////////////////////////////////////////////
+
+
+
+#ifdef __cplusplus
