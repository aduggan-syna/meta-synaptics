+///     @ 0x00000 INTF_LOCK_CTRL       (RW-)
+///               %unsigned 1  lock                      0x0
+///                                    ###
+///                                    * When 0, any manager can set this to 1. Once set to 1, only the
+///                                    * manager that set this to 1 can set it back to 0 to unlock
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00004 INTF_LOCK_STAT       (R-)
+///               %unsigned 4  mid                       0x0
+///                                    ###
+///                                    * The ID of the manager that locked the interface when
+///                                    * INTF_LOCK_STAT.locked is 1.
+///                                    * If INTF_LOCK_STAT.locked is 0, the value in this field is
+///                                    * irrelevant and has no meaning.
+///                                    ###
+///               %unsigned 1  locked                    0x0
+///                                    ###
+///                                    * When set to 1, the interface is locked and only the manager with
