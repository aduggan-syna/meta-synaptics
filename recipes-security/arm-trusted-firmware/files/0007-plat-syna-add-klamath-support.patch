+/// $INTERFACE mcu_gbl_cfg_sec         biu              (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 product_id           (RNB-)
+///               ###
+///               * Product ID register
+///               ###
+///               %unsigned 32 ID                        
+///                                    ###
+///                                    * Product ID:
+///                                    * [31:28] : Revision Id (0x0)
+///                                    * [27:12] : Part Number  (0x2610 for Klamath and 0x5312 for WPD)
+///                                    * [11:1] : Manufacture Id (0x013)
+///                                    * [0] : Reserved  (0x1)
+///                                    ###
+///     @ 0x00004 rev_id               (RNB-)
+///               ###
+///               * Product ID Extension
+///               ###
+///               %unsigned 8  ID                        
+///                                    ###
+///                                    * ID extension value
+///                                    * [7:0] 0xA0
+///                                    ###
+///               %%        24         # Stuffing bits...
+///     @ 0x00008 int_id               (RNB-)
+///               ###
+///               * **INTERNAL_ONLY**
+///               * Internal ID register
+///               ###
+///               %unsigned 8  VALUE                     
+///                                    ###
+///                                    * Internal ID 0x10
+///                                    ###
+///               %%        24         # Stuffing bits...
+///     @ 0x0000C boot_strap           (R-)
+///               ###
+///               * Boot Strap Register (Read Only).  Boot straps are latched on
+///               * Power On and stored in this register.
+///               * This register can be reset only by PAD reset.
+///               * To provide software backward compatible,
+///               * Please never remove register bits even if the clock gators are
+///               * removed.
+///               * Leave a 'not used' comment if the bit field is not used in
+///               * current project.
+///               * Please always add new bit field at the end.
+///               ###
+///               %unsigned 1  boot_src0                 0x1
+///                                    ###
+///                                    * Boot Strap 0 readout
+///                                    ###
+///               %unsigned 1  boot_src1                 0x0
+///                                    ###
+///                                    * Boot STRAP1 readout
+///                                    ###
+///               %unsigned 1  pll_bypass                0x0
+///                                    ###
+///                                    * PLL Bypass Strap
+///                                    ###
+///               %unsigned 1  dft_jtag_sel              0x0
+///                                    ###
+///                                    * DFT JTAG sel in ATE/ RMA mode
+///                                    * 0: Functional JTAG
+///                                    * 1: DFT JTAG selected
+///                                    * This strap is also used to enable the DLTRe in production mode
+///                                    ###
+///               %unsigned 1  engr_en                   0x0
+///                                    ###
+///                                    * This bit indicates the status of Engineering part enable (From
+///                                    * Synaprot)
+///                                    ###
+///               %%        27         # Stuffing bits...
+///     @ 0x00010 boot_strap_en        (P)
+///               ###
+///               * Boot Strap Enable register
+///               * This register provides the option to over write the Bootstraps
+///               * using CPU register write .– Override functionality is not being
+///               * implemented currently. These are Dummy Registers
+///               ###
+///               %unsigned 1  boot_src0                 0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * boot_src[1:0]  Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap and use override values
+///                                                 ###
+///               %unsigned 1  boot_src1                 0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * boot_src[1:0]  Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap and use override values
+///                                                 ###
+///               %unsigned 1  pll_bypass                0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * PLL Bypass-  Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap and use override values
+///                                                 ###
+///               %unsigned 1  dft_jtag_sel              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * DFT JTAG Sel -  Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap and use override values
+///                                                 ###
+///               %%        28         # Stuffing bits...
+///     @ 0x00014 boot_strap_ov_val    (P)
+///               ###
+///               * Boot Strap Value register
+///               * This register provides the Values of the bootstrap values that
+///               * needs to be forced when disabling the Bootstrap Logic
+///               ###
+///               %unsigned 1  boot_src0                 0x0
+///                                    ###
+///                                    * boot_src[1:0] Value that will be overriding the boot straps
+///                                    * when disabled
+///                                    ###
+///               %unsigned 1  boot_src1                 0x0
+///                                    ###
+///                                    * boot_src[1:0] Value that will be overriding the boot straps
+///                                    * when disabled1
+///                                    ###
+///               %unsigned 1  pll_bypass                0x0
+///                                    ###
+///                                    * pll_bypass Value that will be overriding the boot straps when
+///                                    * disabled
+///                                    ###
+///               %unsigned 1  dft_jtag_sel              0x0
+///                                    ###
+///                                    * dft_jtag_sel Value that will be overriding the boot straps
+///                                    * when disabled
+///                                    ###
+///               %%        28         # Stuffing bits...
+///     @ 0x00018                      (W-)
+///     #         # Stuffing bytes...
+///               %% 320
+///     @ 0x00040 mcu_cntl             (P-)
+///               ###
+///               * Misc Chip Control bits
+///               ###
+///               %unsigned 5  DBG_SEL                   0x0
+///                                    ###
+///                                    * Debug bus selection.
+///                                    ###
+///               %unsigned 5  DBG_CLK_SEL               0x0
+///                                    ###
+///                                    * Debug Clock selection.
+///                                    ###
+///               %%        22         # Stuffing bits...
+///     @ 0x00044 mcu_status           (R-)
+///               ###
+///               * Misc Chip Status bits
+///               ###
+///               %unsigned 1  PLL_GEN_LOCK              0x0
+///                                    ###
+///                                    * Generated PLL lock
+///                                    ###
+///               %unsigned 4  XTAL_FREQ                 0x0
