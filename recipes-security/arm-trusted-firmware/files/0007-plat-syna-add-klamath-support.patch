+    ///////////////////////////////////////////////////////////
+    #define   GET32PLL_COUNTER_RESULT_PLL_COUNT(r32)           _BFGET_(r32,23, 0)
+    #define   SET32PLL_COUNTER_RESULT_PLL_COUNT(r32,v)         _BFSET_(r32,23, 0,v)
+
+    #define     w32PLL_COUNTER_RESULT                          {\
