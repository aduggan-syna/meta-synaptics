+/// 
+/// $INTERFACE Gbl                     biu              (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 ProductId            (RNB-)
+///               ###
+///               * Product ID register
+///               ###
+///               %unsigned 32 Id                        
+///                                    ###
+///                                    * Product ID:
+///                                    * [31:28] : Revision Id (0x0)
+///                                    * [27:12] : Part Number  (0x2610)
+///                                    * [11:1] : Manufacture Id (0x013)
+///                                    * [0] : Reserved  (0x1)
+///                                    ###
+///     @ 0x00004 ProductId_ext        (RNB-)
+///               ###
+///               * Product ID Extension
+///               ###
+///               %unsigned 8  ID_EXT                    
+///                                    ###
+///                                    * ID extension value
+///                                    * [7:0] 0xA0
+///                                    ###
+///               %%        24         # Stuffing bits...
+///     @ 0x00008 INT_ID               (RNB-)
+///               ###
+///               * **INTERNAL_ONLY**
+///               * Internal ID register
+///               ###
+///               %unsigned 8  VALUE                     
+///                                    ###
+///                                    * Internal ID
+///                                    ###
+///               %%        24         # Stuffing bits...
+///     @ 0x0000C bootStrap            (R-)
+///               ###
+///               * Boot Strap Register (Read Only).  Boot straps are latched on
+///               * Power On and stored in this register.
+///               * This register can be reset only by PAD reset.
+///               ###
+///               %unsigned 16 softwareStrap             
+///                                    ###
+///                                    * Straps for software usage
+///                                    * Klamath SoC only uses [3:0] bits
+///                                    ###
+///               %unsigned 2  bootSrc                   
+///                                    : ROM_BOOT_FROM_USB2        0x0
+///                                    : ROM_BOOT_FROM_XSPI        0x1
+///                                    : ROM_BOOT_FROM_EMMC        0x2
+///                                    : RESERVED                  0x3
+///                                                 ###
+///                                                 * CPU boot source
+///                                                 * 00: ROM boot from USB2
+///                                                 * 01: ROM boot from xSPI
+///                                                 * 10: ROM boot from EMMC
+///                                                 * 11: Direct boot from SPI (Only available when ENG_EN=1)
+///                                                 * Note: When direct boot from SPI (SPI clear boot), cpuRstByps
+///                                                 * should be set to 1
+///                                                 ###
+///               %unsigned 1  cpuRstByps                
+///                                    : CPU_INT_RST_BYPS          0x1
+///                                    : CPU_INT_RST_EN            0x0
+///                                                 ###
+///                                                 * CPU reset bypass strap
+///                                                 * 1: Bypass reset logic inside CPU partition
+///                                                 * 0: Enable reset logic inside CPU partition
+///                                                 ###
+///               %unsigned 1  sysPll_0Byps              
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * SYSPLL Bypass
+///                                                 * 0:  No Bypass
+///                                                 * 1:  System PLL Bypassed
+///                                                 ###
+///               %unsigned 1  sysPll_1Byps              
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * SYSPLL Bypass
+///                                                 * 0:  No Bypass
+///                                                 * 1:  System PLL Bypassed
+///                                                 ###
+///               %unsigned 1  memPllByps                
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * MEMPLL Bypass indicator
+///                                                 * 0:  No Bypass
+///                                                 * 1:  Memory PLL Bypassed
+///                                                 ###
+///               %unsigned 1  cpuPllByps                
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * CPUPLL Bypass indicator
+///                                                 * 0:  No Bypass
+///                                                 * 1:  CPUPLL Bypassed
+///                                                 ###
+///               %unsigned 1  aPll_0Byps                
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * APLL0 Bypass
+///                                                 * 0:  No Bypass
+///                                                 * 1:  APLL0 Bypassed
+///                                                 ###
+///               %unsigned 1  aPll_1Byps                
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * APLL1 Bypass
+///                                                 * 0:  No Bypass
+///                                                 * 1:  APLL1 Bypassed
+///                                                 ###
+///               %unsigned 1  vPll_1Byps                
+///                                    : PLL_OUT                   0x0
+///                                    : BYPS                      0x1
+///                                                 ###
+///                                                 * VPLL1 Bypass
+///                                                 * 0:  No Bypass
+///                                                 * 1:  VPLL1 Bypassed
+///                                                 ###
+///               %unsigned 1  ENG_EN                    
+///                                    : PRODUCTION_MODE           0x0
+///                                    : DEVELOPE_MODE             0x1
+///                                                 ###
+///                                                 * Production or development mode. This is not a boot strap bit.
+///                                                 * It's a bonding option and only read by AHB.
+///                                                 * *INTERNAL_ONLY**
+///                                                 ###
+///               %%        5          # Stuffing bits...
+///     @ 0x00010 bootStrapEn          (P)
+///               ###
+///               * Boot Strap Enable register
+///               * This register provides the option to over write the Bootstraps
+///               * using CPU register write
+///               ###
+///               %unsigned 1  cpuRstBypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * CPU Reset Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  sysPLL_0BypsEn            0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 *  System PLL0 Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  sysPLL_1BypsEn            0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * System PLL1 Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  memPLLBypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * Memory PLL Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  cpuPLLBypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * CPU PLL Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  aPLL_0BypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * APLL0 Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  aPLL_1BypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * APLL1 Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %unsigned 1  vPLL_1BypsEn              0x1
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * VPLL1 Bypass Strap Enable
+///                                                 * 1  :  Allow bootstrap
+///                                                 * 0  :  Disable bootstrap
+///                                                 ###
+///               %%        24         # Stuffing bits...
+///     @ 0x00014 wounding_mcu2soc     (R-)
+///               ###
+///               * Wounding bits from MCU Mission Control
+///               ###
+///               %unsigned 1  synpu_disable             
+///                                    ###
+///                                    * Switches off NPU clocks, applies reset, enables isolation and
+///                                    * powers down the block
+///                                    ###
+///               %unsigned 1  gpu_disable               
+///                                    ###
+///                                    * Switches off GPU clocks, applies reset, enables isolation and
+///                                    * powers down the block
+///                                    ###
+///               %unsigned 1  mipi_csi_disable          
+///                                    ###
+///                                    * Switches off MIPI CSI clocks and applies reset
+///                                    ###
+///               %unsigned 1  ca55_core1_disable        
+///                                    ###
+///                                    * Switches off A55 CORE1 clocks, applies reset, enables isolation
+///                                    * and powers down the block
+///                                    ###
+///               %unsigned 1  ge1_disable               
+///                                    ###
+///                                    * Switches off GE1 clocks and applies reset
+///                                    ###
+///               %%        27         # Stuffing bits...
+///     @ 0x00018                      (W-)
+///     #         # Stuffing bytes...
+///               %% 320
+///     @ 0x00040 chipCntl             (P-)
+///               ###
+///               * Misc Chip Control bits
+///               ###
+///               %unsigned 1  MCU_PDM_SEL               0x0
+///                                    ###
+///                                    * 0: AVIO_PDM_CLKIO
+///                                    * 1: SM_PDM_CLKIO
+///                                    ###
+///               %unsigned 1  RMII1_MASTER_MODE_SEL     0x1
+///                                    ###
+///                                    * 0: Slave mode, RMII clocks from PAD
+///                                    * 1: Master mode, RMII clocks from Global
+///                                    ###
+///               %unsigned 1  RMII2_MASTER_MODE_SEL     0x1
+///                                    ###
+///                                    * 0: Slave mode, RMII clocks from PAD
+///                                    * 1: Master mode, RMII clocks from Global
+///                                    ###
+///               %unsigned 1  DIG_CAM_ENABLE            0x0
+///                                    : ENABLE                    0x1
+///                                    : DISABLE                   0x0
+///                                                 ###
+///                                                 * 0: DIG_CAM disable 0
+///                                                 * 1: DIG_CAM enable 1
+///                                                 ###
+///               %unsigned 1  SDIO2_LPBK_CLK_EN         0x0
+///                                    ###
+///                                    * SDIO2 loopback enable
+///                                    ###
+///               %unsigned 1  SDIO2_LPBK_CLK_SEL        0x0
+///                                    ###
+///                                    * SDIO2 loopback select
+///                                    ###
+///               %%        26         # Stuffing bits...
+///     @ 0x00044 AVIO_TRIG            (P-)
+///               ###
+///               * AVIO Event Trigger Select Register
+///               ###
+///               %unsigned 6  trigger_select_0          0x0
+///                                    ###
+///                                    * Select line for 45:0 MUX
+///                                    ###
+///               %unsigned 6  trigger_select_1          0x0
+///                                    ###
+///                                    * Select line for 45:0 MUX
+///                                    ###
+///               %unsigned 6  trigger_select_2          0x0
+///                                    ###
+///                                    * Select line for 45:0 MUX
+///                                    ###
+///               %%        14         # Stuffing bits...
+///     @ 0x00048 chip_debug           (P-)
+///               ###
+///               * **INTERNAL_ONLY**
+///               * Chip Debug Select Register
+///               ###
+///               %unsigned 8  DBG_SEL                   0x0
+///                                    ###
+///                                    * 0: SYSPLL0 DIVACK, SYSPLL0 LOCK, HW PLL Lock
+///                                    * 1: perifTop debug bus[7:0]
+///                                    * 2: avio debug bus[7:0]
+///                                    ###
+///               %unsigned 8  DBG_CLK_SEL               0x0
+///                                    ###
+///                                    * 0: Digital Ref Clock
+///                                    * 1: occClkMuxOut
+///                                    * 2: APLL0 div12 clock
+///                                    * 3: APLL1 div12 clock
+///                                    * 4: VPLL1 div12 clock
+///                                    * 5: PERIF debug clock
+///                                    * 6: CPUPLL div128 clock
+///                                    * 7: MEMPLL div12 clock
+///                                    * 8: SYSPLL0 div12 clock
+///                                    * 9: SYSPLL1 div12 clock
+///                                    ###
