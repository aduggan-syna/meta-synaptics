+/// $INTERFACE MCU_CLK_MON                              (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 CTRL                 (P)
+///               ###
+///               * PLL Counter control register
+///               ###
+///               %unsigned 1  EN                        0x0
+///                                    ###
+///                                    * Enables the Clock monitor measurement
+///                                    * 0: Disable
+///                                    * 1: Enable the monitoring
+///                                    ###
+///               %unsigned 1  FAULT_INTR_EN             0x0
+///                                    ###
+///                                    * Enable generating the Interrupt from Clock Monitoring logic
+///                                    * 0: No interrupt generated
+///                                    * 1: Interrupt generated when the clock is out of bounds
+///                                    ###
+///               %unsigned 1  FAULT_RST_EN              0x0
+///                                    ###
+///                                    * Enable generating the Reset with clock monitoring Fault
+///                                    * 0: Clock monitoring fault is not generated for Fault monitor
+///                                    * block
+///                                    * 0: Clock monitoring fault is generated for Fault monitor block
+///                                    ###
+///               %%        29         # Stuffing bits...
+///     @ 0x00004 FASTCLK_ULIMIT       (P)
+///               %unsigned 16 VALUE                     0x0
+///                                    ###
+///                                    * Upper limit to detect the overflow when the XTAL clock is faster
+///                                    * than expected.
+///                                    * f the XTAL clock is faster, this ULIMIT determines on how much
+///                                    * higher the counter (Accumulation after the adjustment) can go
+///                                    * with in the CLKMON_PERIOD. This should be calculated based on
+///                                    * allowable clock range.
+///                                    ###
+///               %%        16         # Stuffing bits...
+///     @ 0x00008 SLOWCLK_LLIMIT       (P)
+///               %unsigned 16 VALUE                     0x0
+///                                    ###
+///                                    * Lower limit to detect the underflow when the XTAL clock is
+///                                    * slower than expected.
+///                                    * If the XTAL clock is slower, this LLIMIT determines on how much
+///                                    * lower the counter can go with in the CLKMON_PERIOD. This should
+///                                    * be calculated based on allowable clock range.
+///                                    ###
+///               %%        16         # Stuffing bits...
+///     @ 0x0000C FASTCLK_ADJUST       (P)
+///               %unsigned 16 VALUE                     0x0
+///                                    ###
+///                                    * How much the faster clock counter needs to adjust for every
+///                                    * measurement period
+///                                    * Example:
+///                                    * As the oscillator clock is 50Mhz x2 of XTAL expected 25MHz,
+///                                    * ideally the Adjust value should be 2x the CLKMON_PERIOD. So for
+///                                    * if the clock monitoring period is programmed to be 16, then this
+///                                    * value needs to be 32. This value can also be used for any OSC
+///                                    * clock offset adjustment.
+///                                    ###
+///               %%        16         # Stuffing bits...
+///     @ 0x00010 SLOWCLK_ADJUST       (P)
+///               %unsigned 16 VALUE                     0x0
+///                                    ###
+///                                    * How much the slower clock counter needs to adjust for every
+///                                    * measurement period
+///                                    * As the oscillator clock is 50Mhz x2 of XTAL expected 25MHz,
+///                                    * ideally the Adjust value should be 2x the CLKMON_PERIOD. So for
+///                                    * if the clock monitoring period is programmed to be 16, then this
+///                                    * value needs to be 32. This value can also be used for any OSC
+///                                    * clock offset adjustment.
+///                                    ###
+///               %%        16         # Stuffing bits...
+///     @ 0x00014 CLKMON_PERIOD        (P)
+///               %unsigned 16 VALUE                     0x0
+///                                    ###
+///                                    * Clock Monitoring period in the XTAL clock periods.
+///                                    * Ex. Program 0xF to repeat the clock monitoring measuresment for
+///                                    * every 16 clock cycles.
+///                                    ###
+///               %%        16         # Stuffing bits...
+///     @ 0x00018 STATUS               (WOC-)
+///               %unsigned 1  CLK_MON_FAULT_INTR        0x0
+///                                    ###
+///                                    * Indicates that the Clock Monitor Fault occurred.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     # # ----------------------------------------------------------
+/// $ENDOFINTERFACE  # size:      28B, bits:      84b, padding:     0B
