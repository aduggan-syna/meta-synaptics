From db94098c49de1e895b7e79a274525c093d9a6899 Mon Sep 17 00:00:00 2001
From: Shaojun Feng <Shaojun.Feng@synaptics.com>
Date: Fri, 26 Jul 2024 17:34:09 +0800
Subject: [PATCH 3/4] berlin: pm: just return if cpu idle

Change-Id: I068228978045af0baa3f83eba6b7ea6dc209fc88
Signed-off-by: Shaojun Feng <Shaojun.Feng@synaptics.com>
Reviewed-on: http://10.135.9.200:8080/4473
Reviewed-by: Jingju Hou <Jingju.Hou@synaptics.com>
---
 services/spd/opteed/opteed_pm.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/services/spd/opteed/opteed_pm.c b/services/spd/opteed/opteed_pm.c
index 719eeb7..f1c5a83 100644
--- a/services/spd/opteed/opteed_pm.c
+++ b/services/spd/opteed/opteed_pm.c
@@ -68,6 +68,10 @@ static void opteed_cpu_suspend_handler(u_register_t max_off_pwrlvl)
 	assert(optee_vector_table);
 	assert(get_optee_pstate(optee_ctx->state) == OPTEE_PSTATE_ON);
 
+	/* for cpu idle, just return*/
+	if (!max_off_pwrlvl)
+		return;
+
 	write_ctx_reg(get_gpregs_ctx(&optee_ctx->cpu_ctx), CTX_GPREG_X0,
 		      max_off_pwrlvl);
 
@@ -134,6 +138,9 @@ static void opteed_cpu_suspend_finish_handler(u_register_t max_off_pwrlvl)
 	uint32_t linear_id = plat_my_core_pos();
 	optee_context_t *optee_ctx = &opteed_sp_context[linear_id];
 
+	if (!max_off_pwrlvl)
+		return;
+
 	assert(optee_vector_table);
 	assert(get_optee_pstate(optee_ctx->state) == OPTEE_PSTATE_SUSPEND);
 
-- 
2.7.4

