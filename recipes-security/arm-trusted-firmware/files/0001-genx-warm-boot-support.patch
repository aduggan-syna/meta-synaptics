Subject: [PATCH] genx warm boot support

Change-Id: I6834615f75538b1d048669d3bde71ffa5796fcf3
Signed-off-by: Jingju Hou <Jingju.Hou@synaptics.com>
Reviewed-on: http://10.135.9.200:8080/4445
---
 bl31/aarch64/bl31_entrypoint.S | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/bl31/aarch64/bl31_entrypoint.S b/bl31/aarch64/bl31_entrypoint.S
index b0c46dc..8e2c35f 100644
--- a/bl31/aarch64/bl31_entrypoint.S
+++ b/bl31/aarch64/bl31_entrypoint.S
@@ -23,6 +23,13 @@
 	 */
 
 func bl31_entrypoint
+#if !RESET_TO_BL31
+
+	ldr w22, [x0]
+	and w22, w22, #0x1
+	cmp w22, #1
+	beq bl31_warm_entrypoint
+#endif
 	/* ---------------------------------------------------------------
 	 * Stash the previous bootloader arguments x0 - x3 for later use.
 	 * ---------------------------------------------------------------
