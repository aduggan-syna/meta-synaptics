+
+	if (!s || !sk)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	uuid = &s->ctx->uuid;
+
+	len = ROUNDUP(sizeof(struct SecureKeyParam), CACHELINE_LEN);
+	buffer = (struct SecureKeyParam *)memalign(CACHELINE_LEN, len);
+	if (buffer == NULL) {
+		EMSG("malloc fail\n");
+		return TEE_ERROR_OUT_OF_MEMORY;
+	}
+
+	/* use the TA's uuid */
+	memcpy(buffer->uuID, uuid, UUID_SIZE);
+
+	memcpy(buffer->appID, sk->appID, APPID_SIZE);
+	buffer->appVariant = sk->appVariant;
+
+	cache_operation(TEE_CACHEFLUSH, buffer, sizeof(struct SecureKeyParam));
+
+	phy_addr = virt_to_phys(buffer);
+
+	memset(&cmd, 0, sizeof(BCM_MAILBOX_COMMAND));
+
+	cmd.arg0 = (uint32_t)phy_addr;						/*phy_addr of uuID*/
+	cmd.arg1 = (uint32_t)(phy_addr + UUID_SIZE);				/*phy_addr of appID*/
+	cmd.arg2 = (uint32_t)buffer->appVariant;
+	cmd.arg3 = (uint32_t)(phy_addr + UUID_SIZE + APPID_SIZE + 4);		/*phy_addr of secureKey*/
+	cmd.command = DRM_GENERATE_SECUREKEY_V2;
+
+	result = sp_exec_cmd(&cmd, sizeof(cmd), &status, sizeof(status));
+	if (result)
+		goto out;
+
+	cache_operation(TEE_CACHEINVALIDATE, buffer, sizeof(struct SecureKeyParam));
+
+	memcpy(sk->secureKey, buffer->secureKey, APP_UNIQUE_KEY_SIZE);
+
+out:
+	if (buffer)
+		free(buffer);
+	return result;
+}
diff --git a/core/arch/arm/plat-synaptics/syscall/syscall_semaphore.c b/core/arch/arm/plat-synaptics/syscall/syscall_semaphore.c
new file mode 100644
index 0000000..47297d9
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/syscall/syscall_semaphore.c
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include <kernel/spinlock.h>
+#include <kernel/mutex.h>
+#include <malloc.h>
+#include <string.h>
+#include "svc_syna.h"
+
+#define TEE_SEMAPHORE_DEBUG		0
+#define SEMAPHORE_MAX_NUMBER_OF		64
+struct semaphore_handle {
+	unsigned int valid;
+	unsigned int lock;	/* used when operating on this struct */
+	int value;
+	int mutex_handle;
+	int num_waiters;
+};
+
+static struct semaphore_handle semaphore_handle_db[SEMAPHORE_MAX_NUMBER_OF];
+
+static unsigned int semaphore_handle_db_spin_lock =  0;
+
+
+static int semaphore_handle_db_alloc_handle(int value)
+{
+	int handle = -1, i;
+
+	for (i = 0; i < SEMAPHORE_MAX_NUMBER_OF; i++) {
+		if (semaphore_handle_db[i].valid == 0) {
+			handle = i;
+			break;
+		}
+	}
+
+	assert(handle != -1);
+	semaphore_handle_db[handle].value = value;
+	semaphore_handle_db[handle].lock = 0;
+	semaphore_handle_db[handle].num_waiters = 0;
+	syscall_syna_mutex_alloc(&semaphore_handle_db[handle].mutex_handle);
+	assert(semaphore_handle_db[handle].mutex_handle >= 0);
+	semaphore_handle_db[handle].valid = 1;
+	return handle;
+}
+
+static void semaphore_handle_db_free_handle(int handle)
+{
+
+	assert(handle < SEMAPHORE_MAX_NUMBER_OF && handle >= 0);
+	assert(semaphore_handle_db[handle].valid == 1);
+	syscall_syna_mutex_destroy(semaphore_handle_db[handle].mutex_handle);
+	semaphore_handle_db[handle].value = 0;
+	semaphore_handle_db[handle].num_waiters = 0;
+	semaphore_handle_db[handle].valid = 0;
+
+}
+
+TEE_Result syscall_syna_semaphore_alloc(int value)
+{
+	uint32_t flags;
+	uint32_t h;
+
+	flags = cpu_spin_lock_xsave(&semaphore_handle_db_spin_lock);
+
+	h = semaphore_handle_db_alloc_handle(value);
+
+	cpu_spin_unlock_xrestore(&semaphore_handle_db_spin_lock, flags);
+
+#if TEE_SEMAPHORE_DEBUG
+	struct tz_sw_task_user_info *tu = current;
+	struct tz_sw_task_context *tc;
+	tc = tz_sw_task_get(tu->task_id);
+	IMSG("task %s:%d alloc semaphore %d\n",
+			tc->name, tc->task_id, h);
+#endif
+
+	return h;
+}
+
+TEE_Result syscall_syna_semaphore_wait(int handle)
+{
+	uint32_t flags;
+	int did_sleep = 0;
+	struct semaphore_handle *sem;
+	uint32_t old_value;
+#if TEE_SEMAPHORE_DEBUG
+	struct tz_sw_task_user_info *tu = current;
+	struct tz_sw_task_context *tc;
+	tc = tz_sw_task_get(tu->task_id);
+#endif
+	assert(handle < SEMAPHORE_MAX_NUMBER_OF && handle >= 0);
+#if 0
+	if (!tz_sw_in_task_context()) {
+		EMSG("semaphore is only used in task context\n");
+		return TEE_ERROR_BAD_STATE;
+	}
+#endif
+	sem = &semaphore_handle_db[handle];
+	assert(sem->valid == 1);
+	while (true) {
+		flags = cpu_spin_lock_xsave(&sem->lock);
+
+		if (did_sleep)
+			sem->num_waiters--;
+		old_value = sem->value;
+		if (old_value > 0) {
+			sem->value--;
+		} else {
+			/*
+			 * for semaphore is 0, lock it and the lock
+			 * will always success
+			 */
+			syscall_syna_mutex_trylock(sem->mutex_handle);
+			sem->num_waiters++;
+		}
+
+		cpu_spin_unlock_xrestore(&sem->lock, flags);
+
+		if (old_value > 0) {
+#if TEE_SEMAPHORE_DEBUG
+			IMSG("task %s:%d get semaphore %d\n",
+					tc->name, tc->task_id, handle);
+
+#endif
+			return TEE_SUCCESS; /* We get the semaphore */
+		}
+
+		/*
+		 * the semaphore is <= 0, lock it and wait in normal world
+		 * for the semaphore to become available.
+		 */
+#if TEE_SEMAPHORE_DEBUG
+		IMSG("task %s:%d go to sleeping\n", tc->name, tc->task_id);
+#endif
+		did_sleep = 1;
+		if (TEE_SUCCESS != syscall_syna_mutex_lock(sem->mutex_handle)) {
+			DMSG("force to exit from waiting the sem, handle = 0x%x\n", handle);
+			return TEE_ERROR_TARGET_DEAD;
+		}
+
+	}
+}
+
+void syscall_syna_semaphore_post(int handle)
+{
+	uint32_t old_value;
+	uint32_t flags;
+	struct semaphore_handle *sem;
+#if TEE_SEMAPHORE_DEBUG
+	struct tz_sw_task_user_info *tu = current;
+	struct tz_sw_task_context *tc;
+	tc = tz_sw_task_get(tu->task_id);
+#endif
+	assert(handle < SEMAPHORE_MAX_NUMBER_OF && handle >= 0);
+
+	sem = &semaphore_handle_db[handle];
+
+	flags = cpu_spin_lock_xsave(&sem->lock);
+	old_value = sem->value;
+	sem->value++;
+	cpu_spin_unlock_xrestore(&sem->lock, flags);
+
+#if TEE_SEMAPHORE_DEBUG
+	IMSG("task %s:%d post the sem %d \n",
+				tc->name, tc->task_id, handle);
+#endif
+	if (old_value == 0 && sem->num_waiters)
+		syscall_syna_mutex_unlock(sem->mutex_handle);
+}
+
+TEE_Result syscall_syna_semaphore_trywait(int handle)
+{
+	int old_value;
+	uint32_t flags;
+	struct semaphore_handle *sem;
+
+	assert(handle < SEMAPHORE_MAX_NUMBER_OF && handle >= 0);
+	sem = &semaphore_handle_db[handle];
+	flags = cpu_spin_lock_xsave(&sem->lock);
+	old_value = sem->value;
+	if (old_value > 0) {
+		sem->value--;
+	} else {
+		/*
+		 * for semaphore is 0, lock it and the lock
+		 * will always success
+		 */
+		syscall_syna_mutex_trylock(sem->mutex_handle);
+	}
+
+	cpu_spin_unlock_xrestore(&sem->lock, flags);
+
+	return old_value > 0 ? TEE_SUCCESS : TEE_ERROR_ACCESS_CONFLICT;
+}
+
+TEE_Result syscall_syna_semaphore_timewait(int handle __unused, int time __unused)
+{
+	return TEE_ERROR_NOT_SUPPORTED;
+}
+
+void syscall_syna_semaphore_destroy(int handle)
+{
+	uint32_t flags;
+	struct semaphore_handle *sem;
+
+#if TEE_SEMAPHORE_DEBUG
+	struct tz_sw_task_user_info *tu = current;
+	struct tz_sw_task_context *tc;
+	tc = tz_sw_task_get(tu->task_id);
+	IMSG("task %s:%d destroy semaphore %d\n",
+			tc->name, tc->task_id, handle);
+#endif
+
+	assert(handle < SEMAPHORE_MAX_NUMBER_OF && handle >= 0);
+	sem = &semaphore_handle_db[handle];
+
+	if (sem->value != 0 || sem->num_waiters != 0) {
+		IMSG("someone still wait for the sem %d\n", handle);
+	}
+
+	flags = cpu_spin_lock_xsave(&semaphore_handle_db_spin_lock);
+	semaphore_handle_db_free_handle(handle);
+	cpu_spin_unlock_xrestore(&semaphore_handle_db_spin_lock, flags);
+}
