diff --git a/core/arch/arm/plat-synaptics/inc/image_gen2.h b/core/arch/arm/plat-synaptics/inc/image_gen2.h
new file mode 100644
index 0000000..75b24f3
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/inc/image_gen2.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef _IMAGE_GEN2_H_
+#define _IMAGE_GEN2_H_
+
+#define MAKE_FOURCC(ch0, ch1, ch2, ch3) \
+	((unsigned int)(char)(ch0) | ((unsigned int)(char)(ch1) << 8) | \
+	((unsigned int)(char)(ch2) << 16) | ((unsigned int)(char)(ch3) << 24))
+
+/*
+ * Generic Image Format:
+ *
+ * +----------------------------+
+ * | image_header		|
+ * +----------------------------+
+ * | chunk 0			|
+ * +----------------------------+
+ * | ...			|
+ * +----------------------------+
+ * | chunk n			|
+ * +----------------------------+
+ */
+
+#define IMAGE_HEADER_MAGIC_NUM		MAKE_FOURCC('I', 'M', '*', 'H')
+#define IMAGE_HEADER_VERSION		(0)
+
+struct image_header {
+	uint32_t header_magic_num;	/* 'IM*H' */
+	uint32_t header_size;
+	uint32_t header_version;
+	uint32_t header_reserved;
+	char     image_name[32];
+	uint32_t image_version;
+	uint32_t reserved[2];
+	uint32_t chunk_num;
+	struct {
+		uint32_t id;
+		uint32_t offset;	/* start from header, 16bytes aligned */
+		uint32_t size;
+		uint32_t attr0;		/* bit24:31 - compress method; */
+		/* data can be in (dest_start, dest_start + dest_size)
+		 * if dest_size == 0, then chunk data must always place at
+		 * dest_start.
+		 */
+		uint64_t dest_start;
+		uint32_t dest_size;
+		uint32_t attr1;		/* for compressed data, it's original_size */
+	} chunk[0];
+};
+
+/*
+ * predefined chunk ID.
+ */
+
+#define IMAGE_CHUNK_ID_BOOTLOADER		MAKE_FOURCC('B', 'T', 'L', 'R')
+#define IMAGE_CHUNK_ID_SYSTEM_MANAGER		MAKE_FOURCC('S', 'M', '*', '*')
+#define IMAGE_CHUNK_ID_UBOOT			MAKE_FOURCC('U', 'B', 'T', '*')
+
+#define IMAGE_CHUNK_ID_LINUX_BOOTIMG		MAKE_FOURCC('L', 'N', 'X', 'B')
+#define IMAGE_CHUNK_ID_LINUX_DTB		MAKE_FOURCC('L', 'D', 'T', 'B')
+
+#define IMAGE_CHUNK_ID_TZ_KERNEL		MAKE_FOURCC('T', 'Z', 'K', '*')
+#define IMAGE_CHUNK_ID_TZ_BOOT_PARAM		MAKE_FOURCC('T', 'Z', 'B', 'P')
+
+#define IMAGE_CHUNK_ID_TZ_LOADABLE_TA		MAKE_FOURCC('T', 'Z', 'T', 'A')
+
+#define IMAGE_CHUNK_ATTR_COMPRESS(attr)		((attr & 0xff000000) >> 24)
+
+
+#define IMAGE_CHUNK_ID_TZ30_LOADABLE_TA		MAKE_FOURCC('0', '3', 'A', 'T')
+#define IMAGE_CHUNK_ID_TZ30_CERT_FILE		MAKE_FOURCC('E', 'C', 'A', 'T')
+#define IMAGE_EMBEDDED_HEADER_MAGIC_NUM		MAKE_FOURCC('M', 'I', 'A', 'T')
+
+#define IMAGE_CHUNK_ID_TZ50_LOADABLE_TA		MAKE_FOURCC('0', '5', 'A', 'T')
+#define IMAGE_CHUNK_ID_TZ50_ROOT_CERT_FILE	MAKE_FOURCC('C', 'R', 'A', 'T')
+
+
+#define RSA_KEY_SIZE 		1024
+#define AES_KEY_SIZE 		16
+#define HASH_SIZE    		64
+#define CMAC_SIZE    		32
+#define SHA256_DIGEST_SIZE 	32
+#define CMAC_SIZE 		32
+#define SZ_DIGEST_SHA1 		20
+#define RSA_2K_KEY_SIZE 	256
+
+struct ta30_image_header {
+	uint32_t header_magic_num;	/* 'TA30' */
+	uint32_t header_size;
+	uint32_t ta_cert_start;
+	uint32_t ta_cert_size;
+	uint32_t ta_image_start;
+	uint32_t ta_image_size;
+	uint32_t reserved[2];
+};
+
+struct ta50_image_header {
+	uint32_t header_magic_num;	/* 'TA50' */
+	uint32_t header_size;
+	uint32_t ta_root_cert_start;
+	uint32_t ta_root_cert_size;
+	uint32_t ta_combo_image_start;
+	uint32_t ta_combo_image_size;
+	uint32_t reserved[2];
+};
+
+struct ta_cert_header {
+	uint32_t header_magic_num;	/* 'TACE' */
+	uint32_t header_size;
+	uint8_t vendor_id;
+	uint8_t vendor_name[15];
+	uint32_t cert_segid;
+	uint32_t cert_segid_mask;
+	uint32_t cert_version;
+	uint32_t cert_version_mask;
+	uint8_t ta_permission[0];
+};
+
+struct ta_embedded_header {
+	uint32_t header_magic_num;
+	uint32_t header_size;
+	uint8_t vendor_id;
+	uint8_t vendor_name[15];
+	uint32_t image_segid;
+	uint32_t image_segid_mask;
+	uint32_t image_version;
+	uint32_t image_version_mask;
+	uint8_t stuffing[20];
+	uint32_t footer_magic_num;
+};
+
+struct ta_root_cert_header {
+	uint32_t header_magic_num;		// hardcoded to "TARC"
+	uint32_t header_size;			// size from header_magic_number to
+	uint8_t stuff;
+	uint8_t vendor_name[15]; 		// like "synaptics"
+	uint8_t vendor_uuid[16];		// only highest 14 bytes are used
+	uint32_t cert_version; 		// only lowest 4 bits are effective due to
+						// size limitation of OTP field
+	uint32_t cert_version_mask;
+	uint8_t ta_all_permission[0]; 		// data block with variable size to
+						// store TA permission information
+};
+
+struct const_image_header {
+	uint32_t    header_version;    		// 0x20000000
+	uint16_t    magicnumber;      		// magic number showing this is an image
+	uint8_t     custkey_type;      		// 0: clear 1: MRVL CustKey 2: OEM custkey
+	uint8_t     code_type;         		// 0: BCM FW (EROM/BCM), 1: ARM Sys_Init,
+						// 2. Marvell A/V FW 3. ARM TZ
+						// 4:ARM Boot loader, Linux Kernel, RootFS,
+						// 5: OEM FW, 6: ARM App, 7-15:resered
+	uint8_t     security_level;    		// for BCM EROM to interprete
+	uint8_t     reserved0;        		// Signing ExtRSA Key: 0:OEM ExtRSA 1:MRVL ExtRSA
+	uint16_t    user_data;         		// User Data for google
+	uint8_t     wrappeduserkey[AES_KEY_SIZE];// custkey encrypted user key,
+	uint32_t    marketid;
+	uint32_t    marketidmask;     		// should be all '1' (0xFFFFFFFF) in default
+	uint8_t     version;
+	uint8_t     versionmask;      		// should be all '1' (0xFF) in default
+	uint8_t     headerhashsize;   		// Image Hash Type. 32 for SHA256/64 for SHA512   [fho] Should be uint16_t
+	uint16_t    imagehashsize;    		// Image Hash Type. 32 for SHA256/64 for SHA512   [fho] Should be uint32_t
+	uint32_t    imagesize;        		// image size in bytes,
+	uint8_t     imagehash[HASH_SIZE];     	// hash of the image, use [0:31] for sha256
+	uint8_t     signature[RSA_KEY_SIZE];  	// Signature of the header over all header
+						// fields, use [0:255] only for rsa2k
+};
+
+#endif /* _IMAGE_GEN2_H_ */
diff --git a/core/arch/arm/plat-synaptics/inc/image_genx.h b/core/arch/arm/plat-synaptics/inc/image_genx.h
new file mode 100644
index 0000000..92cd0b7
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/inc/image_genx.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef _IMAGE_GENX_H_
+#define _IMAGE_GENX_H_
+
+#include "types_ext.h"
+
+
+enum {
+	// RSA Keys
+	IMAGE_TYPE_K0_BOOT   = 0x01,
+	IMAGE_TYPE_K0_TEE    = 0x02,
+	IMAGE_TYPE_K0_REE    = 0x03,
+	IMAGE_TYPE_K1_BOOT_A = 0x04,
+	IMAGE_TYPE_K1_BOOT_B = 0x05,
+	IMAGE_TYPE_K1_TEE_A  = 0x06,
+	IMAGE_TYPE_K1_TEE_B  = 0x07,
+	IMAGE_TYPE_K1_TEE_C  = 0x08,
+	IMAGE_TYPE_K1_TEE_D  = 0x09,
+	IMAGE_TYPE_K1_REE_A  = 0x0A,
+	IMAGE_TYPE_K1_REE_B  = 0x0B,
+	IMAGE_TYPE_K1_REE_C  = 0x0C,
+	IMAGE_TYPE_K1_REE_D  = 0x0D,
+
+	// SCS boot images
+	IMAGE_TYPE_EROM            = 0x10,
+	IMAGE_TYPE_SCS_DATA_PARAM  = 0x11,
+	IMAGE_TYPE_BOOT_MONITOR    = 0x12,
+	IMAGE_TYPE_SYS_INIT        = 0x13,
+	IMAGE_TYPE_MINI_LOADER     = 0x14,
+
+	// Post-SCS secure images
+	IMAGE_TYPE_BCM_KERNEL          = 0x15,
+	IMAGE_TYPE_TZ_KERNEL           = 0x16,
+	IMAGE_TYPE_ATF                 = 0x17,
+	IMAGE_TYPE_TZK_BOOT_PARAMETER  = 0x18,
+	IMAGE_TYPE_TA_ROOT_CERT        = 0x19,
+	IMAGE_TYPE_TA_CERT             = 0x1A,
+	IMAGE_TYPE_TA                  = 0x1B,
+	IMAGE_TYPE_TA_CONTAINER_HEADER = 0x1C,
+
+	// ACPU OEM images
+	IMAGE_TYPE_OEM_START         = 0x20,
+	IMAGE_TYPE_BOOTLOADER        = 0x20,
+	IMAGE_TYPE_LINUX_KERNEL      = 0x21,
+	IMAGE_TYPE_TZK_OEM_SETTINGS  = 0x22,
+	IMAGE_TYPE_AVB_KEYS          = 0x23,
+	IMAGE_TYPE_LINUX             = 0x24,
+	IMAGE_TYPE_UBOOT             = 0x25,
+	IMAGE_TYPE_FASTBOOT          = 0x26,
+	IMAGE_TYPE_FAST_LOGO         = 0x27,
+	IMAGE_TYPE_OEM_END,
+
+	// Other CPU FW images
+	IMAGE_TYPE_FW_START = 0x30,
+	IMAGE_TYPE_TSP_FW = 0x30,
+	IMAGE_TYPE_DSP_FW = 0x31,
+	IMAGE_TYPE_GPU_FW = 0x32,
+	IMAGE_TYPE_NPU_FW = 0x33,
+	IMAGE_TYPE_SM_FW  = 0x34,
+	IMAGE_TYPE_FW_END,
+
+	//DIF image
+	IMAGE_TYPE_DIF = 0x40,
+
+	//ROM Keys
+	IMAGE_TYPE_ROM_ROOT_OBF_KEY = 0x50,
+
+	//DDR Phy FW images
+	IMAGE_TYPE_DDR_FW0 = 0x60,
+	IMAGE_TYPE_DDR_FW1 = 0x61,
+
+	// Runtime dynamically loaded image
+	IMAGE_TYPE_DOLBY_AUDIO = 0x70
+
+};
+
+#define TA_TYPE_NORMAL          0
+#define TA_TYPE_DOLBY_VISION    1
+#define TA_TYPE_DEBUG           0xFFFFFFFF
+
+struct ta_header {
+	uint32_t image_type;			// IMAGE_TYPE_TA, Identification of the image
+	uint32_t image_format_vesion;	// version of image format
+	uint32_t length;				// 380 - TA image length, All-inclusive length
+	uint8_t iv[16]; 				// IV for AEC-CBC
+	uint8_t checksum[32];
+	uint32_t ta_segid;				// TA_Vendor[n]_SegID
+	uint32_t ta_segid_mask;			// TA SegID mask chosen by TA owner
+	uint32_t version;				// TA_Vendor[n]_version
+	uint32_t version_mask;			// TA Version mask chosen by TA owner
+	uint32_t production_image_flag; // Whether this is a development image.
+									// 0: development image, 1: production image
+	uint32_t ta_vendor_gid; 		// vendor GID to which the root certificate is issued
+	uint32_t ta_cert_id;			// Vendor defined 4-byte value. ID of this TA certificate
+									// managed by TA vendor
+
+	uint8_t name[16];				// TA Name
+	uint8_t uuid[16];				// TA UUID
+	uint32_t ta_type;				// Synaptics defined value.
+									// 0: Generic TA, no checking OTP
+									// 1: Dolby Vision, TZK checking Dolby_Vision_Disabled OTP bit
+									// 2: Dolby Audio (reserved), TZK checking Dolby_Audio_Disabled OTP bit
+									// 3: reserved (can be expanded to cover future special cases)
+
+	uint8_t signature[256]; 		// Signature of fields with "S" in colum A
+	uint8_t data[0];				// store TA permission information,
+									// encrypted with TA vendor's TA_K0_AES key
+};
+
+struct ta_cert_header {
+	uint32_t image_type;			// IMAGE_TYPE_TA_CERT, Identification of the image
+	uint32_t image_format_vesion;	// version of image format
+	uint32_t length;				// 852, All-inclusive length
+	uint8_t iv[16]; 				// IV for AEC-CBC
+	uint8_t checksum[32];
+	uint32_t ta_segid;				// TA_Vendor[n]_SegID
+	uint32_t ta_segid_mask;			// TA SegID mask chosen by TA owner
+	uint32_t version;				// TA_Vendor[n]_version
+	uint32_t version_mask;			// TA Version mask chosen by TA owner
+	uint32_t production_image_flag; // Whether this is a development image.
+									// 0: development image, 1: production image
+
+	uint32_t ta_vendor_gid; 		// vendor GID to which the root certificate is issued
+	uint32_t ta_cert_id;			// Vendor defined 4-byte value. ID of this TA certificate
+									// managed by TA vendor
+
+	uint8_t signature[256]; 		// Signature of fields with "S" in colum A
+	uint8_t ta_k1_rsa[256]; 		// encrypted with TA vendor's TA_K0_AES key
+	uint8_t ta_k1_aes[16];			// encrypted with TA vendor's TA_K0_AES key
+	uint8_t ta_permission[0];		// store TA permission information,
+									// encrypted with TA vendor's TA_K0_AES key
+};
+
+struct ta_root_cert_header {
+	uint32_t image_type;			// IMAGE_TYPE_TA_ROOT_CERT, Identification of the image
+	uint32_t image_format_vesion;	// version of image format
+	uint32_t length;				// 612 + Lenght of TA permission structure
+	uint8_t iv[16];					// IV for AEC-CBC
+	uint8_t checksum[32];
+	uint32_t ta_segid;				// control Data
+	uint32_t ta_segid_mask;
+	uint32_t version;				// TEE Version
+	uint32_t version_mask;
+	uint32_t production_image_flag; // Whether this is a development image
+	uint32_t ta_vendor_gid;			// vendor GID to which the root certificate is issued
+	uint8_t signature[256];			// Signature of fields with "S" in colum A
+	uint8_t ta_k0_rsa[256];			// encrypted with image specific AES key derived from MDK
+	uint8_t ta_k0_aes[16];			// encrypted with image specific AES key derived from MDK
+	uint8_t ta_permission[0]; 		// store TA permission information
+};
+#endif /* _IMAGE_H_ */
diff --git a/core/arch/arm/plat-synaptics/inc/mem_region_userdata.h b/core/arch/arm/plat-synaptics/inc/mem_region_userdata.h
new file mode 100644
index 0000000..bd56a56
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/inc/mem_region_userdata.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef __MEM_REGION_USERDATA_H__
+#define __MEM_REGION_USERDATA_H__
+
+/* Warning: if you want change following MACROs, please make sure you already
+ * reviewed and updated following places at same time:
+ * 1. ion.h in OSAL: about ION_A_XX definition;
+ * 2. ion.h in kernel: about ION_A_XX definition;
+ * 3. mem_region_userdata.h in bootloader: ION_A_XX and memory region userdata
+ *                                         definition.
+ * 4. mem_region_userdata.h in tee: ION_A_XX and memory region userdata
+ *                                  definition.
+ */
+
+/* The ion memory pool attribute flag bits */
+#define ION_A_FS                0x0001      /* For secure memory */
+#define ION_A_NS                0x0002      /* For non-secure memory */
+#define ION_A_FC                0x0004      /* For cacheable memory */
+#define ION_A_NC                0x0008      /* For non-cacheable memory */
+#define ION_A_FD                0x0010      /* For dynamic memory */
+#define ION_A_ND                0x0020      /* For static memory */
+#define ION_A_CC                0x0100      /* For control (class) memory */
+#define ION_A_CV                0x0200      /* For video (class) memory */
+#define ION_A_CG                0x0400      /* For graphics (class) memory */
+#define ION_A_CO                0x0800      /* For other (class) memory */
+#define ION_A_CH                0x1000      /* For hardware (class) memory */
+
+/* Memory region user definiation that used in userdata[0] */
+#define TEE_MR_USER_TZCORE      0x00000000  /* The region is for TZ core */
+#define TEE_MR_USER_ZSP         0x01000000  /* The region is for ZSP */
+#define TEE_MR_USER_GPU         0x02000000  /* The region is for GPU */
+#define TEE_MR_USER_SI          0x03000000  /* The region is for sysinit */
+#define TEE_MR_USER_BL          0x04000000  /* The region is for bootloader */
+#define TEE_MR_USER_SYSTEM      0x05000000  /* The region is for linyx system */
+#define TEE_MR_USER_ION         0x06000000  /* The region is for ion pool */
+#define TEE_MR_USER_REGISTER    0x07000000  /* The region is for register */
+#define TEE_MR_USER_BCM         0x08000000  /* The region is for BCM */
+#define TEE_MR_USER_PT          0x09000000  /* The region is for Hardware page table*/
+
+/* MACRO funtions for userdata processing */
+#define TEE_MR_USER(mr)                 (((mr)->userdata[0] & 0xFF000000))
+#define TEE_MR_USER_IS_TZCORE(mr)       (TEE_MR_USER(mr) == TEE_MR_USER_TZCORE)
+#define TEE_MR_USER_IS_HEAP(mr)         (TEE_MR_USER(mr) == TEE_MR_USER_TZCORE)
+#define TEE_MR_USER_IS_ZSP(mr)          (TEE_MR_USER(mr) == TEE_MR_USER_ZSP)
+#define TEE_MR_USER_IS_GPU(mr)          (TEE_MR_USER(mr) == TEE_MR_USER_GPU)
+#define TEE_MR_USER_IS_SI(mr)           (TEE_MR_USER(mr) == TEE_MR_USER_SI)
+#define TEE_MR_USER_IS_BL(mr)           (TEE_MR_USER(mr) == TEE_MR_USER_BL)
+#define TEE_MR_USER_IS_SYSTEM(mr)       (TEE_MR_USER(mr) == TEE_MR_USER_SYSTEM)
+#define TEE_MR_USER_IS_ION(mr)          (TEE_MR_USER(mr) == TEE_MR_USER_ION)
+#define TEE_MR_USER_IS_REGISTER(mr)     (TEE_MR_USER(mr) == TEE_MR_USER_REGISTER)
+#define TEE_MR_USER_IS_BCM(mr)          (TEE_MR_USER(mr) == TEE_MR_USER_BCM)
+#define TEE_MR_USER_IS_PT(mr)           (TEE_MR_USER(mr) == TEE_MR_USER_PT)
+
+/* MACRO functions for ION memory region userdata processing */
+#define TEE_MR_ION_ALG(mr)              (((mr)->userdata[0] & 0x00FFFFFF))
+#define TEE_MR_ION_ATTRIB(mr)           ((mr)->userdata[1])
+
+/* MACRO functions for ION pool attributes */
+#define TEE_MR_ION_FOR_SECURE(mr)       (((mr)->userdata[1] & ION_A_FS))
+#define TEE_MR_ION_FOR_NONSECURE(mr)    (((mr)->userdata[1] & ION_A_NS))
+#define TEE_MR_ION_FOR_CACHEABLE(mr)    (((mr)->userdata[1] & ION_A_FC))
+#define TEE_MR_ION_FOR_NONCACHEABLE(mr) (((mr)->userdata[1] & ION_A_NC))
+#define TEE_MR_ION_FOR_DYNAMIC(mr)      (((mr)->userdata[1] & ION_A_FD))
+#define TEE_MR_ION_FOR_STATIC(mr)       (((mr)->userdata[1] & ION_A_ND))
+#define TEE_MR_ION_FOR_CONTROL(mr)      (((mr)->userdata[1] & ION_A_CC))
+#define TEE_MR_ION_FOR_VIDEO(mr)        (((mr)->userdata[1] & ION_A_CV))
+#define TEE_MR_ION_FOR_GRAPHICS(mr)     (((mr)->userdata[1] & ION_A_CG))
+#define TEE_MR_ION_FOR_OTHER(mr)        (((mr)->userdata[1] & ION_A_CO))
+
+/* Memory zone setting master definition that used in userdata[3] */
+#define TEE_ZONE_ACPU  0x0
+#define TEE_ZONE_BCM   0x1
+#define TEE_ZONE_RSV   0x2
+
+#define TEE_MR_ACPU_ZONE(mr)        (((mr)->userdata[3] == TEE_ZONE_ACPU))
+#define TEE_MR_RSV_ZONE(mr)        (((mr)->userdata[3] == TEE_ZONE_RSV))
+
+#endif	/* __MEM_REGION_USERDATA_H__ */
+
