+/// $INTERFACE NAGRA_CERT_OLD                           (4,4)
+///     ###
+///     * This region is only accessible to AKL except slot_0_lock. It’s
+///     * writeable through AHB bus.
+///     * Entire register is open for R/W at eng_en chip
+///     ###
+///     # # ----------------------------------------------------------
+///     @ 0x00000 Slot_0               (RW-)
+///               %unsigned 1  Slot_0                    0x0
+///                                    ###
+///                                    * Slot 0 is 384-bit
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00004                      (W-)
+///     #         # Stuffing bytes...
+///               %% 352
+///     @ 0x00030 Slot_1               (RW-)
+///               %unsigned 1  Slot_1                    0x0
+///                                    ###
+///                                    * Slot 1 is 384-bit
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00034                      (W-)
+///     #         # Stuffing bytes...
