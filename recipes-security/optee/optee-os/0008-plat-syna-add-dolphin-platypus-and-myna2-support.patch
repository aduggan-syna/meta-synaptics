+#define RULE_M_ID		(0xff000000)
+#define RULE_M_MST		(0x00ff0000)
+#define RULE_M_PERM		(0x000000ff)
+#define RULE_S_ID		(24)
+#define RULE_S_MST		(16)
+#define RULE_S_PERM		(0)
+
+#define RULE_GET_ID(attr)			(((attr) & RULE_M_ID) >> RULE_S_ID)
