+int umem_add_memory_access(uint32_t mem_id, const TEE_UUID *uuid,
+				void *sa __unused, uint32_t permission, int force __unused)
+{
+	int ret = TEE_ERROR_GENERIC;
+	struct umem *um = NULL;
+	struct umem_ta_perm *taperm = NULL;
+//	uint32_t thisperm = 0;
+
+	um = umem_find(mem_id);
