+};
+
+enum {
+	OTP_ANTI_ROLLBACK =		1,
+	OTP_SEGMENT_ID =		2,
+	TSSS_FASTCALL_CMD =		3,
+	RPMB_FASTCALL_CMD =		4,
+	GENRIC_FASTCALL_MEMMOVE = 5,
+	GENRIC_FASTCALL_CACH_OP = 6,
+};
