+///                                    ###
+///                                    * tRP-1
+///                                    ###
+///               %unsigned 4  init_trrd                 0x3
+///                                    ###
+///                                    * tRRD-1
+///                                    ###
+///               %unsigned 4  init_trcd                 0x4
+///                                    ###
+///                                    * tRCD-1
+///                                    ###
