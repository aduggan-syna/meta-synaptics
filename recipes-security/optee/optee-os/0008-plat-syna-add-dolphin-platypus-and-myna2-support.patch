diff --git a/core/arch/arm/plat-synaptics/syscall/syna_scall_a64.S b/core/arch/arm/plat-synaptics/syscall/syna_scall_a64.S
new file mode 100644
index 0000000..a45abf3
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/syscall/syna_scall_a64.S
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (c) 2015, Linaro Limited
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include "tee_syscall_numbers.h"
+#include "trace_levels.h"
+#include <arm64.h>
+#include <arm64_macros.S>
+#include <asm.S>
+#include <generated/asm-defines.h>
+#include <kernel/thread.h>
+#include <tee_api_defines.h>
+
+#define SC_REC_X0		(8 * 0)
+#define SC_REC_X1		(8 * 1)
+#define SC_REC_X19		(8 * 2)
+#define SC_REC_X30		(8 * 3)
+#define SC_REC_SIZE		(SC_REC_X30 + 8)
+
+/*
+ * uint32_t syna_scall_do_call(struct thread_scall_regs *regs, syscall_t func);
+ *
+ * Called from syscall_syna_entry()
+ */
+FUNC syna_scall_do_call , :
+	sub	sp, sp, #SC_REC_SIZE
+	stp	x0, x1, [sp, #SC_REC_X0]
+	stp	x19, x30, [sp, #SC_REC_X19]
+	mov	x19, sp
+
+	/* Load the first 8 arguments to function */
+	ldr	x9, [x19, #SC_REC_X0]
+	load_xregs x9, THREAD_SCALL_REG_X0, 0, 8
+
+	/* Call the syscall function */
+	ldr	x16, [x19, #SC_REC_X1]
+	blr	x16
+
+	mov	sp, x19
+	ldp	x19, x30, [sp, #SC_REC_X19]
+	add	sp, sp, #SC_REC_SIZE
+	ret
+END_FUNC syna_scall_do_call
+
+BTI(emit_aarch64_feature_1_and     GNU_PROPERTY_AARCH64_FEATURE_1_BTI)
diff --git a/core/arch/arm/plat-synaptics/syscall/syscall_globaldata.c b/core/arch/arm/plat-synaptics/syscall/syscall_globaldata.c
new file mode 100644
index 0000000..adbd2d1
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/syscall/syscall_globaldata.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include <sys/queue.h>
+#include <kernel/ts_manager.h>
+#include <tee_api_types.h>
+#include <kernel/mutex.h>
+#include <malloc.h>
+#include <string.h>
+#include "svc_syna.h"
+
+struct globaldata_list {
+	TAILQ_ENTRY(globaldata_list) link;	/* global data list */
+	TEE_UUID uuid;
+	uint32_t key;
+	uint32_t value;
+};
+
+static TAILQ_HEAD(globaldata_lists, globaldata_list) globaldata_lists=
+			TAILQ_HEAD_INITIALIZER(globaldata_lists);
+
+static struct mutex gd_mutex = MUTEX_INITIALIZER;
+
+TEE_Result syscall_syna_set_globaldata(uint32_t key, uint32_t value)
+{
+	struct globaldata_list *o, *obj = NULL;
+	struct ts_session *s = ts_get_current_session();
+	const TEE_UUID *uuid = &s->ctx->uuid;
+
+	mutex_lock(&gd_mutex);
+
+	/* Check if key is already existed*/
+	TAILQ_FOREACH(o, &globaldata_lists, link) {
+		if ((key == o->key) &&
+			(memcmp(uuid, &o->uuid, sizeof(TEE_UUID)) == 0)) {
+			obj = o;
+			break;
+		}
+	}
+	mutex_unlock(&gd_mutex);
+
+	if (obj) {
+		obj->value = value;
+		return TEE_SUCCESS;
+	}
+
+	/* new global data */
+	o = malloc(sizeof(struct globaldata_list));
+	if (o == NULL)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	memset(o, 0, sizeof(struct globaldata_list));
+	memcpy(&o->uuid, uuid, sizeof(TEE_UUID));
+	o->key = key;
+	o->value = value;
+
+	mutex_lock(&gd_mutex);
+	TAILQ_INSERT_TAIL(&globaldata_lists, o, link);
+	mutex_unlock(&gd_mutex);
+	return TEE_SUCCESS;
+
+}
+
+TEE_Result syscall_syna_get_globaldata(uint32_t key, uint32_t *value)
+{
+	struct globaldata_list *o, *obj = NULL;
+	struct ts_session *s = ts_get_current_session();
+	const TEE_UUID *uuid = &s->ctx->uuid;
+
+#if 0
+	if (!virt_in_usr(value, sizeof(*value))) {
+		error("value can't exceed user space\n");
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+#endif
+
+	mutex_lock(&gd_mutex);
+	TAILQ_FOREACH(o, &globaldata_lists, link) {
+		if ((key == o->key) &&
+			(memcmp(uuid, &o->uuid, sizeof(TEE_UUID)) == 0)) {
+			obj = o;
+			break;
+		}
+	}
+	mutex_unlock(&gd_mutex);
+
+	if (obj) {
+		*value = obj->value;
+		return TEE_SUCCESS;
+	}
+	return TEE_ERROR_ITEM_NOT_FOUND;
+}
diff --git a/core/arch/arm/plat-synaptics/syscall/syscall_mutex.c b/core/arch/arm/plat-synaptics/syscall/syscall_mutex.c
new file mode 100644
index 0000000..33bc9ea
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/syscall/syscall_mutex.c
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+ 
+#include <kernel/spinlock.h>
+#include <kernel/mutex.h>
+#include <malloc.h>
+#include <string.h>
+#include "svc_syna.h"
+
+#ifndef MUTEX_MAX_NUMBER_OF
+#define MUTEX_MAX_NUMBER_OF		128
+#endif
+
+typedef struct {
+	struct mutex mutex;
+	int32_t task_id;	/* hold by whom */
+	unsigned int lock;	/* used when operating on this struct */
+	int handle;		/* identifier of mutex passed to linux driver */
+} TEE_Mutex;
+
+struct mutex_handle {
+	unsigned int valid;
+	void *lock;
+};
+
+#define START_MUTEX_HANDLE (0x1000)  //give a start offset to avoid uninitialized input of syscall_mutex_alloc
+#define END_MUTEX_HANDLE (START_MUTEX_HANDLE + 128)
+#define IS_VALID_HMUTEX(h) ((h >= START_MUTEX_HANDLE) && (h < END_MUTEX_HANDLE))
+#define HMUTEX_INDEX2ID(i) (i + START_MUTEX_HANDLE)
+#define HMUTEX_ID2INDEX(h) (h - START_MUTEX_HANDLE)
+
+static struct mutex_handle mutex_handle_db[MUTEX_MAX_NUMBER_OF];
+
+static unsigned int mutex_handle_db_spin_lock = 0;
+
+
+static int mutex_handle_db_alloc_handle(void)
+{
+	int index = -1, i;
+	TEE_Mutex *m;
+
+	for (i = 0; i < MUTEX_MAX_NUMBER_OF; i++) {
+		if (mutex_handle_db[i].valid == 0) {
+			index = i;
+			break;
+		}
+	}
+
+	assert(index != -1);
+	mutex_handle_db[index].valid = 1;
+	mutex_handle_db[index].lock = (void *)malloc(sizeof(TEE_Mutex));
+	assert(mutex_handle_db[index].lock != 0);
+
+	m = (TEE_Mutex *)mutex_handle_db[index].lock;
+	m->handle = HMUTEX_INDEX2ID(index);
+	m->task_id = -1;
+	m->lock = 0;
+	mutex_init(&m->mutex);
+	return HMUTEX_INDEX2ID(index);
+}
+
+static void *mutex_handle_db_get_mutex(int handle)
+{
+	int index = HMUTEX_ID2INDEX(handle);
+	assert(index < MUTEX_MAX_NUMBER_OF && index >= 0);
+	assert(mutex_handle_db[index].lock != 0);
+	assert(mutex_handle_db[index].valid == 1);
+
+	return mutex_handle_db[index].lock;
+
+}
+static void mutex_handle_db_free_handle(int handle)
+{
+	int index = HMUTEX_ID2INDEX(handle);
+	assert(index < MUTEX_MAX_NUMBER_OF && index >= 0);
+	assert(mutex_handle_db[index].lock != 0);
+	assert(mutex_handle_db[index].valid == 1);
+
+	free(mutex_handle_db[index].lock);
+	mutex_handle_db[index].valid = 0;
+	mutex_handle_db[index].lock = 0;
+
+}
+
+TEE_Result syscall_syna_mutex_alloc(int *h)
+{
+	uint32_t flags;
+
+	flags = cpu_spin_lock_xsave(&mutex_handle_db_spin_lock);
+
+	//check if it is already allocated
+	if (IS_VALID_HMUTEX(*h))
+		//it doesn't mean error. it mean h is already allocated
+		goto allocated;
+
+	/*not check return value for it will assert if there is no valid slot*/
+	*h = mutex_handle_db_alloc_handle();
+
+allocated:
+	cpu_spin_unlock_xrestore(&mutex_handle_db_spin_lock, flags);
+
+	return TEE_SUCCESS;
+}
+
+TEE_Result syscall_syna_mutex_lock(int handle)
+{
+	TEE_Mutex *m;
+
+	m = (TEE_Mutex *)mutex_handle_db_get_mutex(handle);
+	assert(m->handle == handle);
+
+	mutex_lock(&m->mutex);
+	return TEE_SUCCESS;
+}
+
+void syscall_syna_mutex_unlock(int handle)
+{
+	TEE_Mutex *m;
+
+	m = (TEE_Mutex *)mutex_handle_db_get_mutex(handle);
+	assert(m->handle == handle);
+
+	mutex_unlock(&m->mutex);
+}
+
+bool syscall_syna_mutex_trylock(int handle)
+{
+	TEE_Mutex *m;
+
+	m = (TEE_Mutex *)mutex_handle_db_get_mutex(handle);
+	assert(m->handle == handle);
+
+	return mutex_trylock(&m->mutex);
+}
+
+
+void syscall_syna_mutex_destroy(int handle)
+{
+	TEE_Mutex *m;
+
+	m = (TEE_Mutex *)mutex_handle_db_get_mutex(handle);
+	assert(m->handle == handle);
+
+	mutex_destroy(&m->mutex);
+	
+	mutex_handle_db_free_handle(handle);
+}
diff --git a/core/arch/arm/plat-synaptics/syscall/syscall_sa.c b/core/arch/arm/plat-synaptics/syscall/syscall_sa.c
