diff --git a/core/arch/arm/plat-synaptics/common/tz_list.h b/core/arch/arm/plat-synaptics/common/tz_list.h
new file mode 100644
index 0000000..f951d33
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/common/tz_list.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef _TZ_LIST_H_
+#define _TZ_LIST_H_
+
+#include "stdint.h"
+#include "stdbool.h"
+
+typedef struct tz_list
+{
+    struct tz_list *next;
+    struct tz_list *prev;
+} tz_list_t;
+
+#define TZ_LIST(head) \
+    struct tz_list head = { &(head), &(head) }
+
+#define TZ_LIST_HEAD(head) { &(head), &(head) }
+
+static inline void tz_list_init_head(struct tz_list *head)
+{
+    head->next = head;
+    head->prev = head;
+}
+
+static inline void tz_list_add(struct tz_list *entry, struct tz_list *head)
+{
+    entry->next = head->next;
+    entry->prev = head;
+    head->next->prev = entry;
+    head->next = entry;
+}
+
+static inline void tz_list_add_tail(struct tz_list *entry, struct tz_list *head)
+{
+    entry->next = head;
+    entry->prev = head->prev;
+    head->prev->next = entry;
+    head->prev = entry;
+}
+
+static inline void tz_list_del(struct tz_list *entry)
+{
+    entry->prev->next = entry->next;
+    entry->next->prev = entry->prev;
+}
+
+static inline bool tz_list_empty(struct tz_list *head)
+{
+    return ((head->next == head) && (head->prev == head));
+}
+
+static inline struct tz_list *tz_list_get_next(struct tz_list *head)
+{
+    return head->next;
+}
+
+static inline struct tz_list *tz_list_get_prev(struct tz_list *head)
+{
+    return head->prev;
+}
+
+#define tz_list_iterate(head, entry) \
+    for ((entry) = (head)->next; (entry) != (head); (entry) = (entry)->next)
+
+#define tz_list_iterate_safe(head, entry, n) \
+    for (entry = (head)->next, n = entry->next; entry != (head); \
+         entry = n, n = entry->next)
+
+#endif /*_TZ_LIST_H_*/
diff --git a/core/arch/arm/plat-synaptics/common/tz_umem_mgr.c b/core/arch/arm/plat-synaptics/common/tz_umem_mgr.c
new file mode 100644
index 0000000..63ecc7a
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/common/tz_umem_mgr.c
@@ -0,0 +1,1284 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include "config.h"
+#include <string.h>
+#include <malloc.h>
+#include "tz_granule_table.h"
+#include "mr_setup.h"
+#include "mem_region_userdata.h"
+#include "tz_umem_mgr.h"
+#include "addr_range_check.h"
+#include "syna_setup.h"
+#include <kernel/mutex.h>
+#include <tee_api_defines.h>
+#include <tee_api_types.h>
+#include <trace.h>
+#include <mm/mobj.h>
+#include <mm/vm.h>
+#include <kernel/tee_ta_manager.h>
+#include <initcall.h>
+#include <kernel/tee_misc.h>
+#include <tee/entry_std.h>
+
+
+/* unified memory management */
+
+/* use array in order to find the entry quickly */
+#define MAXNUM_UMEM (1024)
+static struct umem *umem_list[MAXNUM_UMEM];
+static int umem_cnt;
+static struct mutex h;
+
+#define SHM_ID(x) (x | UMEM_SHAREDMEMORY)
+#define SMM_MPT_ID(x) (x | UMEM_DYNAMIC_SA)
+#define SMM_CON_ID(x) (x | UMEM_FIXED_SA)
+#define ID_2_INDEX(x) (x & (MAXNUM_UMEM - 1))
+
+#define WRONG_MMU_ATTRIBUTE (0xFFFF)
+
+#define TA_DEBUG_UUID	{0x1316a183, 0x894d, 0x43fe,\
+			{0x98, 0x93, 0xbb, 0x94, 0x6a, 0xe1, 0x04, 0x23}}
+
+/* TA whose UUID is in whitelist can access memory freely */
+static const TEE_UUID UMEM_ACCESS_WHITELIST[] = {TA_DEBUG_UUID};
+
+/* find a valid umem id */
+static int umem_next_id(uint32_t type, int *mem_id)
+{
+	int umid = 0;
+	int idx = 0;
+	bool found = false;
+
+	if (!mem_id)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	for (idx = 0; idx < MAXNUM_UMEM; idx++) {
+		if (umem_list[idx] == NULL) {
+			found = true;
+			break;
+		}
+	}
+
+	/* must find a slot, otherwise increase the array */
+	if(found != true)
+		return TEE_ERROR_ITEM_NOT_FOUND;
+
+	switch (type) {
+	default:
+		umid = idx;
+		break;
+	case UMEM_SHAREDMEMORY:
+		umid = SHM_ID(idx);
+		break;
+	case UMEM_DYNAMIC_SA:
+		umid = SMM_MPT_ID(idx);
+		break;
+	case UMEM_FIXED_SA:
+		umid = SMM_CON_ID(idx);
+		break;
+	}
+
+	*mem_id = umid;
+
+	return TEE_SUCCESS;
+}
+
+static struct umem *umem_find(int umid)
+{
+	return umem_list[ID_2_INDEX(umid)];
+}
+
+static void print_uuid(const TEE_UUID *uuid)
+{
+	DMSG("%08x-%04x-%04x-%02x%02x%02x%02x%02x%02x%02x%02x\n", uuid->timeLow,
+		uuid->timeMid, uuid->timeHiAndVersion,
+		uuid->clockSeqAndNode[0],
+		uuid->clockSeqAndNode[1],
+		uuid->clockSeqAndNode[2],
+		uuid->clockSeqAndNode[3],
+		uuid->clockSeqAndNode[4],
+		uuid->clockSeqAndNode[5],
+		uuid->clockSeqAndNode[6],
+		uuid->clockSeqAndNode[7]);
+}
+
+static struct umem_ta_perm *umem_find_perm(struct umem *um, const TEE_UUID *uuid)
+{
+	struct umem_ta_perm *taperm = NULL;
+	bool found = false;
+
+	LIST_FOREACH(taperm, &um->perm, list) {
+		print_uuid((TEE_UUID *)uuid);
+		print_uuid(&taperm->uuid);
+		if (memcmp(uuid, &taperm->uuid, sizeof(TEE_UUID)) == 0) {
+			found = true;
+			break;
+		}
+	}
+
+	return found ? taperm : NULL;
+}
+
+#if 0
+static struct umem_user *umem_find_user(struct umem *um, uint32_t task_id)
+{
+	struct umem_user *user = NULL;
+
+	LIST_FOREACH(user, &um->user, list) {
+		if (task_id == user->task_id)
+			break;
+	}
+
+	return user;
+}
+
+static int umem_map_pa_2_va(struct tz_sw_task_context *tc, scatter_list_t *s_list,
+						void *va, uint32_t mt)
+{
+	int i = 0;
+	uint32_t pa = 0, size = 0;
+
+	for (i = 0; i < s_list->num; i++) {
+		pa = s_list->s_item[i].addr;
+		size = s_list->s_item[i].npage * SMALL_PAGE_SIZE;
+		mm_map(&tc->mm, (void *)pa, va, size, mt);
+		va += size;
+	}
+
+	return 0;
+}
+#endif
+static void umem_free_taperm_list(struct umem *um)
+{
+	struct umem_ta_perm *taperm = LIST_FIRST(&um->perm);
+
+	while (taperm) {
+		LIST_REMOVE(taperm, list);
+		free(taperm);
+		taperm = LIST_FIRST(&um->perm);
+	}
+}
+
+static void umem_dump_slist(scatter_list_t *s_list)
+{
+	uint32_t i = 0;
+	DMSG("#  scatter num = %d\n", s_list->num);
+	for (i = 0; i < s_list->num; i++)
+		DMSG("#  %x, %d\n", s_list->s_item[i].addr, s_list->s_item[i].npage);
+}
+
+static void umem_dump_user(struct umem_user *user __unused)
+{
+	//DMSG("#TA %s    %d\n", tz_sw_task_name(user->task_id), user->task_id);
+}
+
+static void umem_dump_perm(const struct umem_ta_perm *taperm)
+{
+	DMSG("#    %08x-%04x-%04x-%02x%02x%02x%02x%02x%02x%02x%02x: 0x%x\n",
+		taperm->uuid.timeLow,
+		taperm->uuid.timeMid,
+		taperm->uuid.timeHiAndVersion,
+		taperm->uuid.clockSeqAndNode[0],
+		taperm->uuid.clockSeqAndNode[1],
+		taperm->uuid.clockSeqAndNode[2],
+		taperm->uuid.clockSeqAndNode[3],
+		taperm->uuid.clockSeqAndNode[4],
+		taperm->uuid.clockSeqAndNode[5],
+		taperm->uuid.clockSeqAndNode[6],
+		taperm->uuid.clockSeqAndNode[7],
+		taperm->perm);
+}
+
+static void umem_dump_umem(const struct umem *um)
+{
+	struct umem_ta_perm *taperm = NULL;
+	struct umem_user *user = NULL;
+
+	DMSG("#mem_id = %x\n", um->umid);
+	DMSG("#type = %x\n", um->type);
+	DMSG("#size = %lx\n", um->size);
+	DMSG("#refcnt = %x\n", um->refcnt);
+	DMSG("#va = %lx\n", um->vm_start);
+	DMSG("#mt = %x\n", um->mt);
+	DMSG("#rule = %x\n", um->rule);
+	umem_dump_slist(um->s_list);
+
+	LIST_FOREACH(taperm, &um->perm, list)
+		umem_dump_perm(taperm);
+
+	LIST_FOREACH(user, &um->user, list)
+		umem_dump_user(user);
+}
+
+void umem_dump(void)
+{
+	int i = 0;
+
+	DMSG("###total %d\n", umem_cnt);
+
+	for (i = 0; i < MAXNUM_UMEM; i++) {
+		if (umem_list[i])
+			umem_dump_umem(umem_list[i]);
+	}
+}
+
+struct umem *umem_find_by_address(void *addr, size_t size)
+{
+	int i = 0;
+	struct umem *um = NULL;
+
+	for (i = 0; i < MAXNUM_UMEM; i++) {
+		um = umem_list[i];
+		if (um && ADDR_REGION_IN_RANGE((uintptr_t)addr, size, (uintptr_t)um->vm_start, um->size))
+			break;
+	}
+
+	return um;
+}
