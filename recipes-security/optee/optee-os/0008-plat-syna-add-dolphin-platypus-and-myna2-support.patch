+int umem_refcnt_op(uint32_t mem_id, uint32_t type, uint32_t *refc)
+{
+	int ret = TEE_ERROR_GENERIC;
+	struct umem *um = NULL;
+
+	um = umem_find(mem_id);
+	if (!um) {
+		EMSG("can't find the mem_id 0x%x\n", mem_id);
+		return TEE_ERROR_BAD_PARAMETERS;
+	}
+
+	switch (type) {
+	case UMEM_REFC_VALUE:
+		*refc = um->refcnt;
+		ret = TEE_SUCCESS;
+		break;
+	case UMEM_REFC_INC:
+		ret = umem_refcnt_inc(um);
+		break;
+	case UMEM_REFC_DEC:
+		ret = umem_refcnt_dec(um);
+		break;
+	default:
+		EMSG("Unsupported type 0x%x.\n", type);
+		return TEE_ERROR_BAD_PARAMETERS;
+	};
