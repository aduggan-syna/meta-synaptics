+            UNSG32 usetting_enable                             :  1;\
+            UNSG32 RSVDx0_b21                                  : 11;\
+          }
+    union { UNSG32 u32seSetting_setting;
+            struct w32seSetting_setting;
+          };
+    ///////////////////////////////////////////////////////////
+    } SIE_seSetting;
