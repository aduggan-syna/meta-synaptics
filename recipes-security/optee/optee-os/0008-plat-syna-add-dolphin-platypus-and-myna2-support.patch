diff --git a/core/arch/arm/plat-synaptics/tz/tz_boot_cmd.h b/core/arch/arm/plat-synaptics/tz/tz_boot_cmd.h
new file mode 100644
index 0000000..e89c378
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/tz/tz_boot_cmd.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef _TZ_BOOT_CMD_H_
+#define _TZ_BOOT_CMD_H_
+
+#define SMC_FUNC_TOS_BOOT_START		(0xbf000000)
+#define TOS_BOOT(number)		(SMC_FUNC_TOS_BOOT_START + (number))
+
+enum tz_boot_func_id {
+	/* param: none;
+	 * return: version number */
