+///               ###
+///               %unsigned 1  ClkEn                     0x1
+///                                    : enable                    0x1
+///                                    : disable                   0x0
+///                                                 ###
+///                                                 * Clock enable register
+///                                                 * 0: Disable
+///                                                 * 1: Enable   (default)
+///                                                 ###
+///               %unsigned 3  ClkPllSel                 0x4
+///                                    : CLKSRC0                   0x0
