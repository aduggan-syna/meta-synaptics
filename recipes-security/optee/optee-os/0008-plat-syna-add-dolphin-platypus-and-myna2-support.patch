+	uint32_t arg10;
+	uint32_t arg11;
+	uint32_t arg12;
+	uint32_t arg13;
+	uint32_t arg14;
+	uint32_t arg15;
+} BCM_MAILBOX_STATUS;
+
+// the command mailbox structure, which appears in the Client's memory space
+typedef struct
+{
