+///                                    ###
+///               %%        28         # Stuffing bits...
+///     @ 0x00010                      (W-)
+///     #         # Stuffing bytes...
+///               %% 384
+///     @ 0x00040 figoDbgRF16          (RW-)
+///               ###
+///               * BIU access to RF16
+///               ###
+///     # 0x00040 rf16                 
+///               $FigoMem16           rf16              MEM      [16]
+///                                    ###
+///                                    * Register mapping
+///                                    * x0 = {d0,c0,b0,a0} = MEM[3:0]
+///                                    * x1 = {d1,c1,b1,a1} = MEM[7:4]
+///                                    * x2 = {d2,c2,b2,a2} = MEM[11:8]
+///                                    * x3 = {d3,c3,b3,a3} = MEM[15:12]
+///                                    ###
+///     @ 0x00080 figoDbgRB            (RW-)
+///               ###
+///               * BIU access to RB register
+///               ###
+///               %unsigned 16 rb                        0x0
