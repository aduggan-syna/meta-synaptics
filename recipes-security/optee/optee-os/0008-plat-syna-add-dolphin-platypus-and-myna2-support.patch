+unsigned long plat_mr_region_get_va(const struct mem_region *mr)
+{
+	if (strncmp(mr->name, "tz", 2) == 0)
+#ifdef CONFIG_ENABLE_PIE
+		return (unsigned long)(mmu_temp_data[0]);
+#else
+		return CONFIG_KERNEL_VBASE;
+#endif
+	/*-------------------------------------------------------------------
+	 * A workaround here to remap the V4G register address to 0x8xxxxxxx
+	 * in order to fix the bus error found in BG4CD/BG4CT when:
+	 *
+	 * 1) Linux apps keep doing mmap/munmap
+	 * 2) CAs keep calling into TAs
+	 *
+	 * Per test, v4g register becomes inaccessible and gives bus error
+	 * in user space using busybox devmem command. A reset to v4g can
+	 * recover this error but won't fix. Issues can easily happen if we
+	 * keep running 1) & 2) tests.
+	 *
+	 * This turns out to have something to do with MMU, below are some
+	 * tests done in Trustzone:
+	 * Case A) Don't map register space, issue not reproduced
+	 * Case B) Map register to 0x8xxxxxxx, issue not reproduced
+	 * Case C) Don't create map for V4G register space, issue not seen
+	 *
+	 * Root cause still not found, but the guess is this issue might
+	 * have something to do with world switching between secure and
+	 * non-secure, 64-bit and 32-bit environment.
+	 *
+	 * For this momemnt, case B) gives us the idea to provide this
+	 * workaround
+	 *-------------------------------------------------------------------
+	 */
+	if (strncmp(mr->name, "v4g", 3) == 0)
+		return (((unsigned long)(mr->base) & 0x0fffffff) | 0x80000000);
+
+	/*-------------------------------------------------------------------
+	 * Like the above, a similar workaround here to remap the H1 register
+	 * address to 0x8xxxxxxx
+	 *-------------------------------------------------------------------
+	 */
+	if (strncmp(mr->name, "h1", 2) == 0)
+		return (((unsigned long)(mr->base) & 0x0fffffff) | 0x80000000);
+
+	return (unsigned long)mr->base;
+}
+
+/*-------------------------------------------------------------------
+ * Unlike suspend in BG2Q or relevant chips, requirement is changed
+ * in BG4CT in suspend implementation:
+ *
+ * a) Primary cpu in Linux kernel would power off secondaries and
+ *    calls PSCI suspend command and enter secure monitor
+ * b) secure monitor calls TOS's suspend handler
+ * c) TOS's suspend handler takes platform specific action for
+ *    suspend preparation and gives control back to secure monitor
+ *    once done
+ * d) secure monitor calls platform specific power management APIs
+ *    to do suspend, this includes:
+ *    1) Save TSP SRAM contents to DDR memory
+ *    2) Copy suspend codes to TSP SRAM and jump to TSP SRAM to
+ *       execute the suspend codes
+ *    3) Put DDR into self refresh state and enter wfi state, waiting
+ *       for interrupt events for wake up
+ *
+ * Below plat_suspend is the step c) as described above, mainly to
+ * set up the interrupt sources which are used to wake up CPU from
+ * wfi state
+ *-------------------------------------------------------------------
+ */
+void plat_suspend(void)
+{
+	plat_save_tee_final_configuration();
+#if 0
+	/* set SM as wakeup interrupt source*/
+	hal_intr_set_secure(SUSPEND_WAKEUP_INTR);
+	hal_intr_unmask(SUSPEND_WAKEUP_INTR);
+
+	/* disable the I & D cache */
+	disable_caches();
+	/* flush dcache */
+	flush_dcache_all();
+	/* flush icache */
+	invalidate_icache_all();
+#endif
+}
