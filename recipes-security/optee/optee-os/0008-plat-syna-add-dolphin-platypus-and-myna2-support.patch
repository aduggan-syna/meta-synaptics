+    #define   SET32DSmsg_intr(r32,v)                           _BFSET_(r32,15,15,v)
+    #define   GET16DSmsg_intr(r16)                             _BFGET_(r16,15,15)
+    #define   SET16DSmsg_intr(r16,v)                           _BFSET_(r16,15,15,v)
