+    #define   SET16DSmsg_NOS(r16,v)                            _BFSET_(r16,13,13,v)
+
+    #define   GET32DSmsg_dir(r32)                              _BFGET_(r32,14,14)
+    #define   SET32DSmsg_dir(r32,v)                            _BFSET_(r32,14,14,v)
+    #define   GET16DSmsg_dir(r16)                              _BFGET_(r16,14,14)
