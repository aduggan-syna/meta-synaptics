+TEE_Result syscall_syna_map_memory(uint32_t mem_id, void **va, size_t *size)
+{
+	struct ts_session *s = ts_get_current_session();
+	struct user_ta_ctx *utc = NULL;
+	TEE_Result ret = TEE_SUCCESS;
+
+	utc = to_user_ta_ctx(s->ctx);
