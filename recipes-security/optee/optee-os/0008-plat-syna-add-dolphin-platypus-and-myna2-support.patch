+				m->size = (uint64_t)mr[i].size;
+			DMSG("added\n");
+			break;
+		}
+#endif
+	}
+
+	//pre_test_mmu();
+}
+#if 0
+static void syna_early_setup(void)
+{
+	mr_early_setup();
+}
+#endif
+
+static void parse_boot_params(void)
+{
+	void *boot_param;
+
+	if (tzb_arg.flags & TZ_BOOT_FLAG_RESUME)
+		return;
+
+	// remap to vritual address for mmu is enabled
+	boot_param = phys_to_virt((unsigned long)tzb_arg.boot_param, MEM_AREA_RAM_SEC, 1);
+	DMSG("boot_param = 0x%p, arg.boot_param = 0x%p.\n", boot_param, tzb_arg.boot_param);
+
+	tz_boot_param_init(boot_param, false);
+}
+
+static TEE_Result syna_setup(void)
