+///                                    ###
+///                                    * tRTP-1
+///                                    ###
+///               %unsigned 4  init_twtr                 0x3
+///                                    ###
+///                                    * tWTR-1
+///                                    ###
+///               %unsigned 4  init_tmrd                 0x3
+///                                    ###
+///                                    * tMRD-1
+///                                    ###
+///               %%        4          # Stuffing bits...
+///     @ 0x0001C Timing3              (P)
+///               ###
+///               * 0x1c
+///               * SDRAM Timing Register III
+///               ###
+///               %unsigned 8  init_txsnr                0x36
+///                                    ###
+///                                    * tXSNR-1
+///                                    ###
+///               %unsigned 8  init_tick                 0x4F
