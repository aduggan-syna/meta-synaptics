+
+	/* support read or read+write. so read permission has to be added
+	 */
+	if (!(permission & UMEM_PERM_READ)) {
+		EMSG("support read or read+write! %x\n", permission);
+		ret = TEE_ERROR_BAD_PARAMETERS;
+		goto out;
+	}
