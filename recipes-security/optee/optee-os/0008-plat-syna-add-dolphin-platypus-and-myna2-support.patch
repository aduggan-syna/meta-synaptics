diff --git a/core/arch/arm/plat-synaptics/driver/bcm/bcm_suspend.h b/core/arch/arm/plat-synaptics/driver/bcm/bcm_suspend.h
new file mode 100644
index 0000000..b3c58a9
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/driver/bcm/bcm_suspend.h
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#ifndef __BCM_SUSPEND_H__
+#define __BCM_SUSPEND_H__
+
+#pragma pack (1)
+
+#define TF_MZ_M_NS				(0x10)
+#define TF_MZ_M_ID				(0x0f)
+
+#define TF_MZ_S_NS				4
+#define TF_MZ_S_ID				0
+
+#define TF_MZ_ATTR(id, ns)		(((((ns) << TF_MZ_S_NS)) & TF_MZ_M_NS) | \
+					((((id) << TF_MZ_S_ID)) & TF_MZ_M_ID))
+
+struct tee_final_memory_zone {
+	uint8_t			attr;	/* id + ns*/
+	uint32_t		ns_rd;
+	uint32_t		ns_wr;
+	uint32_t		s_rd;
+	uint32_t		s_wr;
+	uint32_t		start;
+	uint32_t		size;
+};
+
+/* register firewall window */
+#define TF_RF_M_PERM			(0x7e00)
+#define TF_RF_M_STAGE			(0x01c0)
+#define TF_RF_M_ID				(0x003f)
+
+#define TF_RF_S_PERM			9
+#define TF_RF_S_STAGE			6
+#define TF_RF_S_ID				0
+
+#define TF_RF_ATTR(id, stage, perm)		(((((perm) << TF_RF_S_PERM)) & TF_RF_M_PERM) | \
+					((((stage) << TF_RF_S_STAGE)) & TF_RF_M_STAGE) | \
+					((((id) << TF_RF_S_ID)) & TF_RF_M_ID))
+
+struct tee_final_rf_window {
+	uint16_t		attr;	/*id + stage + perm */
+	uint32_t		base;
+	uint32_t		size;
+	uint32_t		mst_group_ids;
+};
+
+// master setting
+#define TF_MST_M_PERM			(0x3f00)
+#define TF_MST_M_STAGE			(0x00e0)
+#define TF_MST_M_ID				(0x001f)
+
+#define TF_MST_S_PERM			8
+#define TF_MST_S_STAGE			5
+#define TF_MST_S_ID				0
+#define TF_MST(id, stage, perm)		(((((perm) << TF_MST_S_PERM)) & TF_MST_M_PERM) | \
+					((((stage) << TF_MST_S_STAGE)) & TF_MST_M_STAGE) | \
+					((((id) << TF_MST_S_ID)) & TF_MST_M_ID))
+
+// Rules
+#define TF_RULE_M_PERM			(0xf000)
+#define TF_RULE_M_MST			(0x01f0)
+#define TF_RULE_M_ID			(0x000f)
+
+#define TF_RULE_S_PERM			12
+#define TF_RULE_S_MST			4
+#define TF_RULE_S_ID			0
+#define TF_RULE(id, mst, perm)		(((((perm) << TF_RULE_S_PERM)) & TF_RULE_M_PERM) | \
+					((((mst) << TF_RULE_S_MST)) & TF_RULE_M_MST) | \
+					((((id) << TF_RULE_S_ID)) & TF_RULE_M_ID))
+
+
+struct tee_final_configuration {
+	uint32_t rf_window_num;
+	uint32_t master_setting_num;
+	uint32_t mem_zone_num;
+	uint32_t szc_rule_num;
+
+	// store the data of rf_window, master_setting, mem_zone and rules
+	uint8_t buff[0];
+};
+
+void bcm_suspend_init(void);
+void bcm_suspend(void);
+void bcm_resume(void);
+int bcm_store_tee_data(void* buff, uint32_t offset, uint32_t size);
+#endif
diff --git a/core/arch/arm/plat-synaptics/driver/bcm/bcm_verify.c b/core/arch/arm/plat-synaptics/driver/bcm/bcm_verify.c
new file mode 100644
index 0000000..ff68eae
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/driver/bcm/bcm_verify.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include <string.h>
+#include <stdint.h>
+#include "bcmREG.h"
+#include "bcmImg.h"
+#include "tz_errcode.h"
+#include "bcm_mailbox.h"
+#include "tz_boot_cmd.h"
+#include "mr_setup.h"
+#include "bcm/bcm_verify.h"
+#include <mm/core_memprot.h>
+#include <tee/cache.h>
+
+#ifdef CONFIG_ANTIROLLBACK
+
+/* anti-rollback parameters */
+static int otp_comm_ver = 0;
+static int otp_cust_ver = 0;
+static bool in_recovery = false;
+
+void set_antirollback_param(int comm_ver, int cust_ver, bool recovery)
+{
+	otp_comm_ver = comm_ver;
+	otp_cust_ver = cust_ver;
+	in_recovery = recovery;
+}
+
+#endif /* CONFIG_ANTIROLLBACK */
+
+unsigned int image_get_permissions(const void *image)
+{
+	/* default full permission */
+	return 0xffffffff;
+}
+
+#ifdef CONFIG_IMAGE_NO_ENCRYPTION
+int verify_image(const void *src, unsigned int size, void *dst,
+		unsigned int *dst_size, unsigned int code_type, uint32_t multi_keys)
+{
+	memcpy(dst, src, size);
+	*dst_size = size;
+	return 0;
+}
+#else
+#define BCM_VERIFY_IMAGE_TYPE_MASK		0x7c
+#define BCM_MAILBOX				MEMMAP_BCM_REG_BASE
+
+#define BCM_PI_IMAGE_VERIFY			0x1000
+
+#define BCM_PI_IMAGE_VERIFY_EXT		0x1006
+
+#define BCM_STATUS_BCM_FAULT			(1<<10)
+#define BCM_STATUS_BOOTSTRAP_IN_PROGRESS	(1<<9)
+#define BCM_STATUS_BCM_READY			(1<<8)
+#define BCM_STATUS_BCM_CMD_FLIP			(1<<7)
+
+int sp_exec_cmd(const void *cmd, size_t cmd_len,
+		const void *result, size_t result_len);
+
+int bcm_verify_with_wait(uint32_t type, const void *src, uint32_t src_size,
+		void *dst, uint32_t *dst_size, uint32_t multi_keys)
+{
+	int res = TEE_ERROR_GENERIC;
+	BCM_MAILBOX_COMMAND cmd = {0};
+	BCM_MAILBOX_STATUS status = {0};
+	uint32_t *dst_len = memalign(plat_cache_line_len(), sizeof(uint32_t));
+
+	if (dst_len == NULL)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	/* BCM would check the dst_len for valid dst memory space */
+	*dst_len = *dst_size;
+	flush_dcache_range((void *)dst_len, (char *)dst_len + 64);
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.arg0 = type;
+	cmd.arg1 = (unsigned long)virt_to_phys((void*)src);
+	cmd.arg2 = src_size;
+	cmd.arg3 = (unsigned long)virt_to_phys((void*)dst);
+	cmd.arg4 = (unsigned long)virt_to_phys((void*)dst_len);
+	cmd.arg5 = multi_keys;
+	cmd.command = BCM_PI_IMAGE_VERIFY_EXT;
+
+	/* flush dcache before verification */
+	cache_operation(TEE_CACHEFLUSH, (void *)&cmd, sizeof(BCM_MAILBOX_COMMAND));
+	cache_operation(TEE_CACHEFLUSH, (void *)src, src_size);
+
+	res = sp_exec_cmd(&cmd, sizeof(BCM_MAILBOX_COMMAND), &status, sizeof(BCM_MAILBOX_STATUS));
+	if(res) {
+		EMSG("sp_exec_cmd cmd 0x%x error with res = 0x%x\n", cmd.command, res);
+		free(dst_len);
+		return res;
+	}
+	/* invalidate dcache after verification */
+	cache_operation(TEE_CACHEINVALIDATE, dst, src_size);
+
+	*dst_size = *dst_len;
+	DMSG("verify image %x, size=%d\n", status, *dst_size);
+
+	free(dst_len);
+
+	return status.return_status;
+}
+
+int bcm_verify_without_wait(uint32_t type, const void *src, uint32_t src_size,
+		void *dst, uint32_t *dst_size, uint32_t multi_keys)
+{
+	int res = TEE_ERROR_GENERIC;
+	BCM_MAILBOX_COMMAND cmd = {0};
+	BCM_MAILBOX_STATUS status = {0};
+	uint32_t *dst_len = memalign(plat_cache_line_len(), sizeof(uint32_t));
+
+	if (dst_len == NULL)
+		return TEE_ERROR_OUT_OF_MEMORY;
+
+	/* BCM would check the dst_len for valid dst memory space */
+	*dst_len = *dst_size;
+	cache_operation(TEE_CACHEFLUSH, (void *)dst_len, 64);
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.arg0 = type;
+	cmd.arg1 = (unsigned long)virt_to_phys((void*)src);
+	cmd.arg2 = src_size;
+	cmd.arg3 = (unsigned long)virt_to_phys((void*)dst);
+	cmd.arg4 = (unsigned long)virt_to_phys((void*)dst_len);
+	cmd.arg5 = multi_keys;
+	cmd.command = BCM_PI_IMAGE_VERIFY_EXT;
+
+	/* flush dcache before verification */
+	cache_operation(TEE_CACHEFLUSH, (void *)src, src_size);
+	res = execute_bcm_command(&cmd, &status, 10);
+	if(res) {
+		EMSG("execute_bcm_command cmd 0x%x error with res = 0x%x\n", cmd.command, res);
+		free(dst_len);
+		return res;
+	}
+	/* invalidate dcache after verification */
+	cache_operation(TEE_CACHEINVALIDATE, dst, src_size);
+
+	*dst_size = *dst_len;
+	DMSG("verify image %x, size=%d\n", status, *dst_size);
+
+	free(dst_len);
+
+	return status.return_status;
+}
+
+int bcm_verify_phyaddr(uint32_t type, const void *src, void *dst, uint32_t *dst_size)
+{
+	int res = TZ_ERROR_GENERIC;
+	BCM_MAILBOX_COMMAND cmd = {0};
+	BCM_MAILBOX_STATUS status = {0};
+	unsigned int src_size = 0x1000000;
+	*dst_size = 0x1000000;
+
+	flush_dcache_range((void *)dst_size, (char *)dst_size + 64);
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.arg0 = type;
+	cmd.arg1 = (unsigned long)src;
+	cmd.arg2 = src_size;
+	cmd.arg3 = (unsigned long)dst;
+	cmd.arg4 = (unsigned long)virt_to_phys((void*)dst_size);
+	cmd.arg5 = 0x1;
+	cmd.command = BCM_PI_IMAGE_VERIFY_EXT;
+
+	res = execute_bcm_command(&cmd, &status, 0);
+	if(res) {
+		error("execute_bcm_command cmd 0x%x error with res = 0x%x\n", cmd.command, res);
+		return res;
+	}
+
+	*dst_size = status.arg0;
+	trace("verify image %x, size=%d\n", status, *dst_size);
+
+	return status.return_status;
+}
+
+
+unsigned long tz_get_boot_stage(void);
+int verify_image(const void *src, unsigned int size, void *dst,
+		unsigned int *dst_size, unsigned int code_type, unsigned int multi_keys)
+{
+	int ret = -1;
+
+	if ((code_type != 2) && (code_type != 3) && (code_type != 4)
+			&& (code_type !=5) && (code_type !=6) && (code_type != 7)) {
+		EMSG("verify_image error code_type=%d\n", code_type);
+		return TZ_ERROR_ACCESS_DENIED;
+	}
+
+	const struct mem_region *mr = mr_find_region(virt_to_phys(dst), size);
+	if (!mr) {
+		EMSG("mr_find_region error\n");
+		return TZ_ERROR_ACCESS_DENIED;
+	}
+	if ((code_type == 2) || (code_type == 3) || (code_type == 4)) {
+		if (!TZ_IS_NNA(MR_PERM(mr))) {
+			EMSG("dst 0x%x must secure, code_type=%d\n", dst, code_type);
+			return TZ_ERROR_ACCESS_DENIED;
+		}
+	}else if ((code_type == 5) || (code_type == 6) || (code_type == 7)) {
+		if (TZ_IS_NNA(MR_PERM(mr))) {
+			EMSG("dst 0x%x must non secure, code_type=%d\n", dst, code_type);
+			return TZ_ERROR_ACCESS_DENIED;
+		}
+	}
+	/* flush dcache before verification */
+	cache_operation(TEE_CACHEFLUSH, src, size);
+	if (tz_get_boot_stage() != TZ_BOOT_STAGE_BOOTLOADER) {
+		ret = bcm_verify_with_wait(code_type, src, size, dst, (uint32_t *)dst_size, multi_keys);
+	} else {
+		ret = bcm_verify_without_wait(code_type, src, size, dst, (uint32_t *)dst_size, multi_keys);
+	}
+
+	/* invalidate dcache after verification */
+	cache_operation(TEE_CACHEINVALIDATE, dst, size);
+
+	return ret;
+}
+#endif /* CONFIG_IMAGE_NO_ENCRYPTION */
diff --git a/core/arch/arm/plat-synaptics/driver/bcm/bcm_verify.h b/core/arch/arm/plat-synaptics/driver/bcm/bcm_verify.h
