index 0000000..1438c52
--- /dev/null
+++ b/core/arch/arm/plat-synaptics/syscall/svc_syna.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2024, Synaptics Incorporated.
+ */
+
+#include <types_ext.h>
+#include <string.h>
+#include <kernel/tee_ta_manager.h>
