+static int umem_refcnt_dec(struct umem *um)
+{
+	if (!um)
+		return TEE_ERROR_BAD_PARAMETERS;
+#if 0
+	struct umem_user *user;
+	uint32_t task_id = this->task_id;
+
+
+	user = umem_find_user(um, task_id);
