+#define RULE_NS_RD	(1 << 2)
+#define RULE_NS_WR	(1 << 3)
+
+#define MST_RULE_SRW_NRW	(RULE_S_RD | RULE_S_WR | RULE_NS_RD | RULE_NS_WR)
