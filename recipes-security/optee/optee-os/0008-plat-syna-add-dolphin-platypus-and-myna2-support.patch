+	struct mobj *mobj = NULL;
+	vaddr_t v = 0;
+	TEE_Result res = TEE_SUCCESS;
+	uint32_t prot = TEE_MATTR_URW | TEE_MATTR_PRW;
+	uint32_t vm_flags = 0;
+	vm_flags |= VM_FLAG_SHAREABLE;
+
+	um = umem_find(mem_id);
+	if (um == NULL)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	mobj = um->mobj;
+	res = vm_map_pad(&utc->uctx, &v, um->size, prot, vm_flags, mobj, um->offs, 0, 0, 0);
+	if (res == TEE_SUCCESS) {
+		um->vm_start =v;
+		*va = (void *)v;
+		*size = um->size;
+	}
+
+	return res;
+}
+
+
+int umem_unmap_memory(struct user_ta_ctx *utc, uint32_t mem_id)
+{
+	uint32_t vm_flags = 0;
+	struct umem *um = NULL;
+	TEE_Result res = TEE_SUCCESS;
+	vaddr_t va;
+
+	um = umem_find(mem_id);
+	if (um == NULL)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	va = um->vm_start;
+
+	res = vm_get_flags(&utc->uctx, va, um->size, &vm_flags);
+	if (res)
+		return res;
+
+	if (vm_flags & VM_FLAG_PERMANENT)
+		return TEE_ERROR_ACCESS_DENIED;
+
+	return vm_unmap(&utc->uctx, um->vm_start, um->size);
+
+	//return umem_task_unmap_memory(this->task_id, mem_id);
+}
