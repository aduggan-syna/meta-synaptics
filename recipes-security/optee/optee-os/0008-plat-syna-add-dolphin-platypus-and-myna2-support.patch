+/// 
+/// $INTERFACE KilopassReg                              (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 KilopassOTP_Pin      (P)
+///     # 0x00000 KilopassOTP_Pin      
+///               $KilopassOTP_Pin     KilopassOTP_Pin   REG          
+///                                    ###
+///                                    * KilopassOTP_pin
+///                                    ###
+///     @ 0x00044                      (W-)
+///     #         # Stuffing bytes...
+///               %% 480
+///     @ 0x00080 KilopassOTP_Timing   (P)
+///     # 0x00080 KilopassOTP_Timing   
+///               $KilopassOTP_Timing  KilopassOTP_Timing REG          
+///                                    ###
+///                                    * KilopassOTP_timing
+///                                    ###
+///     @ 0x00120                      (W-)
+///     #         # Stuffing bytes...
+///               %% 768
+///     @ 0x00180 CopyOTP              (RW-)
+///               %unsigned 1  CopyOTP                   0x0
+///                                    ###
+///                                    * By writing to address, host CPU sends command to OTP wrapper to
+///                                    * start a copy of OTP to shadow register. This is used when a
+///                                    * OTP_RdFail interrupt happens. ACPU should expect a CopyDone
+///                                    * interrupt after issuing this command.
+///                                    * Self_recover
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00184 OTPMask              (P)
+///               %unsigned 32 OTPMask                   0x0
+///                                    ###
+///                                    * OTP mask when issuing program command to OTP.
+///                                    ###
+///     @ 0x00188 OTP_ErrorAddress     (R-)
+///               %unsigned 32 OTP_ErrorAddress          0x0
+///                                    ###
+///                                    * When CPU sends command to read or program Kilopass OTP, an error
+///                                    * might happen. This register Indicates at which OTP address the
+///                                    * operation fail happened. Note that is this address matches with
+///                                    * Galois memmap.
+///                                    * ACPU can access this register on Engineer_enable chip.
+///                                    * This register will be disabled in production chip.
+///                                    ###
+///     @ 0x0018C OTP_ErrorBit         (R-)
+///               %unsigned 32 OTP_ErrorBit              0x0
+///                                    ###
+///                                    * When CPU sends command to read or program Kilopass OTP, an error
+///                                    * might happen. This register Indicates at which bit the error
+///                                    * happened.
+///                                    * 1: error bit
+///                                    * 0: normal bit
+///                                    * ACPU can access this register on Engineer_enable chip..
+///                                    * This register will be disabled in production chip.
+///                                    ###
+///     @ 0x00190 OtpReady             (P)
+///               %unsigned 1  OtpReady                  0x0
+///                                    ###
+///                                    * Once hardware set ‘ShadowRegCopyDone’, CPU can
+///                                    * 1) Directly set this bit to 1 to inform NSK2 that OTP is ready
+///                                    * for use;
+///                                    * or
+///                                    * 2) Start to program OTP field, once all the programming are
+///                                    * done, CPU needs to set this bit to 1 to inform NSK2.
+///                                    * Firmware needs to make sure that once this bit is set, it must
+///                                    * stay in this value until next global reset.
+///                                    * ACPU can access this register.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00194 Otp_forcedly_const   (P)
+///               %unsigned 32 Otp_forcedly_const        0x4C4B40
+///                                    ###
+///                                    * Delay is 200ms, clock is 40ns, the count number is 5000000
+///                                    * ACPU can access this register.
+///                                    ###
+///     @ 0x00198 Otp_password         (P)
+///     # 0x00198 Otp_password         
+///               $OneReg              Otp_password      REG       [4]
+///                                    ###
+///                                    * User provide password in order to have the access to write to
+///                                    * Kilopass OTP.
+///                                    * ACPU can access this register.
+///                                    ###
+///     @ 0x001A8 Otp_password_match   (R-)
+///               %unsigned 1  Otp_password_match        0x0
+///                                    ###
+///                                    * Whether the password user provided is matching
+///                                    * ACPU can access this register.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x001AC Otp_password_valid   (P)
+///               %unsigned 1  Otp_password_valid        0x0
+///                                    ###
+///                                    * When write to this register, software marks user password as
+///                                    * valid so that hardware will start check if the user password
+///                                    * for OTP programming is matching. When command finishes,
+///                                    * software can read ‘Otp_password_match’ to check the result.
+///                                    * ACPU can access this register.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x001B0 KilopassOTP_DebugMode (P)
+///               %unsigned 1  KilopassOTP_DebugMode     0x0
+///                                    ###
+///                                    * 1: Debug Mode for KilopassOTP. CPU can directly write and read
+///                                    * to KilopassOTP pins. All read and write request from AHB bus
+///                                    * will be ignored.
+///                                    * 0: Function Mode for KilopassOTP.  CPU can issue read and write
+///                                    * transaction through AHB bus. All read and write request to
+///                                    * KilopassOTP pins will be ignored.
+///                                    * ACPU can access this register.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x001B4 IntStatus            (WOC-)
+///               ###
+///               * Writing ones to any of the bits will clear those bits.  ACPU can
+///               * access it
+///               ###
+///               %unsigned 1  ShadowRegCopyDone         0x0
+///                                    ###
+///                                    * Hardware finishes the copy from OTP to shadow register
+///                                    ###
+///               %unsigned 1  ShadowRegCopyFail         0x0
+///                                    ###
+///                                    * Hardware fails the copy from OTP to shadow register. Error
+///                                    * happened during the reading of one of the OTP field
+///                                    ###
+///               %unsigned 1  OTP_Cp_Fail               0x0
+///                                    ###
+///                                    * After reset, OTP wrapper will read out all OTP content and copy
+///                                    * it to shadow register, an error happened during this copy.
+///                                    * ‘OTP_ErrorAddress’ has the information that at which address
+///                                    * the error occurs.
+///                                    ###
+///               %unsigned 1  OTP_Rd_Fail               0x0
+///                                    ###
+///                                    * CPU sends command to read OTP but an error happened during
+///                                    * reading. ‘OTP_ErrorAddress’ has the information that at which
+///                                    * address the error occurs. Please ref to OTP spec for more
+///                                    * details.
+///                                    ###
+///               %unsigned 1  OTP_Done                  0x0
+///                                    ###
+///                                    * OTP wrapper has finished last command. CPU may issue another
+///                                    * command now. If CPU issues another command before this
+///                                    * interrupt, this command will be ignored.
+///                                    ###
+///               %unsigned 1  OTP_Wr_RdCheck            0x0
+///                                    ###
+///                                    * CPU sends command to update OTP. OTP wrapper first read out but
+///                                    * this read transaction fails.
+///                                    ###
+///               %unsigned 1  OTP_Wr_Check              0x0
+///                                    ###
+///                                    * CPU sends command to update OTP. OTP wrapper first read out the
+///                                    * current value and check if the write request is legal.
+///                                    ###
+///               %unsigned 1  OTP_Wr_Fail               0x0
+///                                    ###
+///                                    * CPU sends command to update OTP but the program command is
+///                                    * failed.
+///                                    ###
+///               %unsigned 1  OTP_Wr_Rdback             0x0
+///                                    ###
+///                                    * CPU sends command to update OTP. Program is finished, then
+///                                    * hardware will update shadowreg’s corresponding field. Error
+///                                    * occurs when hardware is reading the corresponding OTP field.
+///                                    ###
+///               %unsigned 1  AKL_Access_OTP            0x0
+///                                    ###
+///                                    * CPU sends command to access OTP while AKL is accessing OTP. AHB
+///                                    * command will be ignored. CPU needs to send the same command
+///                                    * again
+///                                    ###
+///               %unsigned 1  OTP_Wr_OneWayCheck        0x0
+///                                    ###
+///                                    * CPU sends command to write 0 to one-way field.
+///                                    ###
+///               %unsigned 21 Reseved                   0x0
+///                                    ###
+///                                    * Reserved for future
+///                                    ###
+///     @ 0x001B8 IntMask              (P)
+///               %unsigned 32 IntMask                   0x0
+///                                    ###
+///                                    * 0: do not mask out interrupt bit
+///                                    * 1: mask out interrupt bit, register can be updated by hardware,
+///                                    * but interrupt will not be generated.
+///                                    * ACPU can access it
+///                                    ###
+///     @ 0x001BC IntEnable            (P)
+///               %unsigned 32 IntEnable                 0xFFFFFFFF
+///                                    ###
+///                                    * 0: disable interrupt bit, register will not be updated by
+///                                    * hardware
+///                                    * 1: enable interrupt bit
+///                                    ###
+///     @ 0x001C0 OTPunProgram         (R-)
+///               %unsigned 1  OTPunProgram              0x0
+///                                    ###
+///                                    * OTPunProgram set by hardware
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x001C4 ACPU_Access          (P)
+///               %unsigned 1  OTP                       0x1
+///                                    ###
+///                                    * 1 allow ACPU access OTP
+///                                    ###
+///               %unsigned 1  Shadow                    0x1
+///                                    ###
+///                                    * 1 allow ACPU access Shadow
+///                                    ###
+///               %%        30         # Stuffing bits...
+///     @ 0x001C8 TransError           (R-)
+///               ###
+///               * Invalid transfer information. When there is a invalid transfer
+///               * from ACPU/SCPU, it will be logged.
+///               ###
+///               %unsigned 32 TransError                0x0
+///     @ 0x001CC OTP_Read_V0F         (R-)
+///               %unsigned 32 V0F                       0x0
+///                                    ###
+///                                    * Virgin 0 state flag
+///                                    * 0: this bit is at virgin state
+///                                    * 1: this bit is programmed
+///                                    ###
+///     @ 0x001D0 Spare_reg            (RW)
+///               %unsigned 32 Reg0                      0x0
+///     @ 0x001D4 BIST_BlankCheckTest  (RW)
+///               %unsigned 1  BIST_BlankCheckTest       0x0
+///                                    ###
+///                                    * Write 1 to start blank check test.
+///                                    * Once command is finished, HW will update it to 0.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x001D8 BIST_RBRead          (RW)
+///               %unsigned 1  BIST_RBRead               0x0
+///                                    ###
