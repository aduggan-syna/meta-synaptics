+
+	utc = to_user_ta_ctx(s->ctx);
+
+	umem_operation_lock();
+
+	ret = umem_unmap_memory(utc, mem_id);
+
+	if (ret)
+		goto out;
+
+	if (UMEM_TYPE(mem_id) == UMEM_SHAREDMEMORY) {
+		/* try to unregister */
+		ret = umem_unregister_memory(mem_id);
+		/* if return busy, only mean ref count not equal 0 */
+		if (ret == TEE_ERROR_BUSY)
