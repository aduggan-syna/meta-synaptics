+void __attribute__((noreturn)) reset_soc(void)
+{
+	/* set soc reset bit to 1 and reset it */
+	int i;
+	while (1){
+		*(volatile uint32_t*)SOC_RESET_CTRL_BASE = 1;
+		i = 300;
+		while(i--);
+	}
