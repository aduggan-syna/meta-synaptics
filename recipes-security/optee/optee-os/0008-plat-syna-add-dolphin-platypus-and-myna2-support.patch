+///                                    ###
+///               %unsigned 1  TSEN_MIN_FAIL             0x0
+///                                    ###
+///                                    * 0: TSEN_DATA >= TSEN_DATA_MIN
+///                                    * 1: TSEN_DATA < TSEN_DATA_MIN
+///                                    ###
+///               %%        30         # Stuffing bits...
+///     # # ----------------------------------------------------------
