+    #define       bpll_ctrl_AVDD1815_SEL                       1
+    #define   MSK32pll_ctrl_AVDD1815_SEL                          0x00000004
+
+    #define     BA_pll_ctrl_REFDIV                             0x0000
+    #define     B16pll_ctrl_REFDIV                             0x0000
+    #define   LSb32pll_ctrl_REFDIV                                3
+    #define   LSb16pll_ctrl_REFDIV                                3
