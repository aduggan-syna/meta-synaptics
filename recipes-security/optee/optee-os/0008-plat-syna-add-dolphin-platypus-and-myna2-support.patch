+    #define   SET32DSmsg_hboAdr(r32,v)                         _BFSET_(r32,31,16,v)
+    #define   GET16DSmsg_hboAdr(r16)                           _BFGET_(r16,15, 0)
+    #define   SET16DSmsg_hboAdr(r16,v)                         _BFSET_(r16,15, 0,v)
