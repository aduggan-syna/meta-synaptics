+/// $INTERFACE MCU_PLL_COUNTER                          (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 CTRL                 (P)
+///               ###
+///               * PLL Counter control register
+///               ###
+///               %unsigned 16 REF_COUNT_MAX             0x0
+///                                    ###
+///                                    * The refClk counter will count for REF_COUNT_MAX number of cycles
+///                                    ###
+///               %unsigned 1  START                     0x0
+///                                    ###
+///                                    * Starts the counter when programmed to 1
+///                                    ###
+///               %unsigned 3  CLK_SEL                   0x0
+///                                    ###
+///                                    * Selects the PLL clock source for measurement
+///                                    * 3’d0 : MCU PLL
+///                                    * 3’d1 : RCOSC
+///                                    * Others: Reserved
+///                                    ###
+///               %%        12         # Stuffing bits...
+///     @ 0x00004 STATUS               (R-)
+///               %unsigned 1  DONE                      0x0
+///                                    ###
+///                                    * ref_clk counter has reached REF_COUNT_MAX. Result in PLL_COUNT
+///                                    * can be read.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00008 RESULT               (R-)
+///               %unsigned 24 PLL_COUNT                 0x0
+///                                    ###
+///                                    * Measured PLL counter result
+///                                    ###
+///               %%        8          # Stuffing bits...
+///     # # ----------------------------------------------------------
+/// $ENDOFINTERFACE  # size:      12B, bits:      45b, padding:     0B
+////////////////////////////////////////////////////////////
+#ifndef h_MCU_PLL_COUNTER
+#define h_MCU_PLL_COUNTER (){}
