+/// $INTERFACE MCS_INTF_LOCK                            (4,4)
+///     # # ----------------------------------------------------------
+///     @ 0x00000 INTF_LOCK_CTRL       (RW-)
+///               %unsigned 1  lock                      0x0
+///                                    ###
+///                                    * When 0, any manager can set this to 1. Once set to 1, only the
+///                                    * manager that set this to 1 can set it back to 0 to unlock
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x00004 INTF_LOCK_STAT       (R-)
+///               %unsigned 4  mid                       0x0
+///                                    ###
+///                                    * The ID of the manager that locked the interface when
+///                                    * INTF_LOCK_STAT.locked is 1.
+///                                    * If INTF_LOCK_STAT.locked is 0, the value in this field is
+///                                    * irrelevant and has no meaning.
+///                                    ###
+///               %unsigned 1  locked                    0x0
+///                                    ###
+///                                    * When set to 1, the interface is locked and only the manager with
+///                                    * the manager ID in INTF_LOCK_STAT.mid can access the interface as
+///                                    * well as unlock the interface.
+///                                    * When locked, other managers will RAZ/WI to the interface.
+///                                    ###
+///               %%        27         # Stuffing bits...
+///     @ 0x00008 INTF_LOCK_INTR_EN    (P)
+///               %unsigned 1  en                        0x0
+///                                    ###
+///                                    * When set to 1, a transition of INTF_LOCK_CTRL.locked from 1 to 0
+///                                    * will generate an interrupt and also set the INTF_LOCK_INTR_STAT
+///                                    * to 1
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     @ 0x0000C INTF_LOCK_INTR_STAT  (WOC-)
+///               %unsigned 1  lock_released             0x0
+///                                    ###
+///                                    * When 1, the previous lock was released. This bit stays 1 until
+///                                    * programmed to 0.
+///                                    * Hardware will not set it back to 0 if another lock/unlock
+///                                    * sequence has occurred.
+///                                    ###
+///               %%        31         # Stuffing bits...
+///     # # ----------------------------------------------------------
