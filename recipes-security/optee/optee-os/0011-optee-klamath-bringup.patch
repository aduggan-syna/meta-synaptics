+            UNSG32 RSVDx8_b24                                  :  8;\
+          }
+    union { UNSG32 u32PLL_COUNTER_RESULT;
+            struct w32PLL_COUNTER_RESULT;
+          };
+    ///////////////////////////////////////////////////////////
+    } SIE_PLL_COUNTER;
+
+    typedef union  T32PLL_COUNTER_CTRL
+          { UNSG32 u32;
+            struct w32PLL_COUNTER_CTRL;
+                 } T32PLL_COUNTER_CTRL;
+    typedef union  T32PLL_COUNTER_STATUS
