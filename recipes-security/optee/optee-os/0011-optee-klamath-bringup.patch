+///     @ 0x0006C                      (P)
+///     # 0x0006C SOC_INTF_REGION2     
+///               $MCS_SOC_INTF        SOC_INTF_REGION2  REG          
+///     @ 0x0007C                      (P)
+///     # 0x0007C SOC_INTF_REGION3     
+///               $MCS_SOC_INTF        SOC_INTF_REGION3  REG          
+///     @ 0x0008C                      (P)
+///     # 0x0008C SOC_INTF_REGION4     
+///               $MCS_SOC_INTF        SOC_INTF_REGION4  REG          
+///     @ 0x0009C                      (P)
+///     # 0x0009C SOC_INTF_REGION5     
+///               $MCS_SOC_INTF        SOC_INTF_REGION5  REG          
+///     @ 0x000AC                      (P)
+///     # 0x000AC SOC_INTF_REGION6     
+///               $MCS_SOC_INTF        SOC_INTF_REGION6  REG          
+///     @ 0x000BC                      (P)
+///     # 0x000BC SOC_INTF_REGION7     
+///               $MCS_SOC_INTF        SOC_INTF_REGION7  REG          
