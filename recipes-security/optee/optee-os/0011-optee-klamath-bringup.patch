+///               %unsigned 1  EN                        0x0
+///                                    ###
+///                                    * Enables the Clock monitor measurement
+///                                    * 0: Disable
+///                                    * 1: Enable the monitoring
+///                                    ###
+///               %unsigned 1  FAULT_INTR_EN             0x0
+///                                    ###
+///                                    * Enable generating the Interrupt from Clock Monitoring logic
+///                                    * 0: No interrupt generated
+///                                    * 1: Interrupt generated when the clock is out of bounds
+///                                    ###
+///               %unsigned 1  FAULT_RST_EN              0x0
