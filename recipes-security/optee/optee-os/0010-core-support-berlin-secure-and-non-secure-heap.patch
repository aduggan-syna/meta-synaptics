From a1a822022dac88918d600a0739a3624259ef5059 Mon Sep 17 00:00:00 2001
From: Jingju Hou <Jingju.Hou@synaptics.com>
Date: Wed, 4 Sep 2024 10:01:59 +0800
Subject: [PATCH 10/11] core: support berlin secure and non secure heap

Change-Id: I0b1ad4319b85e0e6a9defa61f0b49d5d8d25448c
Signed-off-by: Jingju Hou <Jingju.Hou@synaptics.com>
---
 core/include/mm/core_memprot.h |  4 ++++
 core/include/mm/core_mmu.h     |  7 +++++++
 core/include/mm/mobj.h         |  2 +-
 core/include/tee/entry_std.h   |  4 ++++
 core/mm/core_mmu.c             | 18 ++++++++++++++----
 core/mm/mobj.c                 |  9 ++++++++-
 core/tee/entry_std.c           | 12 +++++++++++-
 7 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/core/include/mm/core_memprot.h b/core/include/mm/core_memprot.h
index d809ad3..7010d53 100644
--- a/core/include/mm/core_memprot.h
+++ b/core/include/mm/core_memprot.h
@@ -31,6 +31,7 @@ enum buf_is_attr {
 	CORE_MEM_TA_RAM,
 	CORE_MEM_SDP_MEM,
 	CORE_MEM_REG_SHM,
+	CORE_MEM_SEC_IO,
 };
 
 /* redirect legacy tee_vbuf_is() and tee_pbuf_is() to our routines */
@@ -50,6 +51,9 @@ enum buf_is_attr {
 #define tee_vbuf_is_sec(buf, len) \
 		core_vbuf_is(CORE_MEM_SEC, (void *)(buf), (len))
 
+#define tee_vbuf_is_sec_io(buf, len) \
+		core_vbuf_is(CORE_MEM_SEC_IO, (void *)(buf), (len))
+
 /*
  * This function return true if the buf complies with supplied flags.
  * If this function returns false buf doesn't comply with supplied flags
diff --git a/core/include/mm/core_mmu.h b/core/include/mm/core_mmu.h
index c6f2586..e098a28 100644
--- a/core/include/mm/core_mmu.h
+++ b/core/include/mm/core_mmu.h
@@ -111,6 +111,7 @@ enum teecore_memtypes {
 	MEM_AREA_TS_VASPACE,
 	MEM_AREA_PAGER_VASPACE,
 	MEM_AREA_SDP_MEM,
+	MEM_AREA_NON_SEC,
 	MEM_AREA_DDR_OVERALL,
 	MEM_AREA_SEC_RAM_OVERALL,
 	MEM_AREA_MAXTYPE
@@ -145,6 +146,7 @@ static inline const char *teecore_memtype_name(enum teecore_memtypes type)
 		[MEM_AREA_TS_VASPACE] = "TS_VASPACE",
 		[MEM_AREA_PAGER_VASPACE] = "PAGER_VASPACE",
 		[MEM_AREA_SDP_MEM] = "SDP_MEM",
+		[MEM_AREA_NON_SEC] = "NONSECURE_MEM",
 		[MEM_AREA_DDR_OVERALL] = "DDR_OVERALL",
 		[MEM_AREA_SEC_RAM_OVERALL] = "SEC_RAM_OVERALL",
 	};
@@ -276,6 +278,9 @@ extern unsigned long default_nsec_shm_paddr;
 extern unsigned long default_nsec_shm_size;
 #endif
 
+extern unsigned long default_nsec_paddr;
+extern unsigned long default_nsec_size;
+
 /*
  * Physical load address of OP-TEE updated during boot if needed to reflect
  * the value used.
@@ -617,6 +622,8 @@ void asid_free(unsigned int asid);
 #ifdef CFG_SECURE_DATA_PATH
 /* Alloc and fill SDP memory objects table - table is NULL terminated */
 struct mobj **core_sdp_mem_create_mobjs(void);
+void core_mmu_set_spd_memory(paddr_t base, size_t size);
+
 #endif
 
 #ifdef CFG_NS_VIRTUALIZATION
diff --git a/core/include/mm/mobj.h b/core/include/mm/mobj.h
index 3b73b00..8ec1bf6 100644
--- a/core/include/mm/mobj.h
+++ b/core/include/mm/mobj.h
@@ -202,7 +202,7 @@ static inline bool mobj_is_nonsec(struct mobj *mobj)
 
 static inline bool mobj_is_secure(struct mobj *mobj)
 {
-	return mobj_matches(mobj, CORE_MEM_SEC);
+	return mobj_matches(mobj, CORE_MEM_SEC) || mobj_matches(mobj, CORE_MEM_SEC_IO);
 }
 
 static inline bool mobj_is_sdp_mem(struct mobj *mobj)
diff --git a/core/include/tee/entry_std.h b/core/include/tee/entry_std.h
index d228bad..83e1f3c 100644
--- a/core/include/tee/entry_std.h
+++ b/core/include/tee/entry_std.h
@@ -10,6 +10,10 @@
 #include <kernel/thread.h>
 #include <optee_msg.h>
 #include <tee_api_types.h>
+#ifdef CFG_SECURE_DATA_PATH
+extern struct mobj **sdp_mem_mobjs;
+#endif
+extern struct mobj *nsec_mobj;
 
 /*
  * Standard call entry, __weak, overridable. If overridden should call
diff --git a/core/mm/core_mmu.c b/core/mm/core_mmu.c
index 584ff78..6087aa0 100644
--- a/core/mm/core_mmu.c
+++ b/core/mm/core_mmu.c
@@ -52,6 +52,8 @@ const unsigned long core_mmu_tee_load_pa = TEE_LOAD_ADDR;
 unsigned long default_nsec_shm_size __nex_bss;
 unsigned long default_nsec_shm_paddr __nex_bss;
 #endif
+unsigned long default_nsec_size __nex_bss;
+unsigned long default_nsec_paddr __nex_bss;
 
 static struct tee_mmap_region static_memory_map[CFG_MMAP_REGIONS
 #if defined(CFG_CORE_ASLR) || defined(CFG_CORE_PHYS_RELOCATABLE)
@@ -79,7 +81,7 @@ static struct memaccess_area secure_only[] __nex_data = {
 };
 
 static struct memaccess_area nsec_shared[] __nex_data = {
-#ifdef CFG_CORE_RESERVED_SHM
+#if defined(CFG_CORE_RESERVED_SHM) && defined(TEE_SHMEM_START)
 	MEMACCESS_AREA(TEE_SHMEM_START, TEE_SHMEM_SIZE),
 #endif
 };
@@ -95,7 +97,7 @@ register_sdp_mem(TEE_SDP_TEST_MEM_BASE, TEE_SDP_TEST_MEM_SIZE);
 #endif
 #endif
 
-#ifdef CFG_CORE_RESERVED_SHM
+#if defined(CFG_CORE_RESERVED_SHM) && defined(TEE_SHMEM_START)
 register_phys_mem(MEM_AREA_NSEC_SHM, TEE_SHMEM_START, TEE_SHMEM_SIZE);
 #endif
 static unsigned int mmu_spinlock;
@@ -134,6 +136,12 @@ void core_mmu_set_secure_memory(paddr_t base, size_t size)
 	secure_only[0].size = size;
 }
 
+void core_mmu_set_spd_memory(paddr_t base, size_t size)
+{
+	sec_sdp.paddr = base;
+	sec_sdp.size = size;
+}
+
 void core_mmu_get_ta_range(paddr_t *base, size_t *size)
 {
 	paddr_t b = 0;
@@ -1563,8 +1571,8 @@ bool core_pbuf_is(uint32_t attr, paddr_t pbuf, size_t len)
 		return core_is_buffer_inside(pbuf, len, ta_base, ta_size);
 #ifdef CFG_CORE_RESERVED_SHM
 	case CORE_MEM_NSEC_SHM:
-		return core_is_buffer_inside(pbuf, len, TEE_SHMEM_START,
-							TEE_SHMEM_SIZE);
+		return core_is_buffer_inside(pbuf, len, default_nsec_shm_paddr,
+							default_nsec_shm_size);
 #endif
 	case CORE_MEM_SDP_MEM:
 		return pbuf_is_sdp_mem(pbuf, len);
@@ -2517,6 +2525,8 @@ static TEE_Result teecore_init_pub_ram(void)
 	vaddr_t s = 0;
 	vaddr_t e = 0;
 
+	if (default_nsec_shm_paddr && default_nsec_shm_size)
+		return TEE_SUCCESS;
 	/* get virtual addr/size of NSec shared mem allocated from teecore */
 	core_mmu_get_mem_by_type(MEM_AREA_NSEC_SHM, &s, &e);
 
diff --git a/core/mm/mobj.c b/core/mm/mobj.c
index afc8176..2a8c605 100644
--- a/core/mm/mobj.c
+++ b/core/mm/mobj.c
@@ -103,6 +103,7 @@ static bool mobj_phys_matches(struct mobj *mobj, enum buf_is_attr attr)
 	case CORE_MEM_TA_RAM:
 	case CORE_MEM_NSEC_SHM:
 	case CORE_MEM_SDP_MEM:
+	case CORE_MEM_SEC_IO:
 		return attr == a;
 	default:
 		return false;
@@ -162,7 +163,7 @@ static struct mobj *mobj_phys_init(paddr_t pa, size_t size, uint32_t mem_type,
 	}
 
 	/* Only SDP memory may not have a virtual address */
-	if (!va && battr != CORE_MEM_SDP_MEM)
+	if (!va && battr != CORE_MEM_SDP_MEM && battr != CORE_MEM_NON_SEC)
 		return NULL;
 
 	moph = calloc(1, sizeof(*moph));
@@ -195,9 +196,15 @@ struct mobj *mobj_phys_alloc(paddr_t pa, size_t size, uint32_t mem_type,
 	case CORE_MEM_NSEC_SHM:
 		area_type = MEM_AREA_NSEC_SHM;
 		break;
+	case CORE_MEM_NON_SEC:
+		area_type = MEM_AREA_NON_SEC;
+		break;
 	case CORE_MEM_SDP_MEM:
 		area_type = MEM_AREA_SDP_MEM;
 		break;
+	case CORE_MEM_SEC_IO:
+		area_type = MEM_AREA_IO_SEC;
+		break;
 	default:
 		DMSG("can't allocate with specified attribute");
 		return NULL;
diff --git a/core/tee/entry_std.c b/core/tee/entry_std.c
index d3ae624..4a2d09b 100644
--- a/core/tee/entry_std.c
+++ b/core/tee/entry_std.c
@@ -36,8 +36,9 @@ TAILQ_HEAD_INITIALIZER(tee_open_sessions);
 static struct mobj *shm_mobj;
 #endif
 #ifdef CFG_SECURE_DATA_PATH
-static struct mobj **sdp_mem_mobjs;
+struct mobj **sdp_mem_mobjs;
 #endif
+struct mobj *nsec_mobj;
 
 static unsigned int session_pnum;
 
@@ -138,6 +139,9 @@ static TEE_Result set_tmem_param(const struct optee_msg_param_tmem *tmem,
 			return TEE_SUCCESS;
 #endif
 
+	if (param_mem_from_mobj(mem, nsec_mobj, pa, sz))
+		return TEE_SUCCESS;
+
 	return TEE_ERROR_BAD_PARAMETERS;
 }
 
@@ -603,6 +607,12 @@ static TEE_Result default_mobj_init(void)
 		panic("Failed to register SDP memory");
 #endif
 
+	nsec_mobj = mobj_phys_alloc(default_nsec_paddr,
+				   default_nsec_size, SHM_CACHE_ATTRS,
+				   CORE_MEM_NON_SEC);
+	if (!nsec_mobj)
+		panic("Failed to register non sec memory");
+
 	return TEE_SUCCESS;
 }
 
-- 
2.7.4

