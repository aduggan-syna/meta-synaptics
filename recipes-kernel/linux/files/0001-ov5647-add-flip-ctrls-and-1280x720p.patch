 }

+static int ov5647_set_ctrl_hflip(struct ov5647 *sensor, int value)
+{
+	struct v4l2_subdev *sd = &sensor->sd;
+
+	/*
+	 * TIMING TC REG21:
+	 * - [2]:	ISP mirror
+	 * - [1]:	Sensor mirror
+	 */
+	return ov5647_mod_reg(sd, OV5647_REG_TIMING_TC_REG21,
+			      BIT(2) | BIT(1),
+			      (!(value ^ sensor->upside_down)) ?
+			      (BIT(2) | BIT(1)) : 0);
+}
+
+static int ov5647_set_ctrl_vflip(struct ov5647 *sensor, int value)
+{
+	struct v4l2_subdev *sd = &sensor->sd;
+
+	/* If sensor is mounted upside down, flip logic is inversed */
+
+	/*
+	 * TIMING TC REG20:
+	 * - [2]:	ISP vflip
+	 * - [1]:	Sensor vflip
+	 */
+	return ov5647_mod_reg(sd, OV5647_REG_TIMING_TC_REG20,
+			      BIT(2) | BIT(1),
+			      (value ^ sensor->upside_down) ?
+			      (BIT(2) | BIT(1)) : 0);
+}
