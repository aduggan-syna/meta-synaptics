+static int ov5647_mod_reg(struct v4l2_subdev *sd, u16 reg, u8 mask, u8 val)
+{
+	u8 readval;
+	int ret;
+
+	ret = ov5647_read(sd, reg, &readval);
+	if (ret)
+		return ret;
+
+	readval &= ~mask;
+	val &= mask;
+	val |= readval;
+
+	return ov5647_write(sd, reg, val);
+}
