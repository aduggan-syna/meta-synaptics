From 1f095e1130c3756e59b134ed0802e624e898ea85 Mon Sep 17 00:00:00 2001
From: Brendan King <Brendan.King@imgtec.com>
Date: Wed, 8 Nov 2017 15:26:25 +0000
Subject: [PATCH 16/62] egl/wayland: flush the swap buffers blit

Pass the flush flag to the blitImage call.
---
 src/egl/drivers/dri2/platform_wayland.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/egl/drivers/dri2/platform_wayland.c b/src/egl/drivers/dri2/platform_wayland.c
index d1e7c33fb77..23e5c80a466 100644
--- a/src/egl/drivers/dri2/platform_wayland.c
+++ b/src/egl/drivers/dri2/platform_wayland.c
@@ -1652,7 +1652,7 @@ dri2_wl_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw,
          dri2_ctx->dri_context, dri2_surf->current->linear_copy,
          dri2_surf->current->dri_image, 0, 0, dri2_surf->base.Width,
          dri2_surf->base.Height, 0, 0, dri2_surf->base.Width,
-         dri2_surf->base.Height, 0);
+         dri2_surf->base.Height, __BLIT_FLAG_FLUSH);
    }
 
    wl_surface_commit(dri2_surf->wl_surface_wrapper);
-- 
2.34.1

