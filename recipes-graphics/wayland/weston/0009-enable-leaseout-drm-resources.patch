+static bool
+check_plane_in_crtc(drmModeRes *res, uint32_t crtc_id, uint32_t possible_crtcs)
+{
+	int i;
+	for (i = 0; i < res->count_crtcs; i++) {
+		if (((1<<i) & possible_crtcs) && (res->crtcs[i] == crtc_id))
+			return true;
+	}
+	return false;
+}
+
+static int leasefd_socket_listen(int sock_fd, uint32_t mask, void *data)
+{
+	struct drm_backend *b = data;
+	int client_fd;
+	struct iovec iov;
+	struct msghdr msg = {0};
+	struct cmsghdr *cmsg;
+	ssize_t ret;
+
+	union {
+		struct cmsghdr hdr;
+		char buf[CMSG_SPACE(sizeof(int))];
+	} cms_dat;
+
+	client_fd = accept(sock_fd, NULL, NULL);
+	if (client_fd < 0) {
+		weston_log("failed to accept connection on lease soc %s\n",
+				strerror(errno));
+		return 1;
+	}
+
+	iov.iov_base = "1";
+	iov.iov_len = 1;
+
+	msg.msg_name = NULL;
+	msg.msg_namelen = 0;
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+
+	msg.msg_control = cms_dat.buf;
+	msg.msg_controllen = sizeof(cms_dat.buf);
+
+	cmsg = CMSG_FIRSTHDR(&msg);
+	cmsg->cmsg_type = SCM_RIGHTS;
+	cmsg->cmsg_level = SOL_SOCKET;
+	cmsg->cmsg_len = CMSG_LEN(sizeof (int));
+	memcpy(CMSG_DATA(cmsg), &b->lease_fd, sizeof(int));
+
+	ret = sendmsg(client_fd, &msg, 0);
+	if (ret < 0) {
+		weston_log("error in sending leasefd to client\n");
+	}
+
+	close(client_fd);
+
+	return 1;
+}
+
+static int drm_backend_setup_leasesoc(struct drm_backend *b)
+{
+	int sock_fd;
+	struct sockaddr_un addr;
+	socklen_t size;
+	const char *runtime_dir = "";
+	const char *leasefd_name = DRM_LEASE_SOCK_FILENAME;
+	struct wl_event_loop *loop;
+
+	runtime_dir = getenv("XDG_RUNTIME_DIR");
+	if (!runtime_dir || runtime_dir[0] != '/') {
+		weston_log("XDG_RUNTIME_DIR is invalid or not set in "
+			   "the environment, lease soc won't be created\n");
+
+		return -1;
+	}
+
+	addr.sun_family = AF_LOCAL;
+	snprintf(addr.sun_path, sizeof (addr.sun_path),
+			"%s/%s", runtime_dir, leasefd_name);
+
+	sock_fd = socket(PF_LOCAL, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (sock_fd < 0) {
+		weston_log("error opening socket:%s in xdg path:%s\n",
+			   leasefd_name, runtime_dir);
+		return -1;
+	}
+
+	size = offsetof (struct sockaddr_un, sun_path) + strlen(addr.sun_path);
+	if (bind(sock_fd, (struct sockaddr *) &addr, size) < 0) {
+		weston_log("lease_fd: bind() failed with error: %s\n", strerror(errno));
+		goto error_soc_rel;
+	}
+
+	if (listen(sock_fd, 1) < 0) {
+		weston_log("lease_fd:listen() failed with error: %s\n", strerror(errno));
+		goto error_soc_rel;
+	}
+
+	loop = wl_display_get_event_loop(b->compositor->wl_display);
+
+	b->leasefd_src = wl_event_loop_add_fd(loop, sock_fd,
+			WL_EVENT_READABLE,
+			leasefd_socket_listen,
+			b);
+
+	if (b->leasefd_src == NULL)
+		goto error_soc_rel;
+
+	b->lease_sock_fd = sock_fd;
+	return 0;
+
+error_soc_rel:
+	close(sock_fd);
+	return -1;
+}
+
+static void drm_backend_setup_lease(struct drm_backend *b)
+{
+
+	int lessee_fd;
+
+	lessee_fd = drmModeCreateLease(b->drm.fd, b->leased_objects,
+			LEASE_MAX_COUNT, O_CLOEXEC | O_NONBLOCK, &b->lessee_id);
+
+	if (lessee_fd <= 0) {
+		weston_log("error creating drm lease : %s\n", strerror(errno));
+		return;
+	}
+
+	weston_log("drm lease created with fd:%d and leaseId:%d\n", lessee_fd, b->lessee_id);
+	b->lease_fd = lessee_fd;
+	drm_backend_setup_leasesoc(b);
+}
