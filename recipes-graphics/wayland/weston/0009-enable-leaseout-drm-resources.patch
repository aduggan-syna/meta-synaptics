+static void
+drm_backend_release_lease_resources(struct drm_backend *b)
+{
+	char sock_fd_name[100];
+	const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+
+	snprintf(sock_fd_name, sizeof (sock_fd_name),
+                        "%s/%s", runtime_dir, DRM_LEASE_SOCK_FILENAME);
+
+	weston_log("revoking lease for lessee_id: %d socfile:%s\n", b->lessee_id, sock_fd_name);
+	drmModeRevokeLease(b->drm.fd, b->lessee_id);
+	close(b->lease_fd);
+
+	wl_event_source_remove(b->leasefd_src);
+	close(b->lease_sock_fd);
+	unlink(sock_fd_name);
+}
