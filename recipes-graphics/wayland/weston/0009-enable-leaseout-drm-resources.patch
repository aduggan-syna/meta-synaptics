+static void
+drm_backend_validate_lease_request(struct drm_backend *b,
+                                   struct weston_drm_backend_config *config,
+                                   drmModeRes *res)
+{
+	drmModePlaneRes *plane_res;
+	drmModePlane *plane;
+	drmModeConnector *conn;
+	drmModeEncoder *encoder;
+	drmModeCrtc *crtc;
+	uint32_t lease_conn_id;
+	uint32_t lease_plane_id;
+	uint32_t lease_crtc_id;
+	uint32_t lease_crtc_index;
+	uint32_t possible_crtcs = 0;
+	int i,j;
+	int drm_fd = b->drm.fd;
+
+	b->lease_active = false;
+	lease_conn_id = config->lease_connector_id;
+	lease_plane_id = config->lease_plane_id;
+	if (!lease_conn_id || !lease_plane_id)
+		return;
+
+	for (i = 0; i < res->count_connectors; i++) {
+		uint32_t connector_id = res->connectors[i];
+		if (connector_id != lease_conn_id)
+			continue;
+
+		conn = drmModeGetConnector(drm_fd, connector_id);
+                if (!conn)
+			return;
+
+		/* Get the crtc that's driving this connector this connector. */
+		encoder = drmModeGetEncoder(drm_fd, conn->encoder_id);
+		drmModeFreeConnector(conn);
+		if (!encoder)
+			return;
+
+		crtc = drmModeGetCrtc(drm_fd, encoder->crtc_id);
+		drmModeFreeEncoder(encoder);
+		if (!crtc)
+			return;
+
+		lease_crtc_id = crtc->crtc_id;
+		drmModeFreeCrtc(crtc);
+		break;
+	}
+
+	if (i == res->count_connectors) {
+		weston_log ("connector requested for lease (%d) is not present\n", lease_conn_id);
+		return;
+	}
+
+	plane_res = drmModeGetPlaneResources(drm_fd);
+	for (i = 0; i < plane_res->count_planes; i++) {
+		if (lease_plane_id != plane_res->planes[i])
+			continue;
+
+		plane = drmModeGetPlane(drm_fd, plane_res->planes[i]);
+		if (!plane)
+			return;
+
+		possible_crtcs = plane->possible_crtcs;
+		drmModeFreePlane(plane);
+		break;
+	}
+
+	if (i == plane_res->count_planes) {
+		weston_log ("plane requested for lease (%d) is not present\n", lease_plane_id);
+		return;
+	}
+
+	weston_log ("selected crtc index for lease:%d plane id for lease:%d (supported crtcs 0x%x)\n",
+			lease_crtc_id, plane->plane_id, possible_crtcs);
+
+	if (!check_plane_in_crtc(res, lease_crtc_id, possible_crtcs)) {
+		weston_log ("selected plane for lease can't be mapped to connector\n");
+		return;
+	}
+
+	// now check if atleast one output can be configured for Weston with resources not reserved for lease.
+	for (i = 0; i < res->count_connectors; i++) {
+		uint32_t connector_id = res->connectors[i];
+		if (connector_id == lease_conn_id)
+			continue;
+
+		conn = drmModeGetConnector(drm_fd, connector_id);
+		encoder = drmModeGetEncoder(drm_fd, conn->encoder_id);
+		drmModeFreeConnector(conn);
+
+		crtc = drmModeGetCrtc(drm_fd, encoder->crtc_id);
+		drmModeFreeEncoder(encoder);
+
+		if (crtc->crtc_id == lease_crtc_index) {
+			/* same crtc connected to multiple connectors */
+			drmModeFreeCrtc(crtc);
+			continue;
+		}
+
+		for (j = 0; j < plane_res->count_planes; j++) {
+			if (lease_plane_id == plane_res->planes[j])
+				continue;
+
+			plane = drmModeGetPlane(drm_fd, plane_res->planes[j]);
+
+			/* TODO: add check primary plane is available for weston */
+			if (check_plane_in_crtc(res, crtc->crtc_id, plane->possible_crtcs)) {
+				drmModeFreePlane(plane);
+				break;
+			}
+			drmModeFreePlane(plane);
+		}
+
+		drmModeFreeCrtc(crtc);
+
+		if (j == plane_res->count_planes)
+			continue;
+		else
+			break;
+	}
+
+	if (i == res->count_connectors) {
+		weston_log ("can't find a path for weston, so skip lease request\n");
+		return;
+	}
+
+	/* requested resources can be leased out */
+	b->leased_objects[LEASE_CONNECTOR_INDEX] = lease_conn_id;
+	b->leased_objects[LEASE_CRTC_INDEX] = lease_crtc_id;
+	b->leased_objects[LEASE_PLANE_INDEX] = lease_plane_id;
+	b->lease_active = true;
+	weston_log ("Reserving drm path to be leased later.. crtc:%d conn:%d plane:%d\n",
+			lease_crtc_id, lease_conn_id, lease_plane_id);
+}
 
