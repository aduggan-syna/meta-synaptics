+	/* Prefer active touches (any touch down) even if a pointer exists.
+	 * This is checked first before pointer focus so that a finger on the
+	 * touch panel always wins over a stale pointer position.
+	 */
+	wl_list_for_each(seat, &compositor->seat_list, link) {
+		struct weston_touch *touch = weston_seat_get_touch(seat);
+		if (touch && touch->num_tp > 0) {
+			struct weston_output *o = NULL;
+			if (touch->focus)
+				o = touch->focus->output;
+			else {
+				struct weston_touch_device *tdev;
+				wl_list_for_each(tdev, &touch->device_list, link) {
+					if (tdev->ops && tdev->ops->get_output) {
+						o = tdev->ops->get_output(tdev);
+						if (o) break;
+					}
+				}
+			}
+			if (o) {
+				return o;
+			}
+		}
+	}
