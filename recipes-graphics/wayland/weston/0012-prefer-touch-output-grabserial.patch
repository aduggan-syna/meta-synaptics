+				struct weston_touch *touch = weston_seat_get_touch(s);
+				struct weston_touch_device *tdev;
+				if (!touch)
+					continue;
+				if (touch->focus)
+					return touch->focus->output;
+				/* Prefer the udev-mapped output over grab_pos (grab_pos
+				 * may be 0,0 which maps to HDMI-A-1 if never touched). */
+				wl_list_for_each(tdev, &touch->device_list, link) {
+					if (tdev->ops && tdev->ops->get_output) {
+						struct weston_output *to = tdev->ops->get_output(tdev);
+						if (to) {
+							return to;
+						}
+					}
+				}
+			}
+		}
+	}
