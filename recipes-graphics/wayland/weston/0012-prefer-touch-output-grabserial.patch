+	{
+		int any_pointer = 0;
+		struct weston_seat *s;
+		wl_list_for_each(s, &compositor->seat_list, link) {
+			if (weston_seat_get_pointer(s)) {
+				any_pointer = 1;
+				break;
+			}
+		}
+		if (!any_pointer) {
+			output = weston_shell_utils_get_output_user_override(compositor);
+			if (output)
