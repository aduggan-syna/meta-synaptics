#!/bin/sh

# Android gadget cleanup - called on service stop

COMMON_SCRIPT=/usr/bin/android-gadget-common.sh

if [ ! -r "$COMMON_SCRIPT" ]; then
  echo "Error: missing helper script $COMMON_SCRIPT" >&2
  exit 1
fi

. "$COMMON_SCRIPT"

# Unmount FunctionFS before removing ADB function links
if mountpoint -q /dev/usb-ffs/adb; then
  umount /dev/usb-ffs/adb 2>/dev/null || true
fi

cleanup_gadget_function ffs.usb0

exit 0
