From 505cc7913448a2da7e0a5a4b5ce0441bda6c99b4 Mon Sep 17 00:00:00 2001
From: Rohit Tayal <Rohit.Tayal@synaptics.com>
Date: Tue, 16 Sep 2025 05:12:36 -0700
Subject: [PATCH] patch

---
 brcm_bt_start.service | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/brcm_bt_start.service b/brcm_bt_start.service
index 1379338..b3e3465 100644
--- a/brcm_bt_start.service
+++ b/brcm_bt_start.service
@@ -1,11 +1,13 @@
 [Unit]
 Description=brcm bt start
 Before=bluetooth.service
+After=systemd-rfkill.service
+Requires=systemd-rfkill.service

 [Service]
 Type=oneshot
 ExecStartPre=/bin/sh -c 'rfkill unblock bluetooth'
-ExecStart=/bin/sh -c '/usr/bin/brcm_patchram_plus -d --tosleep=300000 --baudrate 3000000 --use_baudrate_for_download --no2bytes --enable_hci --patchram /lib/firmware/bcm /dev/ttyS2 &'
+ExecStart=/bin/sh -c '/usr/bin/brcm_patchram_plus -d --tosleep=300000 --baudrate 3000000 --use_baudrate_for_download --no2bytes --enable_hci --patchram /lib/firmware/bcm /dev/ttyS1 &'
 Restart=no
 RemainAfterExit=yes
