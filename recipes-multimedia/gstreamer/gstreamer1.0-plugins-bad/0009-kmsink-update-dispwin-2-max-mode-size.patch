+static void
+find_max_mode_for_connector (drmModeConnector * conn, int * max_mode_width, int * max_mode_height)
+{
+  int i;
+  int max_wid, max_hgt, wid, hgt;
+
+  max_wid = 0;
+  max_hgt = 0;
+
+  for (i = 0; i < conn->count_modes; i++) {
+    wid = conn->modes[i].hdisplay;
+    hgt = conn->modes[i].vdisplay;
+    if (wid > max_wid)
+        max_wid = wid;
+    if (hgt > max_hgt)
+        max_hgt = hgt;
+  }
+
+  *max_mode_width = max_wid;
+  *max_mode_height = max_hgt;
+}
